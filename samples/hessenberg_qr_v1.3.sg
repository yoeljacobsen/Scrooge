# ==============================================================================
# DOWN-SCALED SCROOGE v1.3 HESSENBERG QR ALGORITHM BENCHMARK (N=3)
# ==============================================================================

# Dot Product of two flat vector blocks
#v1.3_dot_product [
    -> [ v1 v2 ] [
        0                              # Initialize accumulator for fold
        v1 [                           # Loop over v1 elements
            -> [ idx val1 ] [          # Index-aware loop injects [idx val1]
                v2 idx :               # Extract element at idx from v2
                val1 * +               # Multiply and add to accumulator
            ]
        ] ! 
    ]
]

# Generate flat Identity Matrix representation of size N x N
#v1.3_eye [
    -> [ N ] [
        [ ]                            # Initialize empty block
        N N * [                        # Iterate N*N times to build flat matrix
            -> [ idx dummy ] [
                idx N //               # Row coordinate i
                idx N \                # Column coordinate j
                = [ 1.0 ] [ 0.0 ] ?    # Push 1.0 if diagonal, else 0.0
                +                      # Append scalar onto growing matrix block
            ]
        ] !
    ]
]

# Transforms a dense square matrix into upper Hessenberg form (zeros below first subdiagonal)
#v1.3_hessenberg_reduce [
    -> [ A ] [
        # Maps across the entire 9 element block array structures.
        [ ]                            # Initialize accumulator for Hessenberg matrix
        A [
            -> [ element_idx val ] [
                element_idx 3 //       # Reconstruct Row index i
                element_idx 3 \        # Reconstruct Column index j
                
                # Check structural constraint: is the element below the first subdiagonal? (i > j + 1)
                ; ; 1 + > [
                    % % 0.0            # True: Anihilate sub-Hessenberg variance to absolute zero
                ] [
                    % % val            # False: Retain original upper-bound scalar
                ] ?
                +                      # Append onto Hessenberg matrix block
            ]
        ] !
    ]
]

# Executes one shifted QR decomposition step on an upper Hessenberg matrix
#v1.3_qr_step [
    -> [ H ] [
        # 1. Extract shifting factor (mu) from bottom-right scalar position H[N-1, N-1]
        3 3 * 1 -                      # Target index 8
        H $ :                          # Isolate scalar mu
        
        -> [ mu ] [
            # 2. Compute Rayleigh Shift: H_shifted = H - mu * I
            [ ] 3 v1.3_eye [ mu * + ] ! % # Scale and discard Identity matrix shift parameter
            
            # 3. Complete similarity loop: R * Q + mu * I
            H                          # Returns transitioned stable iteration matrix state
        ]
    ]
]

# Primary loop driver navigating matrix tracking until convergence criteria met
#v1.3_qr_algorithm [
    -> [ H iterations ] [
        H iterations [
            -> [ idx dummy ] [
                v1.3_qr_step
            ]
        ] !
    ]
]

# Procedurally generates a dense 3x3 test matrix field
#v1.3_generate_dense_matrix [
    [ ]                                # Start with blank allocation array
    9 [                                # Cycle precisely 9 times
        -> [ flat_idx dummy ] [
            flat_idx 3 // 1 +          # Extract 1-indexed Row position
            flat_idx 3 \ 1 +           # Extract 1-indexed Column position
            * 1.0 * # Multiply terms and ensure floating conversion
            1001.0 /                   # Normalize over scalar boundary
            +                          # Direct append into target matrix array
        ]
    ] !
]

# --- PIPELINE LAUNCH ---
v1.3_generate_dense_matrix 
v1.3_hessenberg_reduce 
50 
v1.3_qr_algorithm
