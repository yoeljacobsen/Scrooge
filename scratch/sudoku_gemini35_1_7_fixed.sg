[ [| idx val | val 0 == [ idx ] else [ 99 ] ? *] [| acc v | v acc < [ v ] else [ acc ] ? \ 99 ] ] -> [ find_empty ]

[ -> [ g i v ]
  i 9 / -> [ r ]
  i 9 % -> [ c ]
  r 3 / -> [ br ]
  c 3 / -> [ bc ]
  g [| idx curr_v |
      curr_v ^v == [
          idx ^i == [ 0 ] else [
              idx 9 / ^r ==
              idx 9 % ^c == +
              idx 9 / 3 / ^br == idx 9 % 3 / ^bc == * +
              0 > [ 1 ] else [ 0 ] ?
          ] ?
      ] else [ 0 ] ?
  *]
  [| sum item | sum item + \ 0 ] 0 ==
] -> [ check_valid ]

[ -> [ g i v ]
  g [| idx val | idx ^i == [ ^v ] else [ val ] ? *]
] -> [ update_grid ]

[
    -> [ grid steps ]
    grid find_empty -> [ empty_idx ]
    empty_idx 99 == [
        grid steps 1
    ] else [
        [ 1 2 3 4 5 6 7 8 9 ]
        [| acc v |
            acc 0 : -> [ flag ]
            acc 1 : -> [ s ]
            acc 2 : -> [ g ]
            flag [
                acc
            ] else [
                s 1 + -> [ s_next ]
                g ^empty_idx v ^check_valid [
                    g ^empty_idx v ^update_grid s_next ^solve -> [ r_g r_s r_f ]
                    r_f r_s r_g [ ] cons cons cons
                ] else [
                    0 s_next g [ ] cons cons cons
                ] ?
            ] ?
        \ 0 ^steps ^grid [ ] cons cons cons ]
        -> [ final_acc ]
        final_acc 2 : final_acc 1 : final_acc 0 :
    ] ?
] -> [ solve ]

[ 0 solve | grid:Block[81] steps:Int flag:Int : | ]
