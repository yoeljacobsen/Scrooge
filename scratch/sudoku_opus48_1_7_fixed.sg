[ -> [ g ]
  [ g [| k c | c 0 == [ k ] else [ -1 ] ? *]
      [| a e | a -1 == e -1 != & [ e ] else [ a ] ? \ -1 ] ]
] -> [ find_empty ]
[
  [ -> [ g idx v ]
    [ g [| k c | k ^idx == [ ^v ] else [ c ] ? *] ]
  ] -> [ place ]
  [
    [ -> [ g idx v ]
      [ g idx v valid ]
    ]
  ] -> [ ok ]
    [
      [ -> [ g steps ]
        [ g ^find_empty -> [ pos ]
          [ pos -1 ==
            [ 1 g steps ]
            else
            [ [ 1 2 3 4 5 6 7 8 9 ]
              [| f v |
                [ f 0 : ] 1 ==
                [ f ]
                else
                [ [ f 2 : ] 1 + -> [ st ]
                  [ ^g ^pos v ^ok
                    [ ^g ^pos v ^place st ^solve -> [ rf rg rs ] [
                      rf 1 ==
                      [ 1 rg rs [ ] cons cons cons ]
                      else
                      [ 0 ^g rs [ ] cons cons cons ] ? ] ]
                    else
                    [ 0 ^g st [ ] cons cons cons ] ? ] ]
                ?
              \ 0 g steps [ ] cons cons cons ]
              -> [ res ]
              [ res 0 : res 1 : res 2 : ]
            ] ? ]
        ]
      -> [ solve ]
      [
        [ 5 3 0 0 7 0 0 0 0
          6 0 0 1 9 5 0 0 0
          0 9 8 0 0 0 0 6 0
          8 0 0 0 6 0 0 0 3
          4 0 0 8 0 3 0 0 1
          7 0 0 0 2 0 0 0 6
          0 6 0 0 0 0 2 8 0
          0 0 0 4 1 9 0 0 5
          0 0 0 0 8 0 0 7 9 ]
        0 ^solve -> [ f grid steps ]
        [ grid steps
          | grid:Int[81] : solved:Int[81] | ]
      ]
    ]
  ]
]
