{ ---- Scrooge Core Standard Library MCP Discovery Manifest ---- }

tool "array" name "arr_size" sig "( shape_block -- total_cells )" desc "..."
tool "array" name "arr_make" sig "( shape_block -- ptr )" desc "..."
tool "array" name "arr_offset" sig "( ptr coords_block -- flat_offset )" desc "..."
tool "array" name "arr_get" sig "( ptr coords_block -- val )" desc "..."
tool "array" name "arr_set" sig "( val ptr coords_block -- )" desc "..."
tool "list" name "lst_make" sig "( initial_capacity -- ptr )" desc "..."
tool "list" name "lst_get" sig "( ptr idx -- val )" desc "..."
tool "list" name "lst_set" sig "( val ptr idx -- )" desc "..."
tool "list" name "lst_push" sig "( val ptr -- )" desc "..."
tool "map" name "map_make" sig "( buckets_size -- ptr )" desc "..."
tool "map" name "map_get" sig "( ptr key -- val )" desc "..."
tool "map" name "map_set" sig "( val ptr key -- )" desc "..."
tool "record" name "rec_make" sig "( size -- ptr )" desc "..."
tool "record" name "rec_get" sig "( ptr field_offset -- val )" desc "..."
tool "record" name "rec_set" sig "( val ptr field_offset -- )" desc "..."
tool "memory" name "hclear" sig "( ptr start size -- )" desc "..."
tool "memory" name "hloop_fill" sig "( ptr start stop val -- )" desc "..."
tool "memory" name "hloop_add" sig "( ptr start stop val -- )" desc "..."
