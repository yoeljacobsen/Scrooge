#row ( i:Scalar -- r:Scalar ) 9 / end
#col ( i:Scalar -- c:Scalar ) 9 \ end
#box ( i:Scalar -- b:Scalar ) -> [ i ] [ i 9 / 3 / 3 * i 9 \ 3 / + ] end
#peer ( i:Scalar j:Scalar -- f:Scalar ) -> [ i j ] [ i row j row = i col j col = or i box j box = or ] end

#valid ( g:Block p:Scalar n:Scalar -- ok:Scalar )
  nil cons cons swap
  [fold| idx acc val ctx |
    idx ctx 0 at peer  idx ctx 0 at !=  and  val ctx 1 at =  and  acc or
  from 0 ] not
end

#fe ( g:Block -- p:Scalar )
  [fold| idx acc val _ | acc idx 81 val 0 = select min from 81 ]
  -1 swap dup 81 = select
end

#put ( g:Block p:Scalar n:Scalar -- g2:Block )
  nil cons cons swap
  [map| idx val ctx | ctx 1 at val idx ctx 0 at = select ]
end

#solve ( g:Block s:Scalar -- g:Block s:Scalar ok:Scalar )
  -> [ g s ] [ g fe dup -1 = ]
  cond [ drop g s 1 ] else [ g swap s 1 try ] ?
end

#try ( g:Block p:Scalar s:Scalar c:Scalar -- g:Block s:Scalar ok:Scalar )
  -> [ g p s c ] [ c 9 > ]
  cond [ g s 0 ] else [ g p s 1 + c att ] ?
end

#att ( g:Block p:Scalar s:Scalar c:Scalar -- g:Block s:Scalar ok:Scalar )
  -> [ g p s c ] [ g p c valid ]
  cond [ g p c put s solve g p c res ] else [ g p s c 1 + try ] ?
end

#res ( g2:Block s2:Scalar ok:Scalar g:Block p:Scalar c:Scalar -- g:Block s:Scalar ok:Scalar )
  -> [ g2 s2 ok g p c ] [ ok ]
  cond [ g2 s2 1 ] else [ g p s2 c 1 + try ] ?
end
