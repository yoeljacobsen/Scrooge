#hclear_step ( ptr idx stop_idx -- ptr idx2 stop_idx )
  -> [ p idx stop_idx ] [ 0 p idx hwrite p idx 1 + stop_idx ]
end
#hclear_loop ( ptr idx stop_idx -- )
  -> [ p idx stop_idx ] [ idx stop_idx < ]
  cond [ p idx stop_idx hclear_step hclear_loop ] else [ ] ?
end
#hclear ( ptr start size -- )
  -> [ p start size ] [ p start start size + hclear_loop ]
end
#hfill_step ( val ptr idx stop_idx -- val ptr idx2 stop_idx )
  -> [ val p idx stop_idx ] [ val p idx hwrite val p idx 1 + stop_idx ]
end
#hfill_loop ( val ptr idx stop_idx -- )
  -> [ val p idx stop_idx ] [ idx stop_idx < ]
  cond [ val p idx stop_idx hfill_step hfill_loop ] else [ ] ?
end
#hloop_fill ( ptr start stop val -- )
  -> [ p start stop val ] [ val p start stop hfill_loop ]
end
#hadd_step ( val ptr idx stop_idx -- val ptr idx2 stop_idx )
  -> [ val p idx stop_idx ] [ p idx hread val + p idx hwrite val p idx 1 + stop_idx ]
end
#hadd_loop ( val ptr idx stop_idx -- )
  -> [ val p idx stop_idx ] [ idx stop_idx < ]
  cond [ val p idx stop_idx hadd_step hadd_loop ] else [ ] ?
end
#hloop_add ( ptr start stop val -- )
  -> [ p start stop val ] [ val p start stop hadd_loop ]
end
