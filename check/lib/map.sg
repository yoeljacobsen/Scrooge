#map_make ( buckets_size -- ptr )
  -> [ buckets_size ] [ buckets_size 2 * hnew ]
end
#map_hash ( key buckets_size -- bucket_idx )
  \ 2 *
end
#map_get ( ptr key -- val )
  -> [ ptr key ] [
    key ptr len 2 / map_hash
    -> [ bucket_idx ] [ ptr bucket_idx hread key = ]
    cond [ ptr bucket_idx 1 + hread ] else [ -1 ] ?
  ]
end
#map_set ( val ptr key -- )
  -> [ val ptr key ] [
    key ptr len 2 / map_hash
    -> [ bucket_idx ] [
      key ptr bucket_idx hwrite
      val ptr bucket_idx 1 + hwrite
    ]
  ]
end
