{ ---- numeric: kernels over ranges of heap cells.                    ---- }
{ ---- A vector is a Ptr, the cell where it starts and a length, so one    ---- }
{ ---- allocation can hold a whole matrix (row r of a matrix with c        ---- }
{ ---- columns starts at r c *). Each word is one counted loop that calls  ---- }
{ ---- no other word, so its heap accesses compile to a bounds check each. ---- }
{ ---- Integers and floats mix as in + and *; start from floats (0.0) when ---- }
{ ---- the result must be a float.                                         ---- }

{ ---- a[ao..ao+n) . b[bo..bo+n) ---- }
#vec_dot ( left:Ptr loff:Int right:Ptr roff:Int count:Int -- sum:Float )
  0.0 count [times| i | left loff i + hread right roff i + hread * + ]
end

{ ---- y[yo+i] += g * x[xo+i] for i < n ---- }
#vec_axpy ( dst:Ptr doff:Int src:Ptr soff:Int count:Int scale:Scalar -- )
  scale to_float -> [ gf ]
  count [times| i | dst doff i + dst doff i + hread gf src soff i + hread * + hwrite ]
end

{ ---- y[yo+i] += x[xo+i] for i < n ---- }
#vec_add ( src:Ptr soff:Int dst:Ptr doff:Int count:Int -- )
  count [times| i | dst doff i + dst doff i + hread src soff i + hread + hwrite ]
end

{ ---- p[off+i] *= g for i < n ---- }
#vec_scale ( ptr:Ptr start:Int count:Int scale:Scalar -- )
  count [times| i | ptr start i + ptr start i + hread scale * hwrite ]
end

{ ---- the sum of p[off..off+n) (0 when n is 0) ---- }
#vec_sum ( ptr:Ptr start:Int count:Int -- sum:Unknown )
  0 count [times| i | ptr start i + hread + ]
end

{ ---- the index (0..n-1) of the first largest of p[off..off+n); n must be at least 1 ---- }
#vec_argmax ( ptr:Ptr start:Int count:Int -- index:Int )
  count 1 < cond [ "vec_argmax: empty range" abort ] else [ ] ?
  0 ptr start hread 1 count [for| index |
    -> [ bi bv ] ptr start index + hread -> [ v ] v bv > cond [ index v ] else [ bi bv ] ?
  ] drop
end

{ ---- the largest of p[off..off+n); n must be at least 1 ---- }
#vec_max ( ptr:Ptr start:Int count:Int -- largest:Int )
  ptr start ptr start count vec_argmax + hread
end

{ ---- the 32-bit big-endian signed integer in the four byte cells p[off..off+4) ---- }
{ ---- (as fread_into leaves a file's bytes: IDX, PNG, network formats)        ---- }
#vec_be32 ( ptr:Ptr index:Int -- value:Int )
  ptr index hread 24 bitshl ptr index 1 + hread 16 bitshl bitor
  ptr index 2 + hread 8 bitshl bitor ptr index 3 + hread bitor
  -> [ u ] u 2147483647 > cond [ u 4294967296 - ] else [ u ] ?
end

{ ---- the 32-bit little-endian signed integer in p[off..off+4) ---- }
#vec_le32 ( ptr:Ptr index:Int -- value:Int )
  ptr index 3 + hread 24 bitshl ptr index 2 + hread 16 bitshl bitor
  ptr index 1 + hread 8 bitshl bitor ptr index hread bitor
  -> [ u ] u 2147483647 > cond [ u 4294967296 - ] else [ u ] ?
end
