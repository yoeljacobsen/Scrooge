{ ---- Scrooge Core Standard Library MCP Discovery Manifest ---- }

tool "array" name "arr_size" sig "( shape_block -- total_cells )" desc "Computes the total flat heap cell capacity required to hold a multidimensional array matching the shape configuration block."
tool "array" name "arr_make" sig "( shape_block -- ptr )" desc "Allocates an N-dimensional array structure on the heap with nested dimension trackers. Returns an opaque pointer token."
tool "array" name "arr_offset" sig "( ptr coords_block -- flat_offset )" desc "Maps a multi-dimensional coordinates index block into a strict linear integer offset relative to the base heap address."
tool "array" name "arr_get" sig "( ptr coords_block -- val )" desc "Reads and returns a scalar value or object reference from an N-dimensional array at the position targeted by a coordinates block."
tool "array" name "arr_set" sig "( val ptr coords_block -- )" desc "Writes a scalar value or object reference into an N-dimensional array at the location specified by a coordinates block."

tool "list" name "lst_make" sig "( initial_capacity -- ptr )" desc "Allocates a growable list structure tracking allocation capacity, current length, and a sub-allocated data pointer segment."
tool "list" name "lst_get" sig "( ptr idx -- val )" desc "Performs a fast 0-indexed memory lookup within an encapsulated growable list pointer structure."
tool "list" name "lst_set" sig "( val ptr idx -- )" desc "Overwrites an entry inside an encapsulated growable list pointer structure at a specified 0-indexed integer offset."
tool "list" name "lst_push" sig "( val ptr -- )" desc "Appends an entry to the end of a growable list structure, automatically triggering memory doubling if current length tracking bounds overflow capacity."

tool "map" name "map_make" sig "( buckets_size -- ptr )" desc "Allocates a flat key-value hash map array backed by a dedicated, interlaced bucket allocation configuration layout."
tool "map" name "map_get" sig "( ptr key -- val )" desc "Queries a hash map structure via integer offset hashes for an explicit key match. Returns the associated payload value, or -1 on miss."
tool "map" name "map_set" sig "( val ptr key -- )" desc "Inserts or updates a key-value relationship pair inside a hash map structure using safe integer offsets relative to the base heap pointer."

tool "record" name "rec_make" sig "( size -- ptr )" desc "Allocates a fixed-capacity record memory segment on the heap containing a specific number of consecutive data fields."
tool "record" name "rec_get" sig "( ptr field_offset -- val )" desc "Reads an encapsulated record field entry from a constant integer offset cell location."
tool "record" name "rec_set" sig "( val ptr field_offset -- )" desc "Writes an encapsulated record field entry into a constant integer offset cell location."

tool "memory" name "hclear" sig "( ptr start size -- )" desc "Zeroes a range."
tool "memory" name "hloop_fill" sig "( ptr start stop val -- )" desc "Fills a range."
tool "memory" name "hloop_add" sig "( ptr start stop val -- )" desc "Adds to a range."
