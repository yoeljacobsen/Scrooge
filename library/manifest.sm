{ ---- Scrooge Core Standard Library MCP Discovery Manifest ---- }

tool "array" name "arr_size" sig "( shape_block -- total_cells )" desc "..."
tool "array" name "arr_make" sig "( shape_block -- ptr )" desc "..."
tool "array" name "arr_offset" sig "( ptr coords_block -- flat_offset )" desc "..."
tool "array" name "arr_get" sig "( ptr coords_block -- val )" desc "..."
tool "array" name "arr_set" sig "( val ptr coords_block -- )" desc "..."
tool "array" name "nth_or_default" sig "( arr idx default -- val )" desc "Safely indexes array with default fallback."

tool "bitset" name "bs_add" sig "( set i -- set2 )" desc "Sets bit i."
tool "bitset" name "bs_test" sig "( set i -- present )" desc "1 if bit i is set, else 0."
tool "bitset" name "bs_union" sig "( a b -- c )" desc "Bitwise OR."
tool "bitset" name "bs_inter" sig "( a b -- c )" desc "Bitwise AND."
tool "bitset" name "bs_minus" sig "( a b -- c )" desc "a with b's bits cleared."
tool "bitset" name "bs_count" sig "( set -- n )" desc "Population count (number of set bits)."
tool "bitset" name "bs_first" sig "( set -- i found )" desc "Lowest set bit; found=0 if set is empty."

tool "file" name "f_read" sig "( -- mode )" desc "Open mode for reading (fopen's mode argument)."
tool "file" name "f_write" sig "( -- mode )" desc "Open mode for writing, truncating any existing contents."
tool "file" name "f_append" sig "( -- mode )" desc "Open mode for writing at the end of an existing file."
tool "file" name "f_stdin" sig "( -- fh )" desc "The pre-opened standard input handle."
tool "file" name "f_stdout" sig "( -- fh )" desc "The pre-opened standard output handle."
tool "file" name "f_stderr" sig "( -- fh )" desc "The pre-opened standard error handle."
tool "file" name "f_open_read" sig "( path -- fh ok )" desc "Opens a path for reading; ok=0 if it could not be opened."
tool "file" name "f_open_write" sig "( path -- fh ok )" desc "Opens a path for writing, truncating it; ok=0 if it could not be opened."
tool "file" name "f_open_append" sig "( path -- fh ok )" desc "Opens a path for appending; ok=0 if it could not be opened."
tool "file" name "f_write_str" sig "( str fh -- ok )" desc "Writes a whole string in one pass; ok=0 if fewer characters were written than it holds."
tool "file" name "f_write_line" sig "( str fh -- ok )" desc "Writes a whole string followed by a newline; ok=0 if either write fell short."
tool "file" name "f_chunk" sig "( -- n )" desc "Default read chunk size in characters, for a caller driving its own fread loop."
tool "file" name "f_next_chunk" sig "( n -- n2 )" desc "Chunk growth policy: doubles, capped, so a whole-file read stays linear."
tool "file" name "f_read_all" sig "( fh -- str )" desc "Reads to end of input in geometrically growing chunks; one Block slot per character."
tool "file" name "f_read_line" sig "( fh -- line got )" desc "Reads up to and consuming the next newline, which is not returned; got=0 at end of input."
tool "file" name "f_read_file" sig "( path -- str ok )" desc "Opens, reads to end, closes; ok=0 (with an empty result) if the open or close failed."
tool "file" name "f_write_file" sig "( str path -- ok )" desc "Opens truncating, writes, closes; ok=0 if any step failed."
tool "file" name "f_append_file" sig "( str path -- ok )" desc "Opens for append, writes, closes; ok=0 if any step failed."

tool "list" name "lst_make" sig "( initial_capacity -- ptr )" desc "..."
tool "list" name "lst_get" sig "( ptr idx -- val )" desc "..."
tool "list" name "lst_set" sig "( val ptr idx -- )" desc "..."
tool "list" name "lst_new_cap" sig "( old_cap -- new_cap )" desc "Doubles a capacity (or 1 if 0)."
tool "list" name "lst_grow" sig "( ptr -- )" desc "Reallocates the list's backing storage at double capacity, copying existing elements."
tool "list" name "lst_push" sig "( val ptr -- )" desc "Grows the list (doubling capacity) when full; never silently drops."
tool "list" name "lst_try_push" sig "( val ptr -- ok )" desc "Does not grow; returns 0 when full instead of pushing."

tool "map" name "map_make" sig "( buckets_size -- ptr )" desc "..."
tool "map" name "map_hash" sig "( key buckets_size -- bucket_idx )" desc "Computes the bucket index for a key."
tool "map" name "map_find" sig "( ptr key -- val found )" desc "Looks up a key; found=0 (val=0) rather than a sentinel when absent."
tool "map" name "map_get" sig "( ptr key -- val )" desc "Aborts when the key is absent; use map_find if absence is expected."
tool "map" name "map_set" sig "( val ptr key -- ok )" desc "ok=0 if the write would clobber a different existing key at that bucket."

tool "memory" name "hclear" sig "( p start size -- )" desc "..."
tool "memory" name "hloop_fill" sig "( p start stop val -- )" desc "..."
tool "memory" name "hloop_add" sig "( p start stop val -- )" desc "..."
tool "memory" name "h_find_val" sig "( ptr size val -- index )" desc "Scans sequential heap cells for a target value; returns 0-indexed offset or -1."

tool "record" name "rec_make" sig "( size -- ptr )" desc "..."
tool "record" name "rec_get" sig "( ptr field_offset -- val )" desc "..."
tool "record" name "rec_set" sig "( val ptr field_offset -- )" desc "..."

tool "strings" name "str_print" sig "( str -- )" desc "Prints a string (block of ASCII codes) to stdout."
tool "strings" name "is_digit" sig "( ch -- flag )" desc "1 if char code is 0-9, else 0."
tool "strings" name "is_space" sig "( ch -- flag )" desc "1 if char code is space/tab/newline/CR, else 0."
tool "strings" name "is_upper" sig "( ch -- flag )" desc "1 if char code is A-Z, else 0."
tool "strings" name "is_lower" sig "( ch -- flag )" desc "1 if char code is a-z, else 0."
tool "strings" name "int_to_str" sig "( n -- str )" desc "Converts a signed integer to its digit-character block."
tool "strings" name "print_line" sig "( n -- )" desc "Prints an integer followed by a newline."
tool "strings" name "str_to_int" sig "( chars start end -- n ok )" desc "Multi-digit signed parse of [start,end); ok=0 if not entirely digits (plus an optional leading '-')."
tool "strings" name "fs_matches_at" sig "( hay needle i nlen -- match )" desc "1 if needle occurs in hay starting exactly at i."
tool "strings" name "find_sub" sig "( hay needle from -- pos found )" desc "First index >= from where needle occurs in hay; found=0 if absent."

tool "util" name "reverse" sig "( block -- reversed )" desc "Reverses an immutable block."
tool "util" name "length" sig "( block -- n )" desc "Counts elements in a block."
tool "util" name "nth" sig "( block idx -- val )" desc "Element at a 0-indexed position."
tool "util" name "sum" sig "( block -- total )" desc "Sums scalar elements."
tool "util" name "contains" sig "( block target -- flag )" desc "1 if target present, else 0."
tool "util" name "filter_eq" sig "( block target -- filtered )" desc "Keeps elements equal to target (order preserved)."
tool "util" name "index_of" sig "( block target -- idx )" desc "First index equal to target, or -1."
tool "util" name "concat" sig "( b1 b2 -- joined )" desc "Concatenates two blocks; empty-safe."
tool "util" name ">=" sig "( a b -- bool )" desc "1 if a >= b, else 0."
tool "util" name "<=" sig "( a b -- bool )" desc "1 if a <= b, else 0."
tool "util" name "block_eq" sig "( b1 b2 -- equal )" desc "Checks element-by-element equality of two blocks."
tool "util" name "insert_sorted" sig "( val blk -- result )" desc "Inserts a value into an already-sorted block, preserving order."
tool "util" name "block_sort" sig "( blk -- sorted )" desc "Performs stable sorting on a block."
