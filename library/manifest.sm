{ ---- Scrooge Core Standard Library MCP Discovery Manifest ---- }

tool "args" name "arg_prog" sig "( -- name:Block )" desc "The program as invoked, i.e. `0 argv`."
tool "args" name "arg_or" sig "( i:Scalar default:Block -- arg:Block )" desc "The argument at a C index, or default when there is none; removes the ok flag from the call site."
tool "args" name "arg_tail" sig "( -- args:Block )" desc "Every argument except the program name, in order, as a Block of Blocks."
tool "args" name "arg_find" sig "( name:Block -- i:Scalar found:Scalar )" desc "C index of the first argument equal to name, searching from 1; found=0 when absent."

tool "array" name "arr_size" sig "( shape_block:Block -- total_cells:Scalar )" desc "..."
tool "array" name "arr_make" sig "( shape_block:Block -- ptr:Ptr )" desc "..."
tool "array" name "arr_offset" sig "( ptr:Ptr coords_block:Block -- flat_offset:Scalar )" desc "..."
tool "array" name "arr_get" sig "( ptr:Ptr coords_block:Block -- val:Unknown )" desc "..."
tool "array" name "arr_set" sig "( val:Unknown ptr:Ptr coords_block:Block -- )" desc "..."
tool "array" name "nth_or_default" sig "( arr:Block idx:Scalar default:Unknown -- val:Unknown )" desc "Safely indexes array with default fallback."

tool "bitset" name "bs_add" sig "( set:Scalar i:Scalar -- set2:Scalar )" desc "Sets bit i."
tool "bitset" name "bs_test" sig "( set:Scalar i:Scalar -- present:Scalar )" desc "1 if bit i is set, else 0."
tool "bitset" name "bs_union" sig "( a:Scalar b:Scalar -- c:Scalar )" desc "Bitwise OR."
tool "bitset" name "bs_inter" sig "( a:Scalar b:Scalar -- c:Scalar )" desc "Bitwise AND."
tool "bitset" name "bs_minus" sig "( a:Scalar b:Scalar -- c:Scalar )" desc "a with b's bits cleared."
tool "bitset" name "bs_count" sig "( set:Scalar -- n:Scalar )" desc "..."
tool "bitset" name "bs_first" sig "( set:Scalar -- i:Scalar found:Scalar )" desc "Lowest set bit; found=0 if set is empty."

tool "file" name "f_read" sig "( -- mode:Scalar )" desc "Open mode for reading (fopen's mode argument)."
tool "file" name "f_write" sig "( -- mode:Scalar )" desc "Open mode for writing, truncating any existing contents."
tool "file" name "f_append" sig "( -- mode:Scalar )" desc "Open mode for writing at the end of an existing file."
tool "file" name "f_stdin" sig "( -- fh:File )" desc "The pre-opened standard input handle."
tool "file" name "f_stdout" sig "( -- fh:File )" desc "The pre-opened standard output handle."
tool "file" name "f_stderr" sig "( -- fh:File )" desc "The pre-opened standard error handle."
tool "file" name "f_open_read" sig "( path:Block -- fh:File ok:Scalar )" desc "Opens a path for reading; ok=0 if it could not be opened."
tool "file" name "f_open_write" sig "( path:Block -- fh:File ok:Scalar )" desc "Opens a path for writing, truncating it; ok=0 if it could not be opened."
tool "file" name "f_open_append" sig "( path:Block -- fh:File ok:Scalar )" desc "Opens a path for appending; ok=0 if it could not be opened."
tool "file" name "f_write_str" sig "( str:Block fh:File -- ok:Scalar )" desc "Writes a whole string in one pass; ok=0 if fewer characters were written than it holds."
tool "file" name "f_write_line" sig "( str:Block fh:File -- ok:Scalar )" desc "Writes a whole string followed by a newline; ok=0 if either write fell short."
tool "file" name "f_chunk" sig "( -- n:Scalar )" desc "Default read chunk size in characters, for a caller driving its own fread loop."
tool "file" name "f_next_chunk" sig "( n:Scalar -- n2:Scalar )" desc "Chunk growth policy: doubles, capped, so a whole-file read stays linear."
tool "file" name "f_read_all" sig "( fh:File -- str:Block )" desc "Reads to end of input in geometrically growing chunks; one Block slot per character."
tool "file" name "f_read_line" sig "( fh:File -- line:Block got:Scalar )" desc "Reads up to and consuming the next newline, which is not returned; got=0 at end of input."
tool "file" name "f_read_file" sig "( path:Block -- str:Block ok:Scalar )" desc "Opens, reads to end, closes; ok=0 (with an empty result) if the open or close failed."
tool "file" name "f_write_file" sig "( str:Block path:Block -- ok:Scalar )" desc "Opens truncating, writes, closes; ok=0 if any step failed."
tool "file" name "f_append_file" sig "( str:Block path:Block -- ok:Scalar )" desc "Opens for append, writes, closes; ok=0 if any step failed."

tool "list" name "lst_make" sig "( initial_capacity:Scalar -- ptr:Ptr )" desc "..."
tool "list" name "lst_get" sig "( ptr:Ptr idx:Scalar -- val:Unknown )" desc "..."
tool "list" name "lst_set" sig "( val:Unknown ptr:Ptr idx:Scalar -- )" desc "..."
tool "list" name "lst_new_cap" sig "( old_cap:Scalar -- new_cap:Scalar )" desc "Doubles a capacity (or 1 if 0)."
tool "list" name "lst_grow" sig "( ptr:Ptr -- )" desc "Reallocates the list's backing storage at double capacity, copying existing elements."
tool "list" name "lst_push" sig "( val:Unknown ptr:Ptr -- )" desc "Grows the list (doubling capacity) when full; never silently drops."
tool "list" name "lst_try_push" sig "( val:Unknown ptr:Ptr -- ok:Scalar )" desc "Does not grow; returns 0 when full instead of pushing."

tool "map" name "map_make" sig "( buckets_size:Scalar -- ptr:Ptr )" desc "..."
tool "map" name "map_hash" sig "( key:Scalar buckets_size:Scalar -- bucket_idx:Scalar )" desc "Computes the bucket index for a key."
tool "map" name "map_find" sig "( ptr:Ptr key:Scalar -- val:Unknown found:Scalar )" desc "Looks up a key; found=0 (val=0) rather than a sentinel when absent."
tool "map" name "map_get" sig "( ptr:Ptr key:Scalar -- val:Unknown )" desc "Aborts when the key is absent; use map_find if absence is expected."
tool "map" name "map_set" sig "( val:Unknown ptr:Ptr key:Scalar -- ok:Scalar )" desc "ok=0 if the write would clobber a different existing key at that bucket."

tool "memory" name "hclear" sig "( p:Ptr start:Scalar size:Scalar -- )" desc "..."
tool "memory" name "hloop_fill" sig "( p:Ptr start:Scalar stop:Scalar val:Scalar -- )" desc "..."
tool "memory" name "hloop_add" sig "( p:Ptr start:Scalar stop:Scalar val:Scalar -- )" desc "..."
tool "memory" name "h_find_val" sig "( ptr:Ptr size:Scalar val:Scalar -- index:Scalar )" desc "Scans sequential heap cells for a target value; returns 0-indexed offset or -1."

tool "record" name "rec_make" sig "( size:Scalar -- ptr:Ptr )" desc "..."
tool "record" name "rec_get" sig "( ptr:Ptr field_offset:Scalar -- val:Unknown )" desc "..."
tool "record" name "rec_set" sig "( val:Unknown ptr:Ptr field_offset:Scalar -- )" desc "..."

tool "strings" name "str_print" sig "( str:Block -- )" desc "Prints a string (block of ASCII codes) to stdout."
tool "strings" name "is_digit" sig "( ch:Scalar -- flag:Scalar )" desc "1 if char code is 0-9, else 0."
tool "strings" name "is_space" sig "( ch:Scalar -- flag:Scalar )" desc "1 if char code is space/tab/newline/CR, else 0."
tool "strings" name "is_upper" sig "( ch:Scalar -- flag:Scalar )" desc "1 if char code is A-Z, else 0."
tool "strings" name "is_lower" sig "( ch:Scalar -- flag:Scalar )" desc "1 if char code is a-z, else 0."
tool "strings" name "int_to_str" sig "( n:Scalar -- str:Block )" desc "Converts a signed integer to its digit-character block."
tool "strings" name "print_line" sig "( n:Scalar -- )" desc "Prints an integer followed by a newline."
tool "strings" name "str_to_int" sig "( chars:Block start:Scalar end:Scalar -- n:Scalar ok:Scalar )" desc "Multi-digit signed parse of [start,end); ok=0 if not entirely digits (plus an optional leading '-')."
tool "strings" name "fs_matches_at" sig "( hay:Block needle:Block i:Scalar nlen:Scalar -- match:Scalar )" desc "1 if needle occurs in hay starting exactly at i."
tool "strings" name "find_sub" sig "( hay:Block needle:Block start:Scalar -- pos:Scalar found:Scalar )" desc "First index >= from where needle occurs in hay; found=0 if absent."

tool "util" name "reverse" sig "( block:Block -- reversed:Block )" desc "Reverses an immutable block."
tool "util" name "length" sig "( block:Block -- n:Scalar )" desc "Counts elements in a block."
tool "util" name "nth" sig "( block:Block idx:Scalar -- val:Unknown )" desc "Element at a 0-indexed position."
tool "util" name "sum" sig "( block:Block -- total:Scalar )" desc "Sums scalar elements."
tool "util" name "contains" sig "( block:Block target:Scalar -- flag:Scalar )" desc "1 if target present, else 0."
tool "util" name "filter_eq" sig "( block:Block target:Scalar -- filtered:Block )" desc "Keeps elements equal to target (order preserved)."
tool "util" name "index_of" sig "( block:Block target:Scalar -- idx:Scalar )" desc "First index equal to target, or -1."
tool "util" name "concat" sig "( b1:Block b2:Block -- joined:Block )" desc "Concatenates two blocks; empty-safe."
tool "util" name ">=" sig "( a:Scalar b:Scalar -- bool:Scalar )" desc "1 if a >= b, else 0."
tool "util" name "<=" sig "( a:Scalar b:Scalar -- bool:Scalar )" desc "1 if a <= b, else 0."
tool "util" name "block_eq" sig "( b1:Block b2:Block -- equal:Scalar )" desc "Checks element-by-element equality of two blocks."
tool "util" name "insert_sorted" sig "( val:Unknown blk:Block -- result:Block )" desc "Inserts a value into an already-sorted block, preserving order."
tool "util" name "block_sort" sig "( blk:Block -- sorted:Block )" desc "Performs stable sorting on a block."

{ ---- Primitives: built into the compiler, no `use` needed. Not loaded by the compiler; checked against it by tools/build_manifest.py ---- }

prim name "dup" sig "( x:Unknown -- x:Unknown x:Unknown )" desc "Copy the top value."
prim name "drop" sig "( x:Unknown -- )" desc "Discard the top value."
prim name "swap" sig "( x:Unknown y:Unknown -- y:Unknown x:Unknown )" desc "Exchange the top two values."
prim name "rot" sig "( x:Unknown y:Unknown z:Unknown -- y:Unknown z:Unknown x:Unknown )" desc "Rotate the third value to the top."
prim name "over" sig "( x:Unknown y:Unknown -- x:Unknown y:Unknown x:Unknown )" desc "Copy the second value to the top."
prim name "cons" sig "( x:Unknown b:Block -- b2:Block )" desc "Prepend x to a Block."
prim name "pair" sig "( a:Unknown b:Unknown -- b2:Block )" desc "The two-slot Block [ a b ]."
prim name "len" sig "( b:Unknown -- n:Scalar )" desc "Slot count of a Block."
prim name "block_slice" sig "( b:Block start:Scalar stop:Scalar -- b2:Block )" desc "Elements start <= i < stop as a new Block; bounds clamp, start >= stop is empty. O(stop - start)."
prim name "at" sig "( b:Block i:Scalar -- v:Unknown )" desc "Integer-indexed read of a homogeneous Block (spec Sec.4 _at)."
prim name "array_at" sig "( b:Block i:Scalar -- v:Unknown )" desc "Spelling of `at` for arrays."
prim name "arr_at" sig "( b:Block i:Scalar -- v:Unknown )" desc "Spelling of `at` for arrays."
prim name "list_at" sig "( b:Block i:Scalar -- v:Unknown )" desc "Spelling of `at` for lists."
prim name "block_at" sig "( b:Block i:Scalar -- v:Unknown )" desc "Spelling of `at` for Blocks."
prim name "block_get" sig "( b:Block k:Scalar -- v:Unknown )" desc "Static-slot read (spec Sec.4 _get)."
prim name "array_get" sig "( b:Block k:Scalar -- v:Unknown )" desc "Spelling of `_get` for arrays."
prim name "list_get" sig "( b:Block k:Scalar -- v:Unknown )" desc "Spelling of `_get` for lists."
prim name "record_get" sig "( r:Block k:Scalar -- v:Unknown )" desc "Spelling of `_get` for records."
prim name "block_set" sig "( b:Block k:Scalar v:Unknown -- b2:Block )" desc "Functional update: a copy with slot k replaced; same type only (spec Sec.4 _set)."
prim name "array_set" sig "( b:Block k:Scalar v:Unknown -- b2:Block )" desc "Spelling of `_set` for arrays."
prim name "list_set" sig "( b:Block k:Scalar v:Unknown -- b2:Block )" desc "Spelling of `_set` for lists."
prim name "record_set" sig "( r:Block k:Scalar v:Unknown -- r2:Block )" desc "Spelling of `_set` for records."
prim name "hnew" sig "( size:Scalar -- p:Ptr )" desc "Allocate size heap cells (spec Sec.5)."
prim name "hread" sig "( p:Ptr i:Scalar -- v:Unknown )" desc "Read heap cell i. Untyped: wrap it in a word whose signature states the real type."
prim name "hwrite" sig "( v:Unknown p:Ptr i:Scalar -- )" desc "Write v into heap cell i. Note the value comes first."
prim name "hmark" sig "( -- mark:Scalar )" desc "Mark the heap arena (spec Sec.5)."
prim name "hrelease" sig "( mark:Scalar -- )" desc "Release every heap cell allocated since mark."
prim name "+" sig "( a:Scalar b:Scalar -- c:Scalar )" desc "Add."
prim name "-" sig "( a:Scalar b:Scalar -- c:Scalar )" desc "Subtract."
prim name "*" sig "( a:Scalar b:Scalar -- c:Scalar )" desc "Multiply."
prim name "/" sig "( a:Scalar b:Scalar -- c:Scalar )" desc "Divide: floor if both are integers, float if either is a float."
prim name "\\" sig "( a:Scalar b:Scalar -- c:Scalar )" desc "Modulo."
prim name "abs" sig "( a:Scalar -- b:Scalar )" desc "Absolute value."
prim name "min" sig "( a:Scalar b:Scalar -- c:Scalar )" desc "Smaller of two."
prim name "max" sig "( a:Scalar b:Scalar -- c:Scalar )" desc "Larger of two."
prim name "to_float" sig "( a:Scalar -- f:Scalar )" desc "Explicit float cast."
prim name "=" sig "( a:Unknown b:Unknown -- f:Scalar )" desc "1 if equal, else 0."
prim name "!=" sig "( a:Unknown b:Unknown -- f:Scalar )" desc "1 if not equal, else 0."
prim name ">" sig "( a:Scalar b:Scalar -- f:Scalar )" desc "1 if a > b, else 0. (>= and <= are in util.)"
prim name "<" sig "( a:Scalar b:Scalar -- f:Scalar )" desc "1 if a < b, else 0."
prim name "and" sig "( a:Scalar b:Scalar -- f:Scalar )" desc "Logical and. Eager: both operands are always evaluated."
prim name "or" sig "( a:Scalar b:Scalar -- f:Scalar )" desc "Logical or. Eager: both operands are always evaluated."
prim name "not" sig "( a:Scalar -- f:Scalar )" desc "LOGICAL not: 1 if a is 0, else 0. For the bitwise complement use bitnot."
prim name "select" sig "( vt:Unknown vf:Unknown flag:Scalar -- v:Unknown )" desc "vt if flag is nonzero, else vf. Both are always evaluated."
prim name "bitand" sig "( a:Scalar b:Scalar -- c:Scalar )" desc "Bitwise and (integers only)."
prim name "bitor" sig "( a:Scalar b:Scalar -- c:Scalar )" desc "Bitwise or (integers only)."
prim name "bitxor" sig "( a:Scalar b:Scalar -- c:Scalar )" desc "Bitwise xor (integers only)."
prim name "bitshl" sig "( a:Scalar n:Scalar -- c:Scalar )" desc "Shift left by n bits."
prim name "bitshr" sig "( a:Scalar n:Scalar -- c:Scalar )" desc "Shift right by n bits."
prim name "bitnot" sig "( a:Scalar -- c:Scalar )" desc "BITWISE complement: 6 bitnot is -7. A 9-bit mask complement is `bitnot 511 bitand`."
prim name "bitcount" sig "( a:Scalar -- n:Scalar )" desc "Number of set bits of the 64-bit pattern (-1 bitcount is 64)."
prim name "bitctz" sig "( a:Scalar -- n:Scalar )" desc "Trailing zero bits: the index of the lowest set bit; 64 for 0."
prim name "bitclz" sig "( a:Scalar -- n:Scalar )" desc "Leading zero bits of the 64-bit pattern; 64 for 0."
prim name "print_char" sig "( ch:Scalar -- )" desc "Write one character code to stdout."
prim name "print_int" sig "( n:Scalar -- )" desc "Write an integer to stdout."
prim name "abort" sig "( msg:Block -- )" desc "Print msg to stderr and exit nonzero. Never returns; an aborting cond branch is exempt from branch matching."
prim name "fopen" sig "( path:Block mode:Scalar -- fh:File ok:Scalar )" desc "Open a file (spec Sec.12)."
prim name "fclose" sig "( fh:File -- ok:Scalar )" desc "Close a file."
prim name "fgetc" sig "( fh:File -- ch:Scalar ok:Scalar )" desc "Read one character; ok=0 at end of file."
prim name "fputc" sig "( ch:Scalar fh:File -- ok:Scalar )" desc "Write one character."
prim name "fread" sig "( fh:File n:Scalar -- str:Block )" desc "Read up to n characters."
prim name "fwrite" sig "( str:Block fh:File -- written:Scalar )" desc "Write a Block of characters; returns the count written."
prim name "argc" sig "( -- n:Scalar )" desc "Command-line argument count, program name included (spec Sec.13)."
prim name "argv" sig "( i:Scalar -- arg:Block ok:Scalar )" desc "Argument i, C indexing (0 is the program); ok=0 when out of range."
prim name "clock_ns" sig "( -- ns:Scalar )" desc "Nanoseconds from a monotonic clock; only differences between readings mean anything."
