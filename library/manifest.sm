{ ---- Scrooge Core Standard Library MCP Discovery Manifest ---- }

tool "args" name "arg_prog" sig "( -- name:Block )" desc "The program as invoked, i.e. `0 argv`."
tool "args" name "arg_or" sig "( i:Scalar default:Block -- arg:Block )" desc "The argument at a C index, or default when there is none; removes the ok flag from the call site."
tool "args" name "arg_tail" sig "( -- args:Block )" desc "Every argument except the program name, in order, as a Block of Blocks."
tool "args" name "arg_find" sig "( name:Block -- i:Scalar found:Scalar )" desc "C index of the first argument equal to name, searching from 1; found=0 when absent."
tool "args" name "arg_flag" sig "( name:Block -- found:Scalar )" desc "1 when the flag appears among the arguments, else 0."
tool "args" name "arg_value_or" sig "( name:Block default:Block -- value:Block )" desc "The argument after the flag; default when the flag is absent or last."
tool "args" name "arg_int_or" sig "( name:Block default:Scalar -- n:Scalar )" desc "The argument after the flag as an integer (optional -, digits only); default when absent or not an integer."
tool "args" name "arg_float_or" sig "( name:Block default:Scalar -- x:Scalar )" desc "The decimal after flag name ([-]digits[.digits], e.g. -l 0.02), or default when the flag is absent or its value is not a plain decimal."

tool "array" name "arr_size" sig "( shape_block:Block -- total_cells:Scalar )" desc "Number of cells an array of the given shape holds (the product of the dimensions)."
tool "array" name "arr_make" sig "( shape_block:Block -- ptr:Ptr )" desc "Allocate a zero-filled multi-dimensional array of the given shape, e.g. [ 9 9 ] arr_make."
tool "array" name "arr_offset" sig "( ptr:Ptr coords_block:Block -- flat_offset:Scalar )" desc "The cell index of the element at the given coordinates (row-major)."
tool "array" name "arr_get" sig "( ptr:Ptr coords_block:Block -- val:Unknown )" desc "Read the element at the given coordinates."
tool "array" name "arr_set" sig "( ptr:Ptr coords_block:Block val:Unknown -- )" desc "Write the element at the given coordinates."
tool "array" name "nth_or_default" sig "( arr:Block idx:Scalar default:Unknown -- val:Unknown )" desc "Safely indexes array with default fallback."

tool "bitset" name "bs_add" sig "( set:Scalar i:Scalar -- set:Scalar )" desc "Sets bit i."
tool "bitset" name "bs_test" sig "( set:Scalar i:Scalar -- present:Scalar )" desc "1 if bit i is set, else 0."
tool "bitset" name "bs_union" sig "( a:Scalar b:Scalar -- c:Scalar )" desc "Bitwise OR."
tool "bitset" name "bs_inter" sig "( a:Scalar b:Scalar -- c:Scalar )" desc "Bitwise AND."
tool "bitset" name "bs_minus" sig "( a:Scalar b:Scalar -- c:Scalar )" desc "a with b's bits cleared."
tool "bitset" name "bs_count" sig "( set:Scalar -- n:Scalar )" desc "Number of members (set bits) of the set."
tool "bitset" name "bs_first" sig "( set:Scalar -- i:Scalar found:Scalar )" desc "Lowest set bit; found=0 if set is empty."

type "dict" name "Dict" base "Ptr"
tool "dict" name "Dict_of" sig "( x:Ptr -- v:Dict )" desc "Generated by `#type Dict`: makes a Dict from its base value."
tool "dict" name "Dict_raw" sig "( v:Dict -- x:Ptr )" desc "Generated by `#type Dict`: the base value of a Dict."
tool "dict" name "dict_new" sig "( n:Scalar -- d:Dict )" desc "A new, empty Dict with room for about n keys before it grows. Keys are integers, strings or other Blocks (a #struct value)."
tool "dict" name "dict_len" sig "( d:Dict -- n:Scalar )" desc "The number of keys."
tool "dict" name "dict_cap" sig "( d:Dict -- n:Scalar )" desc "The number of slots, for visiting them with dict_slot."
tool "dict" name "dict_hash" sig "( k:Unknown -- h:Scalar )" desc "The hash of an integer, string or Block key (a Block's elements are hashed in turn); stops the program for a float or a Ptr key."
tool "dict" name "dict_set" sig "( d:Dict k:Unknown v:Unknown -- )" desc "Stores v at k, replacing any value there."
tool "dict" name "dict_find" sig "( d:Dict k:Unknown -- v:Unknown found:Scalar )" desc "The value at k and 1, or 0 0 when k is absent."
tool "dict" name "dict_get" sig "( d:Dict k:Unknown -- v:Unknown )" desc "The value at k; stops the program when k is absent (use dict_find or dict_get_or when it may be)."
tool "dict" name "dict_get_or" sig "( d:Dict k:Unknown default:Unknown -- v:Unknown )" desc "The value at k, or default when k is absent."
tool "dict" name "dict_has" sig "( d:Dict k:Unknown -- f:Scalar )" desc "1 when k is a key."
tool "dict" name "dict_add" sig "( d:Dict k:Unknown n:Scalar -- )" desc "Adds n to the number stored at k (0 when absent): counting."
tool "dict" name "dict_del" sig "( d:Dict k:Unknown -- found:Scalar )" desc "Removes k; 1 if it was there."
tool "dict" name "dict_slot" sig "( d:Dict i:Scalar -- k:Unknown v:Unknown live:Scalar )" desc "Slot i (0 <= i < dict_cap): its key, value and 1 when it holds one, else 0 0 0. `d dict_cap [times| i | d i dict_slot -> [ k v live ] live when [ ... ] ]`."
tool "dict" name "dict_keys" sig "( d:Dict -- b:Block )" desc "Every key as a Block, in slot order (no particular order)."

tool "file" name "f_read" sig "( -- mode:Scalar )" desc "Open mode for reading (fopen's mode argument)."
tool "file" name "f_write" sig "( -- mode:Scalar )" desc "Open mode for writing, truncating any existing contents."
tool "file" name "f_append" sig "( -- mode:Scalar )" desc "Open mode for writing at the end of an existing file."
tool "file" name "f_stdin" sig "( -- fh:File )" desc "The pre-opened standard input handle."
tool "file" name "f_stdout" sig "( -- fh:File )" desc "The pre-opened standard output handle."
tool "file" name "f_stderr" sig "( -- fh:File )" desc "The pre-opened standard error handle."
tool "file" name "f_open_read" sig "( path:Block -- fh:File ok:Scalar )" desc "Opens a path for reading; ok=0 if it could not be opened."
tool "file" name "f_open_write" sig "( path:Block -- fh:File ok:Scalar )" desc "Opens a path for writing, truncating it; ok=0 if it could not be opened."
tool "file" name "f_open_append" sig "( path:Block -- fh:File ok:Scalar )" desc "Opens a path for appending; ok=0 if it could not be opened."
tool "file" name "f_write_str" sig "( fh:File str:Block -- ok:Scalar )" desc "Writes a whole string in one pass; ok=0 if fewer characters were written than it holds."
tool "file" name "f_write_line" sig "( fh:File str:Block -- ok:Scalar )" desc "Writes a whole string followed by a newline; ok=0 if either write fell short."
tool "file" name "f_chunk" sig "( -- n:Scalar )" desc "Default read chunk size in characters, for a caller driving its own fread loop."
tool "file" name "f_next_chunk" sig "( n:Scalar -- n:Scalar )" desc "Chunk growth policy: doubles, capped, so a whole-file read stays linear."
tool "file" name "f_read_all" sig "( fh:File -- str:Block )" desc "Reads to end of input in geometrically growing chunks; one Block slot per character."
tool "file" name "f_read_line" sig "( fh:File -- line:Block got:Scalar )" desc "Reads up to and consuming the next newline, which is not returned; got=0 at end of input."
tool "file" name "f_read_file" sig "( path:Block -- str:Block ok:Scalar )" desc "Opens, reads to end, closes; ok=0 (with an empty result) if the open or close failed."
tool "file" name "f_write_file" sig "( path:Block str:Block -- ok:Scalar )" desc "Opens truncating, writes, closes; ok=0 if any step failed."
tool "file" name "f_append_file" sig "( path:Block str:Block -- ok:Scalar )" desc "Opens for append, writes, closes; ok=0 if any step failed."
tool "file" name "f_expand_home" sig "( path:Block -- path:Block )" desc "A leading ~/ (or a lone ~) replaced by $HOME; any other path, or an unset HOME, unchanged."

tool "list" name "lst_make" sig "( initial_capacity:Scalar -- ptr:Ptr )" desc "A new growable list with room for initial_capacity elements before it grows."
tool "list" name "lst_get" sig "( ptr:Ptr idx:Scalar -- val:Unknown )" desc "The element at index idx (0-based)."
tool "list" name "lst_set" sig "( ptr:Ptr idx:Scalar val:Unknown -- )" desc "Replace the element at index idx."
tool "list" name "lst_new_cap" sig "( old_cap:Scalar -- new_cap:Scalar )" desc "Doubles a capacity (or 1 if 0)."
tool "list" name "lst_grow" sig "( ptr:Ptr -- )" desc "Reallocates the list's backing storage at double capacity, copying existing elements."
tool "list" name "lst_push" sig "( ptr:Ptr val:Unknown -- )" desc "Grows the list (doubling capacity) when full; never silently drops."
tool "list" name "lst_try_push" sig "( ptr:Ptr val:Unknown -- ok:Scalar )" desc "Does not grow; returns 0 when full instead of pushing."

type "map" name "IntMap" base "Ptr"
tool "map" name "IntMap_of" sig "( x:Ptr -- v:IntMap )" desc "Generated by `#type IntMap`: makes an IntMap from its base value."
tool "map" name "IntMap_raw" sig "( v:IntMap -- x:Ptr )" desc "Generated by `#type IntMap`: the base value of an IntMap."
tool "map" name "map_make" sig "( buckets_size:Scalar -- m:IntMap )" desc "A new map from Scalar keys to values with buckets_size buckets (one key per bucket; see map_set)."
tool "map" name "map_hash" sig "( key:Scalar buckets_size:Scalar -- bucket_idx:Scalar )" desc "Computes the bucket index for a key."
tool "map" name "map_find" sig "( m:IntMap key:Scalar -- val:Unknown found:Scalar )" desc "Looks up a key; found=0 (val=0) rather than a sentinel when absent."
tool "map" name "map_get" sig "( m:IntMap key:Scalar -- val:Unknown )" desc "Aborts when the key is absent; use map_find if absence is expected."
tool "map" name "map_set" sig "( m:IntMap key:Scalar val:Unknown -- ok:Scalar )" desc "ok=0 if the write would clobber a different existing key at that bucket."

tool "memory" name "hclear" sig "( p:Ptr start:Scalar size:Scalar -- )" desc "Set size cells from start to 0."
tool "memory" name "hloop_fill" sig "( p:Ptr start:Scalar stop:Scalar val:Scalar -- )" desc "Set the cells start..stop-1 to val."
tool "memory" name "hloop_add" sig "( p:Ptr start:Scalar stop:Scalar val:Scalar -- )" desc "Add val to each of the cells start..stop-1."
tool "memory" name "h_find_val" sig "( ptr:Ptr size:Scalar val:Scalar -- index:Scalar )" desc "Scans sequential heap cells for a target value; returns 0-indexed offset or -1."

tool "numeric" name "vec_dot" sig "( a:Ptr ao:Scalar b:Ptr bo:Scalar n:Scalar -- s:Scalar )" desc "The dot product of a[ao..ao+n) and b[bo..bo+n), as a float."
tool "numeric" name "vec_axpy" sig "( y:Ptr yo:Scalar x:Ptr xo:Scalar n:Scalar g:Scalar -- )" desc "y[yo+i] += g * x[xo+i] for i < n."
tool "numeric" name "vec_add" sig "( x:Ptr xo:Scalar y:Ptr yo:Scalar n:Scalar -- )" desc "y[yo+i] += x[xo+i] for i < n."
tool "numeric" name "vec_scale" sig "( p:Ptr off:Scalar n:Scalar g:Scalar -- )" desc "p[off+i] *= g for i < n."
tool "numeric" name "vec_sum" sig "( p:Ptr off:Scalar n:Scalar -- s:Scalar )" desc "The sum of p[off..off+n) (0 for an empty range)."
tool "numeric" name "vec_argmax" sig "( p:Ptr off:Scalar n:Scalar -- i:Scalar )" desc "The index (0..n-1) of the first largest value in p[off..off+n); an empty range aborts."
tool "numeric" name "vec_max" sig "( p:Ptr off:Scalar n:Scalar -- m:Scalar )" desc "The largest value in p[off..off+n); an empty range aborts."
tool "numeric" name "vec_be32" sig "( p:Ptr off:Scalar -- n:Scalar )" desc "The big-endian signed 32-bit integer in the four byte cells p[off..off+4) (after fread_into)."
tool "numeric" name "vec_le32" sig "( p:Ptr off:Scalar -- n:Scalar )" desc "The little-endian signed 32-bit integer in the four byte cells p[off..off+4)."

tool "procinfo" name "proc_line_num" sig "( line:Block start:Scalar -- n:Scalar )" desc "The number in a /proc status line from index start on: digits only, other characters skipped."
tool "procinfo" name "proc_status_kb" sig "( key:Block -- kb:Scalar ok:Scalar )" desc "The value of a /proc/self/status field such as \"VmRSS:\" (kB); ok=0 when absent."
tool "procinfo" name "proc_peak_kb" sig "( -- kb:Scalar )" desc "Peak resident memory so far (VmHWM) in kB: the figure to report, not VmPeak."
tool "procinfo" name "proc_rss_kb" sig "( -- kb:Scalar )" desc "Resident memory now (VmRSS) in kB."

tool "record" name "rec_make" sig "( size:Scalar -- ptr:Ptr )" desc "Allocate a record of size cells (all 0); fields are addressed by offset."
tool "record" name "rec_get" sig "( ptr:Ptr field_offset:Scalar -- val:Unknown )" desc "Read the field at field_offset."
tool "record" name "rec_set" sig "( ptr:Ptr field_offset:Scalar val:Unknown -- )" desc "Write the field at field_offset."

tool "strings" name "str_print" sig "( str:Block -- )" desc "Prints a string (block of ASCII codes) to stdout."
tool "strings" name "is_digit" sig "( ch:Scalar -- flag:Scalar )" desc "1 if char code is 0-9, else 0."
tool "strings" name "is_space" sig "( ch:Scalar -- flag:Scalar )" desc "1 if char code is space/tab/newline/CR, else 0."
tool "strings" name "is_upper" sig "( ch:Scalar -- flag:Scalar )" desc "1 if char code is A-Z, else 0."
tool "strings" name "is_lower" sig "( ch:Scalar -- flag:Scalar )" desc "1 if char code is a-z, else 0."
tool "strings" name "int_to_str" sig "( n:Scalar -- str:Block )" desc "Converts a signed integer to its digit-character block."
tool "strings" name "int_to_str_pad" sig "( n:Scalar width:Scalar -- s:Block )" desc "Decimal string zero-padded to width characters, the sign counted: -5 3 is -05."
tool "strings" name "print_fixed" sig "( v:Scalar decimals:Scalar -- )" desc "Print an integer as fixed point with decimals digits after the point: 12345 3 is 12.345."
tool "strings" name "print_line" sig "( n:Scalar -- )" desc "Prints an integer followed by a newline."
tool "strings" name "str_to_int" sig "( chars:Block start:Scalar end:Scalar -- n:Scalar ok:Scalar )" desc "Multi-digit signed parse of [start,end); ok=0 if not entirely digits (plus an optional leading '-')."
tool "strings" name "fs_matches_at" sig "( hay:Block needle:Block i:Scalar nlen:Scalar -- match:Scalar )" desc "1 if needle occurs in hay starting exactly at i."
tool "strings" name "find_sub" sig "( hay:Block needle:Block start:Scalar -- pos:Scalar found:Scalar )" desc "First index >= from where needle occurs in hay; found=0 if absent."

tool "util" name "reverse" sig "( block:Block -- reversed:Block )" desc "Reverses an immutable block."
tool "util" name "length" sig "( block:Block -- n:Scalar )" desc "Counts elements in a block."
tool "util" name "nth" sig "( block:Block idx:Scalar -- val:Unknown )" desc "Element at a 0-indexed position."
tool "util" name "sum" sig "( block:Block -- total:Scalar )" desc "Sums scalar elements."
tool "util" name "contains" sig "( block:Block target:Scalar -- flag:Scalar )" desc "1 if target present, else 0."
tool "util" name "filter_eq" sig "( block:Block target:Scalar -- filtered:Block )" desc "Keeps elements equal to target (order preserved)."
tool "util" name "index_of" sig "( block:Block target:Scalar -- idx:Scalar )" desc "First index equal to target, or -1."
tool "util" name "concat" sig "( b1:Block b2:Block -- joined:Block )" desc "Concatenates two blocks; empty-safe."
tool "util" name ">=" sig "( a:Scalar b:Scalar -- bool:Scalar )" desc "1 if a >= b, else 0."
tool "util" name "<=" sig "( a:Scalar b:Scalar -- bool:Scalar )" desc "1 if a <= b, else 0."
tool "util" name "block_eq" sig "( b1:Block b2:Block -- equal:Scalar )" desc "Checks element-by-element equality of two blocks."
tool "util" name "insert_sorted" sig "( val:Unknown blk:Block -- result:Block )" desc "Inserts a value into an already-sorted block, preserving order."
tool "util" name "block_sort" sig "( blk:Block -- sorted:Block )" desc "Performs stable sorting on a block."
tool "util" name "assert" sig "( ok:Scalar msg:Block -- )" desc "Stop the program with msg (via abort) unless ok is nonzero."
tool "util" name "expect" sig "( ok:Scalar msg:Block -- ok:Scalar )" desc "For #test_ words: ok passes through; when it is 0, prints `  expected: msg`."
tool "util" name "expect_eq" sig "( got:Unknown want:Unknown msg:Block -- ok:Scalar )" desc "For #test_ words: got = want (any values, as `=`); when not, prints msg with both values."
tool "util" name "expect_near" sig "( got:Scalar want:Scalar tol:Scalar msg:Block -- ok:Scalar )" desc "For #test_ words: |got - want| <= tol; when not, prints msg, both values and tol."

type "vec" name "Vec" base "Ptr"
tool "vec" name "Vec_of" sig "( x:Ptr -- v:Vec )" desc "Generated by `#type Vec`: makes a Vec from its base value."
tool "vec" name "Vec_raw" sig "( v:Vec -- x:Ptr )" desc "Generated by `#type Vec`: the base value of a Vec."
tool "vec" name "vec_new" sig "( cap:Scalar -- v:Vec )" desc "A new, empty Vec with room for cap values before it grows."
tool "vec" name "vec_len" sig "( v:Vec -- n:Scalar )" desc "The number of values."
tool "vec" name "vec_cap" sig "( v:Vec -- n:Scalar )" desc "How many values fit before the Vec grows."
tool "vec" name "vec_data" sig "( v:Vec -- p:Ptr )" desc "The cells holding the values (0 .. vec_len - 1), for hsort, hmove and the numeric lexicon; a push may move them, so get it again after one."
tool "vec" name "vec_reserve" sig "( v:Vec n:Scalar -- )" desc "Room for at least n values."
tool "vec" name "vec_push" sig "( v:Vec x:Unknown -- )" desc "Appends x, growing the Vec when full (amortized O(1))."
tool "vec" name "vec_get" sig "( v:Vec i:Scalar -- x:Unknown )" desc "The value at index i; stops the program when i is outside 0 .. vec_len - 1."
tool "vec" name "vec_set" sig "( v:Vec i:Scalar x:Unknown -- )" desc "Replaces the value at index i; stops the program when i is outside 0 .. vec_len - 1."
tool "vec" name "vec_last" sig "( v:Vec -- x:Unknown )" desc "The last value; stops the program when the Vec is empty."
tool "vec" name "vec_pop" sig "( v:Vec -- x:Unknown )" desc "Removes and returns the last value; stops the program when the Vec is empty."
tool "vec" name "vec_clear" sig "( v:Vec -- )" desc "Empties the Vec, keeping its capacity."
tool "vec" name "vec_from_block" sig "( b:Block -- v:Vec )" desc "A Vec holding the elements of b, in order."
tool "vec" name "vec_to_block" sig "( v:Vec -- b:Block )" desc "The values as a Block, in order."
tool "vec" name "vec_sort" sig "( v:Vec -- )" desc "Sorts the values ascending as hsort orders them (numbers by value, strings and rows element by element), stably. A Ptr value (a Vec, a Dict, hnull) stops the program: sort rows as Blocks or #struct values, and turn a NULL into a number first."
tool "vec" name "sort_by" sig "( p:Ptr off:Scalar n:Scalar less:Word(Unknown,Unknown--Scalar) -- )" desc "Sorts the n cells of p from off, stably, in the order of the word passed: less ( a b -- f ) is nonzero when a must come before b. `p 0 n 'by_age sort_by`."
tool "vec" name "vec_sort_by" sig "( v:Vec less:Word(Unknown,Unknown--Scalar) -- )" desc "Sorts the Vec as sort_by does: `v 'by_age vec_sort_by`."

{ ---- Primitives: built into the compiler, no `use` needed. Not loaded by the compiler; checked against it by tools/build_manifest.py ---- }

prim name "dup" sig "( x:Unknown -- x:Unknown x:Unknown )" desc "Copy the top value."
prim name "drop" sig "( x:Unknown -- )" desc "Discard the top value."
prim name "swap" sig "( x:Unknown y:Unknown -- y:Unknown x:Unknown )" desc "Exchange the top two values."
prim name "rot" sig "( x:Unknown y:Unknown z:Unknown -- y:Unknown z:Unknown x:Unknown )" desc "Rotate the third value to the top."
prim name "over" sig "( x:Unknown y:Unknown -- x:Unknown y:Unknown x:Unknown )" desc "Copy the second value to the top."
prim name "cons" sig "( b:Block x:Unknown -- b2:Block )" desc "Prepend x to a Block (the Block first, as every word that adds to something)."
prim name "pair" sig "( a:Unknown b:Unknown -- b2:Block )" desc "The two-slot Block [ a b ]."
prim name "len" sig "( b:Unknown -- n:Scalar )" desc "Slot count of a Block."
prim name "block_slice" sig "( b:Block start:Scalar stop:Scalar -- b2:Block )" desc "Elements start <= i < stop as a new Block; bounds clamp, start >= stop is empty. O(stop - start)."
prim name "at" sig "( b:Block i:Scalar -- v:Unknown )" desc "Integer-indexed read of a homogeneous Block (spec Sec.4 _at)."
prim name "array_at" sig "( b:Block i:Scalar -- v:Unknown )" desc "Spelling of `at` for arrays."
prim name "arr_at" sig "( b:Block i:Scalar -- v:Unknown )" desc "Spelling of `at` for arrays."
prim name "list_at" sig "( b:Block i:Scalar -- v:Unknown )" desc "Spelling of `at` for lists."
prim name "block_at" sig "( b:Block i:Scalar -- v:Unknown )" desc "Spelling of `at` for Blocks."
prim name "block_get" sig "( b:Block k:Scalar -- v:Unknown )" desc "Static-slot read (spec Sec.4 _get)."
prim name "array_get" sig "( b:Block k:Scalar -- v:Unknown )" desc "Spelling of `_get` for arrays."
prim name "list_get" sig "( b:Block k:Scalar -- v:Unknown )" desc "Spelling of `_get` for lists."
prim name "record_get" sig "( r:Block k:Scalar -- v:Unknown )" desc "Spelling of `_get` for records."
prim name "block_set" sig "( b:Block k:Scalar v:Unknown -- b2:Block )" desc "Functional update: a copy with slot k replaced; same type only (spec Sec.4 _set)."
prim name "array_set" sig "( b:Block k:Scalar v:Unknown -- b2:Block )" desc "Spelling of `_set` for arrays."
prim name "list_set" sig "( b:Block k:Scalar v:Unknown -- b2:Block )" desc "Spelling of `_set` for lists."
prim name "record_set" sig "( r:Block k:Scalar v:Unknown -- r2:Block )" desc "Spelling of `_set` for records."
prim name "hnew" sig "( size:Scalar -- p:Ptr )" desc "Allocate size heap cells (spec Sec.5)."
prim name "hread" sig "( p:Ptr i:Scalar -- v:Unknown )" desc "Read heap cell i. Untyped: wrap it in a word whose signature states the real type."
prim name "until" sig "( flag:Scalar -- )" desc "Only as `until [ c ]`, the first thing in a times/for body: the loop ends when c is true; the stack keeps the loop's shape."
prim name "while" sig "( flag:Scalar -- )" desc "Only as `while [ c ]`, the first thing in a times/for body: the loop ends when c is false."
prim name "hwrite" sig "( p:Ptr i:Scalar v:Unknown -- )" desc "Write v into heap cell i (the cell first, the value last)."
prim name "hmark" sig "( -- mark:Scalar )" desc "Mark the heap arena (spec Sec.5)."
prim name "hrelease" sig "( mark:Scalar -- )" desc "Release every heap cell allocated since mark."
prim name "hsort" sig "( p:Ptr start:Scalar count:Scalar -- )" desc "Sort heap cells [start, start+count) ascending, in place, stably: numbers by value, Blocks (strings, rows, #struct values) element by element. A cell holding a Ptr (a Vec, a Dict, hnull) is a fatal error."
prim name "+" sig "( a:Scalar b:Scalar -- c:Scalar )" desc "Add."
prim name "-" sig "( a:Scalar b:Scalar -- c:Scalar )" desc "Subtract."
prim name "*" sig "( a:Scalar b:Scalar -- c:Scalar )" desc "Multiply."
prim name "/" sig "( a:Scalar b:Scalar -- c:Scalar )" desc "Divide: truncates toward zero if both are integers, float if either is a float."
prim name "\\" sig "( a:Scalar b:Scalar -- c:Scalar )" desc "Floored remainder of two integers: the sign of the divisor."
prim name "abs" sig "( a:Scalar -- b:Scalar )" desc "Absolute value."
prim name "exp" sig "( x:Scalar -- y:Scalar )" desc "e to the power x, as a float."
prim name "log" sig "( x:Scalar -- y:Scalar )" desc "Natural logarithm, as a float (0 gives -inf, a negative number nan)."
prim name "sqrt" sig "( x:Scalar -- y:Scalar )" desc "Square root, as a float (a negative number gives nan)."
prim name "pow" sig "( x:Scalar y:Scalar -- z:Scalar )" desc "x to the power y, as a float."
prim name "floor" sig "( x:Scalar -- n:Scalar )" desc "The largest integer not above x (an integer passes through; NaN, infinity and out-of-range floats are fatal)."
prim name "seed" sig "( s:Scalar -- )" desc "Restart rand's sequence from the integer s (the default is 0 seed)."
prim name "rand" sig "( -- x:Scalar )" desc "A pseudo-random float, uniform on [0, 1)."
prim name "min" sig "( a:Scalar b:Scalar -- c:Scalar )" desc "Smaller of two."
prim name "max" sig "( a:Scalar b:Scalar -- c:Scalar )" desc "Larger of two."
prim name "to_float" sig "( a:Scalar -- f:Scalar )" desc "Explicit float cast."
prim name "=" sig "( a:Unknown b:Unknown -- f:Scalar )" desc "1 if equal, else 0."
prim name "!=" sig "( a:Unknown b:Unknown -- f:Scalar )" desc "1 if not equal, else 0."
prim name ">" sig "( a:Scalar b:Scalar -- f:Scalar )" desc "1 if a > b, else 0. (>= and <= are in util.) For Blocks (strings), use sort_cmp."
prim name "<" sig "( a:Scalar b:Scalar -- f:Scalar )" desc "1 if a < b, else 0. For Blocks (strings), use sort_cmp."
prim name "and" sig "( a:Scalar b:Scalar -- f:Scalar )" desc "Logical and. Eager: both operands are always evaluated."
prim name "or" sig "( a:Scalar b:Scalar -- f:Scalar )" desc "Logical or. Eager: both operands are always evaluated."
prim name "not" sig "( a:Scalar -- f:Scalar )" desc "LOGICAL not: 1 if a is 0, else 0. For the bitwise complement use bitnot."
prim name "select" sig "( vt:Unknown vf:Unknown flag:Scalar -- v:Unknown )" desc "vt if flag is nonzero, else vf. Both are always evaluated."
prim name "bitand" sig "( a:Scalar b:Scalar -- c:Scalar )" desc "Bitwise and (integers only)."
prim name "bitor" sig "( a:Scalar b:Scalar -- c:Scalar )" desc "Bitwise or (integers only)."
prim name "bitxor" sig "( a:Scalar b:Scalar -- c:Scalar )" desc "Bitwise xor (integers only)."
prim name "bitshl" sig "( a:Scalar n:Scalar -- c:Scalar )" desc "Shift left by n bits."
prim name "bitshr" sig "( a:Scalar n:Scalar -- c:Scalar )" desc "Shift right by n bits."
prim name "bitnot" sig "( a:Scalar -- c:Scalar )" desc "BITWISE complement: 6 bitnot is -7. A 9-bit mask complement is `bitnot 511 bitand`."
prim name "bitcount" sig "( a:Scalar -- n:Scalar )" desc "Number of set bits of the 64-bit pattern (-1 bitcount is 64)."
prim name "bitctz" sig "( a:Scalar -- n:Scalar )" desc "Trailing zero bits: the index of the lowest set bit; 64 for 0."
prim name "bitclz" sig "( a:Scalar -- n:Scalar )" desc "Leading zero bits of the 64-bit pattern; 64 for 0."
prim name "print_char" sig "( ch:Scalar -- )" desc "Write one character code to stdout."
prim name "print_int" sig "( n:Scalar -- )" desc "Write an integer to stdout (a float is fatal: to_int or floor it, or use print_float)."
prim name "print_float" sig "( x:Scalar decimals:Scalar -- )" desc "Write a number with the given number of decimals (0-17), formatted as printf %.*f."
prim name "abort" sig "( msg:Block -- )" desc "Print msg to stderr and exit nonzero. Never returns; an aborting cond branch is exempt from branch matching."
prim name "fopen" sig "( path:Block mode:Scalar -- fh:File ok:Scalar )" desc "Open a file (spec Sec.12)."
prim name "fclose" sig "( fh:File -- ok:Scalar )" desc "Close a file."
prim name "fgetc" sig "( fh:File -- ch:Scalar ok:Scalar )" desc "Read one character; ok=0 at end of file."
prim name "fputc" sig "( fh:File ch:Scalar -- ok:Scalar )" desc "Write one character."
prim name "fread" sig "( fh:File n:Scalar -- str:Block )" desc "Read up to n characters."
prim name "fwrite" sig "( fh:File str:Block -- written:Scalar )" desc "Write a Block of characters; returns the count written."
prim name "freadline" sig "( fh:File -- line:Block got:Scalar )" desc "Read the next line in one pass, newline consumed; got=0 only at end of input with nothing read."
prim name "fread_into" sig "( fh:File p:Ptr start:Scalar count:Scalar -- got:Scalar )" desc "Read up to count bytes into heap cells from start, as integers; returns how many."
prim name "fwrite_from" sig "( fh:File p:Ptr start:Scalar count:Scalar -- written:Scalar )" desc "Write the cells p[start..start+count) as bytes (each 0-255) in one call; returns how many."
prim name "fflush" sig "( fh:File -- ok:Scalar )" desc "Write out what is buffered for fh now (redirected stdout is block-buffered)."
prim name "to_str" sig "( v:Unknown -- s:Block )" desc "Any value as text, as trace writes it but whole: 42, 2.5, 3.0, [ 1 [ 2 3 ] ], a string with its text as a comment, [ 104 105 ] { \"hi\" }."
prim name "bytes_new" sig "( n:Scalar -- a:Bytes )" desc "A new Bytes array of n bytes, all 0: one byte per element (a Ptr's cells take 16)."
prim name "bytes_len" sig "( a:Bytes -- n:Scalar )" desc "The number of elements."
prim name "bytes_get" sig "( a:Bytes i:Scalar -- x:Scalar )" desc "Element i (0 <= i < len) as an integer 0..255."
prim name "bytes_set" sig "( a:Bytes i:Scalar x:Scalar --  )" desc "Stores x, an integer 0..255, at i; any other value stops the program."
prim name "bytes_fill" sig "( a:Bytes start:Scalar count:Scalar x:Scalar --  )" desc "Stores the byte x in count elements from start."
prim name "bytes_move" sig "( src:Bytes soff:Scalar dst:Bytes doff:Scalar count:Scalar --  )" desc "Copies count elements from src at soff to dst at doff (overlap-safe)."
prim name "ints_new" sig "( n:Scalar -- a:Ints )" desc "A new Ints array of n 64-bit integers, all 0 (8 bytes each)."
prim name "ints_len" sig "( a:Ints -- n:Scalar )" desc "The number of elements."
prim name "ints_get" sig "( a:Ints i:Scalar -- x:Scalar )" desc "Element i (0 <= i < len)."
prim name "ints_set" sig "( a:Ints i:Scalar x:Scalar --  )" desc "Stores the integer x at i; a float stops the program."
prim name "ints_fill" sig "( a:Ints start:Scalar count:Scalar x:Scalar --  )" desc "Stores x in count elements from start."
prim name "ints_move" sig "( src:Ints soff:Scalar dst:Ints doff:Scalar count:Scalar --  )" desc "Copies count elements from src at soff to dst at doff (overlap-safe)."
prim name "floats_new" sig "( n:Scalar -- a:Floats )" desc "A new Floats array of n 64-bit floats, all 0.0 (8 bytes each)."
prim name "floats_len" sig "( a:Floats -- n:Scalar )" desc "The number of elements."
prim name "floats_get" sig "( a:Floats i:Scalar -- x:Scalar )" desc "Element i (0 <= i < len), a float."
prim name "floats_set" sig "( a:Floats i:Scalar x:Scalar --  )" desc "Stores the number x (an integer is converted) at i."
prim name "floats_fill" sig "( a:Floats start:Scalar count:Scalar x:Scalar --  )" desc "Stores x in count elements from start."
prim name "floats_move" sig "( src:Floats soff:Scalar dst:Floats doff:Scalar count:Scalar --  )" desc "Copies count elements from src at soff to dst at doff (overlap-safe)."
prim name "bytes_read" sig "( fh:File a:Bytes start:Scalar count:Scalar -- got:Scalar )" desc "Reads up to count bytes from fh into a from start; got is how many (0 at the end of input)."
prim name "bytes_write" sig "( fh:File a:Bytes start:Scalar count:Scalar -- written:Scalar )" desc "Writes count bytes of a from start to fh; written < count means the write failed part way."
prim name "bytes_to_block" sig "( a:Bytes start:Scalar count:Scalar -- s:Block )" desc "count bytes of a from start as a Block (a string)."
prim name "bytes_from_block" sig "( s:Block -- a:Bytes )" desc "A Bytes array holding the Block's elements, each an integer 0..255 (a string)."
prim name "ints_sort" sig "( a:Ints start:Scalar count:Scalar --  )" desc "Sorts count elements from start ascending, in place."
prim name "floats_sort" sig "( a:Floats start:Scalar count:Scalar --  )" desc "Sorts count elements from start ascending, in place."
prim name "floats_dot" sig "( a:Floats ao:Scalar b:Floats bo:Scalar n:Scalar -- s:Scalar )" desc "The dot product of a[ao..ao+n) and b[bo..bo+n), in C (vectorised); four partial sums, so the rounding can differ in the last bits from a loop's, the same on every run."
prim name "floats_axpy" sig "( y:Floats yo:Scalar x:Floats xo:Scalar n:Scalar g:Scalar --  )" desc "y[yo+i] += g * x[xo+i] for i < n, in C (vectorised)."
prim name "floats_add" sig "( y:Floats yo:Scalar x:Floats xo:Scalar n:Scalar --  )" desc "y[yo+i] += x[xo+i] for i < n."
prim name "floats_mul" sig "( y:Floats yo:Scalar x:Floats xo:Scalar n:Scalar --  )" desc "y[yo+i] *= x[xo+i] for i < n (element by element)."
prim name "floats_scale" sig "( a:Floats start:Scalar count:Scalar g:Scalar --  )" desc "a[start+i] *= g for i < count."
prim name "floats_sum" sig "( a:Floats start:Scalar count:Scalar -- s:Scalar )" desc "The sum of a[start..start+count), in C (four partial sums)."
prim name "floats_max" sig "( a:Floats start:Scalar count:Scalar -- m:Scalar )" desc "The largest of a[start..start+count); an empty range stops the program."
prim name "floats_argmax" sig "( a:Floats start:Scalar count:Scalar -- i:Scalar )" desc "The index (0..count-1) of the first largest of a[start..start+count); an empty range stops the program."
prim name "floats_from_bytes" sig "( y:Floats yo:Scalar b:Bytes bo:Scalar n:Scalar scale:Scalar --  )" desc "y[yo+i] = b[bo+i] * scale for i < n: bytes (pixels) to floats in one pass."
prim name "ints_sum" sig "( a:Ints start:Scalar count:Scalar -- s:Scalar )" desc "The sum of a[start..start+count)."
prim name "ints_max" sig "( a:Ints start:Scalar count:Scalar -- m:Scalar )" desc "The largest of a[start..start+count); an empty range stops the program."
prim name "ints_argmax" sig "( a:Ints start:Scalar count:Scalar -- i:Scalar )" desc "The index (0..count-1) of the first largest of a[start..start+count); an empty range stops the program."
prim name "bytes_be32" sig "( a:Bytes i:Scalar -- n:Scalar )" desc "The signed 32-bit big-endian integer in a[i..i+4) (IDX and network headers)."
prim name "bytes_le32" sig "( a:Bytes i:Scalar -- n:Scalar )" desc "The signed 32-bit little-endian integer in a[i..i+4)."
prim name "bytes_be16" sig "( a:Bytes i:Scalar -- n:Scalar )" desc "The unsigned 16-bit big-endian integer in a[i..i+2)."
prim name "bytes_le16" sig "( a:Bytes i:Scalar -- n:Scalar )" desc "The unsigned 16-bit little-endian integer in a[i..i+2)."
prim name "fseek" sig "( fh:File pos:Scalar -- ok:Scalar )" desc "Move to an absolute byte offset; ok=0 when the stream cannot seek."
prim name "ftell" sig "( fh:File -- pos:Scalar )" desc "Current byte offset; -1 when the stream has none (a pipe)."
prim name "argc" sig "( -- n:Scalar )" desc "Command-line argument count, program name included (spec Sec.13)."
prim name "argv" sig "( i:Scalar -- arg:Block ok:Scalar )" desc "Argument i, C indexing (0 is the program); ok=0 when out of range."
prim name "getenv" sig "( name:Block -- value:Block ok:Scalar )" desc "Environment variable, read-only; ok=0 and an empty Block when unset, ok=1 (value possibly empty) when set."
prim name "sort_cmp" sig "( a:Unknown b:Unknown -- c:Scalar )" desc "-1, 0 or 1 as hsort orders a and b: numbers by value, Blocks element by element (strings in byte order), numbers before Blocks."
prim name "hmove" sig "( src:Ptr soff:Scalar dst:Ptr doff:Scalar count:Scalar -- )" desc "Copy count heap cells from src to dst; overlapping ranges are safe."
prim name "hfill" sig "( p:Ptr start:Scalar count:Scalar v:Unknown -- )" desc "Store v in every heap cell of the range."
prim name "trace" sig "( v:Unknown -- )" desc "Print the value (any type) and the trace's source line to stderr, for debugging."
prim name "exit" sig "( code:Scalar -- )" desc "End the program with exit status code (0-255), flushing stdout. Never returns."
prim name "to_int" sig "( x:Scalar -- n:Scalar )" desc "An integer as is; a float truncated toward zero. NaN, infinity and out-of-range floats are fatal."
prim name "float_to_str" sig "( x:Scalar decimals:Scalar -- s:Block )" desc "The text print_float prints (printf %.*f, 0-17 decimals), as a Block of character codes."
prim name "type_of" sig "( v:Unknown -- t:Scalar )" desc "The value's runtime type: 0 integer, 1 float, 2 Block, 3 Ptr (a File handle is an integer)."
prim name "hnull" sig "( -- p:Ptr )" desc "A Ptr that refers to nothing; equal only to another hnull; hread/hwrite through it are fatal."
prim name "clock_ns" sig "( -- ns:Scalar )" desc "Nanoseconds from a monotonic clock; only differences between readings mean anything."
