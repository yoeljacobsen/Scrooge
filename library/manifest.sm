{ ---- Scrooge Core Standard Library MCP Discovery Manifest ---- }

tool "array" name "arr_size" sig "( shape_block -- total_cells )" desc "..."
tool "array" name "arr_make" sig "( shape_block -- ptr )" desc "..."
tool "array" name "arr_offset" sig "( ptr coords_block -- flat_offset )" desc "..."
tool "array" name "arr_get" sig "( ptr coords_block -- val )" desc "..."
tool "array" name "arr_set" sig "( val ptr coords_block -- )" desc "..."
tool "list" name "lst_make" sig "( initial_capacity -- ptr )" desc "..."
tool "list" name "lst_get" sig "( ptr idx -- val )" desc "..."
tool "list" name "lst_set" sig "( val ptr idx -- )" desc "..."
tool "list" name "lst_push" sig "( val ptr -- )" desc "..."
tool "map" name "map_make" sig "( buckets_size -- ptr )" desc "..."
tool "map" name "map_get" sig "( ptr key -- val )" desc "..."
tool "map" name "map_set" sig "( val ptr key -- )" desc "..."
tool "record" name "rec_make" sig "( size -- ptr )" desc "..."
tool "record" name "rec_get" sig "( ptr field_offset -- val )" desc "..."
tool "record" name "rec_set" sig "( val ptr field_offset -- )" desc "..."
tool "memory" name "hclear" sig "( ptr start size -- )" desc "..."
tool "memory" name "hloop_fill" sig "( ptr start stop val -- )" desc "..."
tool "memory" name "hloop_add" sig "( ptr start stop val -- )" desc "..."

tool "memory" name "h_find_val" sig "( ptr size val -- index )" desc "Scans sequential heap cells for a target value; returns 0-indexed offset or -1."

tool "util" name "reverse" sig "( block -- reversed )" desc "Reverses an immutable block."
tool "util" name "length" sig "( block -- n )" desc "Counts elements in a block."
tool "util" name "nth" sig "( block idx -- val )" desc "Element at a 0-indexed position."
tool "util" name "sum" sig "( block -- total )" desc "Sums scalar elements."
tool "util" name "contains" sig "( block target -- flag )" desc "1 if target present, else 0."
tool "util" name "filter_eq" sig "( block target -- filtered )" desc "Keeps elements equal to target (order preserved)."
tool "util" name "index_of" sig "( block target -- idx )" desc "First index equal to target, or -1."
tool "util" name "concat" sig "( block1 block2 -- joined )" desc "Concatenates two blocks; empty-safe."
tool "util" name ">=" sig "( a b -- bool )" desc "1 if a >= b, else 0."
tool "util" name "<=" sig "( a b -- bool )" desc "1 if a <= b, else 0."

tool "strings" name "str_print" sig "( str -- )" desc "Prints a string (block of ASCII codes) to stdout."
tool "strings" name "is_digit" sig "( ch -- flag )" desc "1 if char code is 0-9, else 0."
tool "strings" name "is_space" sig "( ch -- flag )" desc "1 if char code is space/tab/newline/CR, else 0."
tool "strings" name "is_upper" sig "( ch -- flag )" desc "1 if char code is A-Z, else 0."
tool "strings" name "is_lower" sig "( ch -- flag )" desc "1 if char code is a-z, else 0."
tool "strings" name "int_to_str" sig "( n -- str )" desc "Converts a non-negative integer to its digit-character block."
tool "strings" name "print_line" sig "( n -- )" desc "Prints an integer followed by a newline."
