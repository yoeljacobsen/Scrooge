{ ---- Scrooge Core Standard Library MCP Discovery Manifest ---- }

tool "args" name "arg_prog" sig "( -- name:Block )" desc "The program as invoked, i.e. `0 argv`."
tool "args" name "arg_or" sig "( index:Int default:Block -- arg:Block )" desc "The argument at a C index, or default when there is none; removes the ok flag from the call site."
tool "args" name "arg_tail" sig "( -- args:Block )" desc "Every argument except the program name, in order, as a Block of Blocks."
tool "args" name "arg_find" sig "( name:Block -- index:Int found:Int )" desc "C index of the first argument equal to name, searching from 1; found=0 when absent."
tool "args" name "arg_flag" sig "( name:Block -- found:Int )" desc "1 when the flag appears among the arguments, else 0."
tool "args" name "arg_value_or" sig "( name:Block default:Block -- value:Block )" desc "The argument after the flag; default when the flag is absent or last."
tool "args" name "arg_int_or" sig "( name:Block default:Int -- value:Int )" desc "The argument after the flag as an integer (optional -, digits only); default when absent or not an integer."
tool "args" name "arg_float_or" sig "( name:Block default:Float -- value:Float )" desc "The decimal after flag name ([-]digits[.digits], e.g. -l 0.02), or default when the flag is absent or its value is not a plain decimal."

tool "array" name "arr_size" sig "( shape_block:Block -- total_cells:Int )" desc "Number of cells an array of the given shape holds (the product of the dimensions)."
tool "array" name "arr_make" sig "( shape_block:Block -- ptr:Ptr )" desc "Allocate a zero-filled multi-dimensional array of the given shape, e.g. [ 9 9 ] arr_make."
tool "array" name "arr_offset" sig "( ptr:Ptr coords_block:Block -- flat_offset:Int )" desc "The cell index of the element at the given coordinates (row-major)."
tool "array" name "arr_get" sig "( ptr:Ptr coords_block:Block -- val:Unknown )" desc "Read the element at the given coordinates."
tool "array" name "arr_set" sig "( ptr:Ptr coords_block:Block val:Unknown -- )" desc "Write the element at the given coordinates."
tool "array" name "nth_or_default" sig "( arr:Block idx:Int default:Unknown -- val:Unknown )" desc "Safely indexes array with default fallback."

type "bitread" name "BitIn" base "Ptr"
tool "bitread" name "BitIn_of" sig "( base:Ptr -- value:BitIn )" desc "Generated by `#type BitIn`: makes a BitIn from its base value."
tool "bitread" name "BitIn_raw" sig "( value:BitIn -- base:Ptr )" desc "Generated by `#type BitIn`: the base value of a BitIn."
tool "bitread" name "br_from_bytes" sig "( array:Bytes start:Int count:Int -- br:BitIn )" desc "A bit reader over the count bytes of a from start (the Bytes is not copied)."
tool "bitread" name "br_from_file" sig "( fh:File size:Int -- br:BitIn )" desc "A bit reader over the file fh, which reads size bytes at a time as bits are needed."
tool "bitread" name "br_peek" sig "( br:BitIn count:Int -- bits:Int )" desc "The next count bits (0 to 32) as an Int, least significant first, without consuming them."
tool "bitread" name "br_drop" sig "( br:BitIn count:Int -- )" desc "Consumes count bits; past the end the missing bits read as 0 and br_over becomes 1."
tool "bitread" name "br_get" sig "( br:BitIn count:Int -- bits:Int )" desc "The next count bits (0 to 32) as an Int, consumed: the first bit read is bit 0 (DEFLATE order). Past the end: 0 bits and br_over is 1."
tool "bitread" name "br_align" sig "( br:BitIn -- )" desc "Skips to the next byte boundary."
tool "bitread" name "br_over" sig "( br:BitIn -- flag:Int )" desc "1 when a read went past the end of the source (check it after a header or a block)."
tool "bitread" name "br_at_end" sig "( br:BitIn -- flag:Int )" desc "1 when no bit is left."
tool "bitread" name "br_pos" sig "( br:BitIn -- position:Int )" desc "The whole bytes of the source consumed so far."
tool "bitread" name "br_bytes" sig "( br:BitIn dst:Bytes off:Int count:Int -- got:Int )" desc "From the next byte boundary, up to count bytes into dst at off (a stored block, a trailer); got is less than count at the end of the source."
tool "bitread" name "br_rev" sig "( bits:Int count:Int -- reversed:Int )" desc "The low count bits of bits in reverse order (a Huffman code packed from its top bit)."

tool "bitset" name "bs_add" sig "( set:Int index:Int -- set:Int )" desc "Sets bit index."
tool "bitset" name "bs_test" sig "( set:Int index:Int -- present:Int )" desc "1 if bit index is set, else 0."
tool "bitset" name "bs_union" sig "( left:Int right:Int -- result:Int )" desc "Bitwise OR."
tool "bitset" name "bs_inter" sig "( left:Int right:Int -- result:Int )" desc "Bitwise AND."
tool "bitset" name "bs_minus" sig "( left:Int right:Int -- result:Int )" desc "left with right's bits cleared."
tool "bitset" name "bs_count" sig "( set:Int -- count:Int )" desc "Number of members (set bits) of the set."
tool "bitset" name "bs_first" sig "( set:Int -- index:Int found:Int )" desc "Lowest set bit; found=0 if set is empty."

type "dict" name "Dict" base "Ptr"
tool "dict" name "Dict_of" sig "( base:Ptr -- value:Dict )" desc "Generated by `#type Dict`: makes a Dict from its base value."
tool "dict" name "Dict_raw" sig "( value:Dict -- base:Ptr )" desc "Generated by `#type Dict`: the base value of a Dict."
tool "dict" name "dict_new" sig "( count:Int -- dict:Dict )" desc "A new, empty Dict with room for about count keys before it grows. Keys are integers, strings or other Blocks (a #struct value)."
tool "dict" name "dict_len" sig "( dict:Dict -- length:Int )" desc "The number of keys."
tool "dict" name "dict_cap" sig "( dict:Dict -- capacity:Int )" desc "The number of slots, for visiting them with dict_slot."
tool "dict" name "dict_hash" sig "( key:Unknown -- hash:Int )" desc "The hash of an integer, string or Block key (a Block's elements are hashed in turn); stops the program for a float or a Ptr key."
tool "dict" name "dict_set" sig "( dict:Dict key:Unknown value:Unknown -- )" desc "Stores value at key, replacing any value there."
tool "dict" name "dict_find" sig "( dict:Dict key:Unknown -- value:Unknown found:Int )" desc "The value at key and 1, or 0 0 when key is absent."
tool "dict" name "dict_get" sig "( dict:Dict key:Unknown -- value:Unknown )" desc "The value at key; stops the program when key is absent (use dict_find or dict_get_or when it may be)."
tool "dict" name "dict_get_or" sig "( dict:Dict key:Unknown default:Unknown -- value:Unknown )" desc "The value at key, or default when key is absent."
tool "dict" name "dict_has" sig "( dict:Dict key:Unknown -- flag:Int )" desc "1 when key is a key of the Dict."
tool "dict" name "dict_add" sig "( dict:Dict key:Unknown amount:Int -- )" desc "Adds amount to the number stored at key (0 when absent): counting."
tool "dict" name "dict_del" sig "( dict:Dict key:Unknown -- found:Int )" desc "Removes key; 1 if it was there."
tool "dict" name "dict_slot" sig "( dict:Dict index:Int -- key:Unknown value:Unknown live:Int )" desc "Slot index (0 <= index < dict_cap): its key, value and 1 when it holds one, else 0 0 0. `d dict_cap [times| i | d i dict_slot -> [ k v live ] live when [ ... ] ]`."
tool "dict" name "dict_keys" sig "( dict:Dict -- keys:Block )" desc "Every key as a Block, in slot order (no particular order)."

tool "file" name "f_read" sig "( -- mode:Int )" desc "Open mode for reading (fopen's mode argument)."
tool "file" name "f_write" sig "( -- mode:Int )" desc "Open mode for writing, truncating any existing contents."
tool "file" name "f_append" sig "( -- mode:Int )" desc "Open mode for writing at the end of an existing file."
tool "file" name "f_stdin" sig "( -- fh:File )" desc "The pre-opened standard input handle."
tool "file" name "f_stdout" sig "( -- fh:File )" desc "The pre-opened standard output handle."
tool "file" name "f_stderr" sig "( -- fh:File )" desc "The pre-opened standard error handle."
tool "file" name "f_open_read" sig "( path:Block -- fh:File ok:Int )" desc "Opens a path for reading; ok=0 if it could not be opened."
tool "file" name "f_open_write" sig "( path:Block -- fh:File ok:Int )" desc "Opens a path for writing, truncating it; ok=0 if it could not be opened."
tool "file" name "f_open_append" sig "( path:Block -- fh:File ok:Int )" desc "Opens a path for appending; ok=0 if it could not be opened."
tool "file" name "f_write_line" sig "( fh:File str:Block -- ok:Int )" desc "Writes a whole string followed by a newline; ok=0 if either write fell short."
tool "file" name "f_chunk" sig "( -- size:Int )" desc "Default read chunk size in characters, for a caller driving its own fread loop."
tool "file" name "f_next_chunk" sig "( size:Int -- size:Int )" desc "Chunk growth policy: doubles, capped, so a whole-file read stays linear."
tool "file" name "f_read_all" sig "( fh:File -- str:Block )" desc "Reads to end of input in geometrically growing chunks; one Block slot per character."
tool "file" name "f_read_file" sig "( path:Block -- str:Block ok:Int )" desc "Opens, reads to end, closes; ok=0 (with an empty result) if the open or close failed."
tool "file" name "f_write_file" sig "( path:Block str:Block -- ok:Int )" desc "Opens truncating, writes, closes; ok=0 if any step failed."
tool "file" name "f_append_file" sig "( path:Block str:Block -- ok:Int )" desc "Opens for append, writes, closes; ok=0 if any step failed."
tool "file" name "f_expand_home" sig "( path:Block -- path:Block )" desc "A leading ~/ (or a lone ~) replaced by $HOME; any other path, or an unset HOME, unchanged."

tool "list" name "lst_make" sig "( initial_capacity:Int -- ptr:Ptr )" desc "A new growable list with room for initial_capacity elements before it grows."
tool "list" name "lst_get" sig "( ptr:Ptr idx:Int -- val:Unknown )" desc "The element at index idx (0-based)."
tool "list" name "lst_set" sig "( ptr:Ptr idx:Int val:Unknown -- )" desc "Replace the element at index idx."
tool "list" name "lst_new_cap" sig "( old_cap:Int -- new_cap:Int )" desc "Doubles a capacity (or 1 if 0)."
tool "list" name "lst_grow" sig "( ptr:Ptr -- )" desc "Reallocates the list's backing storage at double capacity, copying existing elements."
tool "list" name "lst_push" sig "( ptr:Ptr val:Unknown -- )" desc "Grows the list (doubling capacity) when full; never silently drops."
tool "list" name "lst_try_push" sig "( ptr:Ptr val:Unknown -- ok:Int )" desc "Does not grow; returns 0 when full instead of pushing."

type "map" name "IntMap" base "Ptr"
tool "map" name "IntMap_of" sig "( base:Ptr -- value:IntMap )" desc "Generated by `#type IntMap`: makes an IntMap from its base value."
tool "map" name "IntMap_raw" sig "( value:IntMap -- base:Ptr )" desc "Generated by `#type IntMap`: the base value of an IntMap."
tool "map" name "map_make" sig "( buckets_size:Int -- table:IntMap )" desc "A new map from Scalar keys to values with buckets_size buckets (one key per bucket; see map_set)."
tool "map" name "map_hash" sig "( key:Int buckets_size:Int -- bucket_idx:Int )" desc "Computes the bucket index for a key."
tool "map" name "map_find" sig "( table:IntMap key:Int -- val:Unknown found:Int )" desc "Looks up a key; found=0 (val=0) rather than a sentinel when absent."
tool "map" name "map_get" sig "( table:IntMap key:Int -- val:Unknown )" desc "Aborts when the key is absent; use map_find if absence is expected."
tool "map" name "map_set" sig "( table:IntMap key:Int val:Unknown -- ok:Int )" desc "ok=0 if the write would clobber a different existing key at that bucket."

tool "memory" name "hclear" sig "( ptr:Ptr start:Int size:Int -- )" desc "Set size cells from start to 0."
tool "memory" name "hloop_fill" sig "( ptr:Ptr start:Int count:Int val:Int -- )" desc "Set the cells start..stop-1 to val."
tool "memory" name "hloop_add" sig "( ptr:Ptr start:Int count:Int val:Int -- )" desc "Add val to each of the cells start..stop-1."
tool "memory" name "h_find_val" sig "( ptr:Ptr size:Int val:Scalar -- index:Int )" desc "Scans sequential heap cells for a target value; returns 0-indexed offset or -1."

tool "numeric" name "vec_dot" sig "( left:Ptr loff:Int right:Ptr roff:Int count:Int -- sum:Float )" desc "The dot product of left[loff..loff+count) and right[roff..roff+count), as a float."
tool "numeric" name "vec_axpy" sig "( dst:Ptr doff:Int src:Ptr soff:Int count:Int scale:Scalar -- )" desc "dst[doff+k] += scale * src[soff+k] for k < count."
tool "numeric" name "vec_add" sig "( src:Ptr soff:Int dst:Ptr doff:Int count:Int -- )" desc "dst[doff+k] += src[soff+k] for k < count."
tool "numeric" name "vec_scale" sig "( ptr:Ptr start:Int count:Int scale:Scalar -- )" desc "ptr[start+k] *= scale for k < count."
tool "numeric" name "vec_sum" sig "( ptr:Ptr start:Int count:Int -- sum:Unknown )" desc "The sum of ptr[start..start+count) (0 for an empty range)."
tool "numeric" name "vec_argmax" sig "( ptr:Ptr start:Int count:Int -- index:Int )" desc "The index (0..count-1) of the first largest value in ptr[start..start+count); an empty range aborts."
tool "numeric" name "vec_max" sig "( ptr:Ptr start:Int count:Int -- largest:Int )" desc "The largest value in ptr[start..start+count); an empty range aborts."
tool "numeric" name "vec_be32" sig "( ptr:Ptr index:Int -- value:Int )" desc "The big-endian signed 32-bit integer in the four byte cells ptr[index..index+4) (after fread_into)."
tool "numeric" name "vec_le32" sig "( ptr:Ptr index:Int -- value:Int )" desc "The little-endian signed 32-bit integer in the four byte cells ptr[index..index+4)."

tool "procinfo" name "proc_line_num" sig "( line:Block start:Int -- value:Int )" desc "The number in a /proc status line from index start on: digits only, other characters skipped."
tool "procinfo" name "proc_status_kb" sig "( key:Block -- kb:Int ok:Int )" desc "The value of a /proc/self/status field such as \"VmRSS:\" (kB); ok=0 when absent."
tool "procinfo" name "proc_peak_kb" sig "( -- kb:Int )" desc "Peak resident memory so far (VmHWM) in kB: the figure to report, not VmPeak."
tool "procinfo" name "proc_rss_kb" sig "( -- kb:Int )" desc "Resident memory now (VmRSS) in kB."

tool "record" name "rec_make" sig "( size:Int -- ptr:Ptr )" desc "Allocate a record of size cells (all 0); fields are addressed by offset."
tool "record" name "rec_get" sig "( ptr:Ptr field_offset:Int -- val:Unknown )" desc "Read the field at field_offset."
tool "record" name "rec_set" sig "( ptr:Ptr field_offset:Int val:Unknown -- )" desc "Write the field at field_offset."

type "strings" name "StrBuf" base "Ptr"
tool "strings" name "StrBuf_of" sig "( base:Ptr -- value:StrBuf )" desc "Generated by `#type StrBuf`: makes a StrBuf from its base value."
tool "strings" name "StrBuf_raw" sig "( value:StrBuf -- base:Ptr )" desc "Generated by `#type StrBuf`: the base value of a StrBuf."
tool "strings" name "str_print" sig "( str:Block -- )" desc "Prints a string (block of ASCII codes) to stdout."
tool "strings" name "is_digit" sig "( ch:Int -- flag:Int )" desc "1 if char code is 0-9, else 0."
tool "strings" name "is_space" sig "( ch:Int -- flag:Int )" desc "1 if char code is space/tab/newline/CR, else 0."
tool "strings" name "is_upper" sig "( ch:Int -- flag:Int )" desc "1 if char code is A-Z, else 0."
tool "strings" name "is_lower" sig "( ch:Int -- flag:Int )" desc "1 if char code is a-z, else 0."
tool "strings" name "int_to_str" sig "( value:Int -- str:Block )" desc "Converts a signed integer to its digit-character block."
tool "strings" name "int_to_str_pad" sig "( value:Int width:Int -- str:Block )" desc "Decimal string zero-padded to width characters, the sign counted: -5 3 is -05."
tool "strings" name "print_fixed" sig "( value:Int decimals:Int -- )" desc "Print an integer as fixed point with decimals digits after the point: 12345 3 is 12.345."
tool "strings" name "print_line" sig "( value:Int -- )" desc "Prints an integer followed by a newline."
tool "strings" name "str_to_int" sig "( chars:Block start:Int count:Int -- value:Int ok:Int )" desc "Multi-digit signed parse of [start,end); ok=0 if not entirely digits (plus an optional leading '-')."
tool "strings" name "fs_matches_at" sig "( hay:Block needle:Block index:Int nlen:Int -- match:Int )" desc "1 if needle occurs in hay starting exactly at index."
tool "strings" name "find_sub" sig "( hay:Block needle:Block start:Int -- pos:Int found:Int )" desc "First index >= from where needle occurs in hay; found=0 if absent."
tool "strings" name "strbuf_new" sig "( cap:Int -- buf:StrBuf )" desc "A string builder with room for cap characters; it grows by doubling."
tool "strings" name "strbuf_len" sig "( buf:StrBuf -- length:Int )" desc "The number of characters in the builder."
tool "strings" name "strbuf_add_char" sig "( buf:StrBuf ch:Int -- )" desc "Append one character code (0..255)."
tool "strings" name "strbuf_add" sig "( buf:StrBuf str:Block -- )" desc "Append a string (a Block of character codes)."
tool "strings" name "strbuf_add_int" sig "( buf:StrBuf value:Int -- )" desc "Append an integer in decimal."
tool "strings" name "strbuf_add_float" sig "( buf:StrBuf number:Scalar decimals:Int -- )" desc "Append a number with the given decimals (as float_to_str)."
tool "strings" name "strbuf_to_str" sig "( buf:StrBuf -- str:Block )" desc "The builder's text as a Block."
tool "strings" name "strbuf_write" sig "( fh:File buf:StrBuf -- written:Int )" desc "Write the builder's text to fh in one call; returns how many bytes were written."
tool "strings" name "strbuf_clear" sig "( buf:StrBuf -- )" desc "Empty the builder, keeping its storage."
tool "strings" name "str_pad_left" sig "( str:Block width:Int -- padded:Block )" desc "str padded on the left with spaces to width (unchanged if already as wide)."
tool "strings" name "str_pad_right" sig "( str:Block width:Int -- padded:Block )" desc "str padded on the right with spaces to width (unchanged if already as wide)."
tool "strings" name "int_to_hex" sig "( value:Int -- str:Block )" desc "An integer in lowercase hexadecimal; a negative one as its 64-bit pattern."
tool "strings" name "str_split" sig "( str:Block ch:Int -- parts:Block )" desc "The pieces of str between the separator ch, in order, empty ones included."

tool "util" name "reverse" sig "( block:Block -- reversed:Block )" desc "Reverses an immutable block."
tool "util" name "sum" sig "( block:Block -- total:Unknown )" desc "Sums scalar elements."
tool "util" name "contains" sig "( block:Block target:Scalar -- flag:Int )" desc "1 if target present, else 0."
tool "util" name "filter_eq" sig "( block:Block target:Int -- filtered:Block )" desc "Keeps elements equal to target (order preserved)."
tool "util" name "index_of" sig "( block:Block target:Scalar -- idx:Int )" desc "First index equal to target, or -1."
tool "util" name "concat" sig "( b1:Block b2:Block -- joined:Block )" desc "Concatenates two blocks; empty-safe."
tool "util" name "block_eq" sig "( b1:Block b2:Block -- equal:Int )" desc "Checks element-by-element equality of two blocks."
tool "util" name "insert_sorted" sig "( val:Unknown blk:Block -- result:Block )" desc "Inserts a value into an already-sorted block, preserving order."
tool "util" name "block_sort" sig "( blk:Block -- sorted:Block )" desc "Performs stable sorting on a block."
tool "util" name "assert" sig "( ok:Int msg:Block -- )" desc "Stop the program with msg (via abort) unless ok is nonzero."
tool "util" name "expect" sig "( ok:Int msg:Block -- ok:Int )" desc "For #test_ words: ok passes through; when it is 0, prints `  expected: msg`."
tool "util" name "expect_stop" sig "( msg:Block -- )" desc "The first thing in a #test_ word whose code must stop the program: --test runs that test alone and passes it when the program stops with msg in its error output."
tool "util" name "expect_eq" sig "( got:Unknown want:Unknown msg:Block -- ok:Int )" desc "For #test_ words: got = want (any values, as `=`); when not, prints msg with both values."
tool "util" name "expect_near" sig "( got:Scalar want:Scalar tol:Scalar msg:Block -- ok:Int )" desc "For #test_ words: |got - want| <= tol; when not, prints msg, both values and tol."

type "vec" name "Vec" base "Ptr"
tool "vec" name "Vec_of" sig "( base:Ptr -- value:Vec )" desc "Generated by `#type Vec`: makes a Vec from its base value."
tool "vec" name "Vec_raw" sig "( value:Vec -- base:Ptr )" desc "Generated by `#type Vec`: the base value of a Vec."
tool "vec" name "vec_new" sig "( cap:Int -- vec:Vec )" desc "A new, empty Vec with room for cap values before it grows."
tool "vec" name "vec_len" sig "( vec:Vec -- length:Int )" desc "The number of values."
tool "vec" name "vec_cap" sig "( vec:Vec -- capacity:Int )" desc "How many values fit before the Vec grows."
tool "vec" name "vec_data" sig "( vec:Vec -- ptr:Ptr )" desc "The cells holding the values (0 .. vec_len - 1), for hsort, hmove and the numeric lexicon; a push may move them, so get it again after one."
tool "vec" name "vec_reserve" sig "( vec:Vec count:Int -- )" desc "Room for at least count values; the Vec keeps its cells' slot (hresize), so it may grow inside a region."
tool "vec" name "vec_push" sig "( vec:Vec value:Unknown -- )" desc "Appends value, growing the Vec when full (amortized O(1)) in place, so a Vec made before a region may grow inside it."
tool "vec" name "vec_get" sig "( vec:Vec index:Int -- value:Unknown )" desc "The value at index; stops the program when index is outside 0 .. vec_len - 1."
tool "vec" name "vec_set" sig "( vec:Vec index:Int value:Unknown -- )" desc "Replaces the value at index; stops the program when index is outside 0 .. vec_len - 1."
tool "vec" name "vec_last" sig "( vec:Vec -- value:Unknown )" desc "The last value; stops the program when the Vec is empty."
tool "vec" name "vec_pop" sig "( vec:Vec -- value:Unknown )" desc "Removes and returns the last value; stops the program when the Vec is empty."
tool "vec" name "vec_clear" sig "( vec:Vec -- )" desc "Empties the Vec, keeping its capacity."
tool "vec" name "vec_from_block" sig "( block:Block -- vec:Vec )" desc "A Vec holding the elements of block, in order."
tool "vec" name "vec_to_block" sig "( vec:Vec -- block:Block )" desc "The values as a Block, in order."
tool "vec" name "vec_sort" sig "( vec:Vec -- )" desc "Sorts the values ascending as hsort orders them (numbers by value, strings and rows element by element), stably. A Ptr value (a Vec, a Dict, hnull) stops the program: sort rows as Blocks or #struct values, and turn a NULL into a number first."
tool "vec" name "sort_by" sig "( p:Ptr off:Int n:Int less:Word(Unknown,Unknown--Int) -- )" desc "Sorts the n cells of p from off, stably, in the order of the word passed: less ( a b -- f ) is nonzero when a must come before b. `p 0 n 'by_age sort_by`."
tool "vec" name "vec_sort_by" sig "( v:Vec less:Word(Unknown,Unknown--Int) -- )" desc "Sorts the Vec as sort_by does: `v 'by_age vec_sort_by`."

{ ---- Primitives: built into the compiler, no `use` needed. Not loaded by the compiler; checked against it by tools/build_manifest.py ---- }

prim name "dup" sig "( value:Unknown -- value:Unknown value:Unknown )" desc "Copy the top value."
prim name "drop" sig "( value:Unknown -- )" desc "Discard the top value."
prim name "swap" sig "( first:Unknown second:Unknown -- second:Unknown first:Unknown )" desc "Exchange the top two values."
prim name "rot" sig "( first:Unknown second:Unknown third:Unknown -- second:Unknown third:Unknown first:Unknown )" desc "Rotate the third value to the top."
prim name "over" sig "( first:Unknown second:Unknown -- first:Unknown second:Unknown first:Unknown )" desc "Copy the second value to the top."
prim name "cons" sig "( block:Block value:Unknown -- result:Block )" desc "Prepend value to a Block (the Block first, as every word that adds to something)."
prim name "pair" sig "( first:Unknown second:Unknown -- block:Block )" desc "The two-slot Block [ first second ]."
prim name "block_len" sig "( block:Unknown -- length:Int )" desc "Slot count of a Block (its length; a string's number of characters). Named `len` before v1.91."
prim name "block_slice" sig "( block:Block start:Int count:Int -- slice:Block )" desc "The count elements from start as a new Block; the range clamps to the Block, and a count <= 0 gives nil."
prim name "at" sig "( block:Block index:Int -- value:Unknown )" desc "Integer-indexed read of a homogeneous Block (spec Sec.4 _at)."
prim name "array_at" sig "( block:Block index:Int -- value:Unknown )" desc "Spelling of `at` for arrays."
prim name "arr_at" sig "( block:Block index:Int -- value:Unknown )" desc "Spelling of `at` for arrays."
prim name "list_at" sig "( block:Block index:Int -- value:Unknown )" desc "Spelling of `at` for lists."
prim name "block_at" sig "( block:Block index:Int -- value:Unknown )" desc "Spelling of `at` for Blocks."
prim name "block_get" sig "( block:Block index:Int -- value:Unknown )" desc "Static-slot read (spec Sec.4 _get)."
prim name "array_get" sig "( block:Block index:Int -- value:Unknown )" desc "Spelling of `_get` for arrays."
prim name "list_get" sig "( block:Block index:Int -- value:Unknown )" desc "Spelling of `_get` for lists."
prim name "record_get" sig "( record:Block index:Int -- value:Unknown )" desc "Spelling of `_get` for records."
prim name "block_set" sig "( block:Block index:Int value:Unknown -- result:Block )" desc "Functional update: a copy with slot index replaced; same type only (spec Sec.4 _set)."
prim name "array_set" sig "( block:Block index:Int value:Unknown -- result:Block )" desc "Spelling of `_set` for arrays."
prim name "list_set" sig "( block:Block index:Int value:Unknown -- result:Block )" desc "Spelling of `_set` for lists."
prim name "record_set" sig "( record:Block index:Int value:Unknown -- result:Block )" desc "Spelling of `_set` for records."
prim name "hnew" sig "( size:Int -- ptr:Ptr )" desc "Allocate size heap cells (spec Sec.5)."
prim name "hread" sig "( ptr:Ptr index:Int -- value:Unknown )" desc "Read heap cell index. Untyped: wrap it in a word whose signature states the real type."
prim name "until" sig "( flag:Int -- )" desc "Only as `until [ c ]`, the first thing in a times/for body: the loop ends when c is true; the stack keeps the loop's shape."
prim name "while" sig "( flag:Int -- )" desc "Only as `while [ c ]`, the first thing in a times/for body: the loop ends when c is false."
prim name "hwrite" sig "( ptr:Ptr index:Int value:Unknown -- )" desc "Write value into heap cell index (the cell first, the value last)."
prim name "hmark" sig "( -- mark:Int )" desc "Mark the heap arena (spec Sec.5)."
prim name "hrelease" sig "( mark:Int -- )" desc "Release every heap cell allocated since mark."
prim name "hsort" sig "( ptr:Ptr start:Int count:Int -- )" desc "Sort heap cells [start, start+count) ascending, in place, stably: numbers by value, Blocks (strings, rows, #struct values) element by element. A cell holding a Ptr (a Vec, a Dict, hnull) is a fatal error."
prim name "+" sig "( left:Scalar right:Scalar -- result:Scalar )" desc "Add two numbers of one kind (Int and Int, or Float and Float), giving that kind; an Int with a Float is a TypeError."
prim name "-" sig "( left:Scalar right:Scalar -- result:Scalar )" desc "Subtract right from left: two numbers of one kind, giving that kind."
prim name "*" sig "( left:Scalar right:Scalar -- result:Scalar )" desc "Multiply: two numbers of one kind, giving that kind."
prim name "/" sig "( left:Scalar right:Scalar -- result:Scalar )" desc "Divide left by right, two numbers of one kind: two Ints give an Int, rounded down (floor) as the remainder is, so left = right*(left/right) + the remainder for every sign; two Floats give a Float."
prim name "\\" sig "( left:Int right:Int -- result:Int )" desc "Floored remainder of left divided by right: the sign of the divisor."
prim name "abs" sig "( number:Scalar -- result:Scalar )" desc "Absolute value, of the same kind."
prim name "exp" sig "( number:Scalar -- result:Float )" desc "e to the power number, as a float."
prim name "log" sig "( number:Scalar -- result:Float )" desc "Natural logarithm, as a float (0 gives -inf, a negative number nan)."
prim name "sqrt" sig "( number:Scalar -- result:Float )" desc "Square root, as a float (a negative number gives nan)."
prim name "pow" sig "( base:Scalar exponent:Scalar -- result:Float )" desc "base to the power exponent, as a float."
prim name "floor" sig "( number:Scalar -- result:Int )" desc "The largest integer not above number (an integer passes through; NaN, infinity and out-of-range floats are fatal)."
prim name "seed" sig "( value:Int -- )" desc "Restart rand's sequence from the integer value (the default is 0 seed)."
prim name "rand" sig "( -- number:Float )" desc "A pseudo-random float, uniform on [0, 1)."
prim name "min" sig "( left:Scalar right:Scalar -- result:Scalar )" desc "Smaller of two numbers of one kind."
prim name "max" sig "( left:Scalar right:Scalar -- result:Scalar )" desc "Larger of two numbers of one kind."
prim name "to_float" sig "( number:Scalar -- result:Float )" desc "The number as a Float (an Int is converted)."
prim name "=" sig "( left:Unknown right:Unknown -- flag:Int )" desc "1 if equal, else 0."
prim name "!=" sig "( left:Unknown right:Unknown -- flag:Int )" desc "1 if not equal, else 0."
prim name ">" sig "( left:Scalar right:Scalar -- flag:Int )" desc "1 if left > right, else 0; two numbers of one kind. For Blocks (strings), use sort_cmp."
prim name "<" sig "( left:Scalar right:Scalar -- flag:Int )" desc "1 if left < right, else 0. For Blocks (strings), use sort_cmp."
prim name ">=" sig "( left:Scalar right:Scalar -- flag:Int )" desc "1 if left >= right, else 0 (numbers only)."
prim name "<=" sig "( left:Scalar right:Scalar -- flag:Int )" desc "1 if left <= right, else 0 (numbers only)."
prim name "and" sig "( left:Int right:Int -- flag:Int )" desc "Logical and. Eager: both operands are always evaluated."
prim name "or" sig "( left:Int right:Int -- flag:Int )" desc "Logical or. Eager: both operands are always evaluated."
prim name "not" sig "( flag:Int -- result:Int )" desc "LOGICAL not: 1 if flag is 0, else 0. For the bitwise complement use bitnot."
prim name "select" sig "( if_true:Unknown if_false:Unknown flag:Int -- value:Unknown )" desc "if_true if flag is nonzero, else if_false. Both are always evaluated."
prim name "bitand" sig "( left:Int right:Int -- result:Int )" desc "Bitwise and (integers only)."
prim name "bitor" sig "( left:Int right:Int -- result:Int )" desc "Bitwise or (integers only)."
prim name "bitxor" sig "( left:Int right:Int -- result:Int )" desc "Bitwise xor (integers only)."
prim name "bitshl" sig "( value:Int shift:Int -- result:Int )" desc "value shifted left by shift bits: `1 k bitshl` is 2 to the power k."
prim name "bitshr" sig "( value:Int shift:Int -- result:Int )" desc "value shifted right by shift bits."
prim name "bitnot" sig "( value:Int -- result:Int )" desc "BITWISE complement: 6 bitnot is -7. A 9-bit mask complement is `bitnot 511 bitand`."
prim name "bitcount" sig "( value:Int -- count:Int )" desc "Number of set bits of the 64-bit pattern (-1 bitcount is 64)."
prim name "bitctz" sig "( value:Int -- count:Int )" desc "Trailing zero bits: the index of the lowest set bit; 64 for 0."
prim name "bitclz" sig "( value:Int -- count:Int )" desc "Leading zero bits of the 64-bit pattern; 64 for 0."
prim name "print_char" sig "( ch:Int -- )" desc "Write one character code to stdout."
prim name "print_int" sig "( value:Int -- )" desc "Write an integer to stdout (a float is fatal: to_int or floor it, or use print_float)."
prim name "print_float" sig "( number:Scalar decimals:Int -- )" desc "Write a number with the given number of decimals (0-17), formatted as printf %.*f."
prim name "abort" sig "( msg:Block -- )" desc "Print `ABORT: ` and msg to stderr and exit with status 1. Never returns; an aborting cond branch is exempt from branch matching."
prim name "fopen" sig "( path:Block mode:Int -- fh:File ok:Int )" desc "Open a file (spec Sec.12)."
prim name "fclose" sig "( fh:File -- ok:Int )" desc "Close a file."
prim name "fgetc" sig "( fh:File -- ch:Int ok:Int )" desc "Read one character; ok=0 at end of file."
prim name "fputc" sig "( fh:File ch:Int -- ok:Int )" desc "Write one character."
prim name "fread" sig "( fh:File count:Int -- str:Block )" desc "Read up to count characters."
prim name "fwrite" sig "( fh:File str:Block -- written:Int )" desc "Write a Block of characters; returns the count written."
prim name "freadline_into" sig "( fh:File array:Bytes -- length:Int )" desc "The next line into array from index 0, newline consumed and not stored: its length, or -1 at the end of input. No Block per line; a line longer than array is fatal."
prim name "str_to_float" sig "( chars:Block start:Int count:Int -- number:Float ok:Int )" desc "The decimal number in chars[start, start+count) (digits, sign, point, exponent; nothing else) as a float and 1, or 0.0 and 0."
prim name "freadline" sig "( fh:File -- line:Block got:Int )" desc "Read the next line in one pass, newline consumed; got=0 only at end of input with nothing read."
prim name "fread_into" sig "( fh:File ptr:Ptr start:Int count:Int -- got:Int )" desc "Read up to count bytes into heap cells from start, as integers; returns how many."
prim name "fwrite_from" sig "( fh:File ptr:Ptr start:Int count:Int -- written:Int )" desc "Write the cells ptr[start..start+count) as bytes (each 0-255) in one call; returns how many."
prim name "fflush" sig "( fh:File -- ok:Int )" desc "Write out what is buffered for fh now (redirected stdout is block-buffered)."
prim name "to_str" sig "( value:Unknown -- str:Block )" desc "Any value as text, as trace writes it but whole: 42, 2.5, 3.0, [ 1 [ 2 3 ] ], a string with its text as a comment, [ 104 105 ] { \"hi\" }."
prim name "bytes_new" sig "( count:Int -- array:Bytes )" desc "A new Bytes array of count bytes, all 0: one byte per element (a Ptr's cells take 16)."
prim name "bytes_len" sig "( array:Bytes -- length:Int )" desc "The number of elements."
prim name "bytes_get" sig "( array:Bytes index:Int -- value:Int )" desc "Element index (0 <= index < length) as an integer 0..255."
prim name "bytes_set" sig "( array:Bytes index:Int value:Int -- )" desc "Stores value, an integer 0..255, at index; any other value stops the program."
prim name "bytes_fill" sig "( array:Bytes start:Int count:Int value:Int -- )" desc "Stores the byte value in count elements from start."
prim name "bytes_move" sig "( src:Bytes soff:Int dst:Bytes doff:Int count:Int -- )" desc "Copies count elements from src at soff to dst at doff (overlap-safe)."
prim name "bytes_resize" sig "( array:Bytes count:Int -- )" desc "Gives the array count elements, keeping its slot (a region begun after it was made does not release it); new elements are 0."
prim name "ints_new" sig "( count:Int -- array:Ints )" desc "A new Ints array of count 64-bit integers, all 0 (8 bytes each)."
prim name "ints_len" sig "( array:Ints -- length:Int )" desc "The number of elements."
prim name "ints_get" sig "( array:Ints index:Int -- value:Int )" desc "Element index (0 <= index < length)."
prim name "ints_set" sig "( array:Ints index:Int value:Int -- )" desc "Stores the integer value at index; a float stops the program."
prim name "ints_fill" sig "( array:Ints start:Int count:Int value:Int -- )" desc "Stores value in count elements from start."
prim name "ints_move" sig "( src:Ints soff:Int dst:Ints doff:Int count:Int -- )" desc "Copies count elements from src at soff to dst at doff (overlap-safe)."
prim name "ints_resize" sig "( array:Ints count:Int -- )" desc "Gives the array count elements, keeping its slot; new elements are 0."
prim name "floats_new" sig "( count:Int -- array:Floats )" desc "A new Floats array of count 64-bit floats, all 0.0 (8 bytes each)."
prim name "floats_len" sig "( array:Floats -- length:Int )" desc "The number of elements."
prim name "floats_get" sig "( array:Floats index:Int -- value:Float )" desc "Element index (0 <= index < length), a float."
prim name "floats_set" sig "( array:Floats index:Int value:Scalar -- )" desc "Stores the number value (an integer is converted) at index."
prim name "floats_fill" sig "( array:Floats start:Int count:Int value:Scalar -- )" desc "Stores value in count elements from start."
prim name "floats_move" sig "( src:Floats soff:Int dst:Floats doff:Int count:Int -- )" desc "Copies count elements from src at soff to dst at doff (overlap-safe)."
prim name "floats_resize" sig "( array:Floats count:Int -- )" desc "Gives the array count elements, keeping its slot; new elements are 0."
prim name "bytes_read" sig "( fh:File array:Bytes start:Int count:Int -- got:Int )" desc "Reads up to count bytes from fh into array from start; got is how many (0 at the end of input)."
prim name "bytes_write" sig "( fh:File array:Bytes start:Int count:Int -- written:Int )" desc "Writes count bytes of array from start to fh; written < count means the write failed part way."
prim name "bytes_to_block" sig "( array:Bytes start:Int count:Int -- str:Block )" desc "count bytes of array from start as a Block (a string)."
prim name "bytes_from_block" sig "( str:Block -- array:Bytes )" desc "A Bytes array holding the Block's elements, each an integer 0..255 (a string)."
prim name "ints_sort" sig "( array:Ints start:Int count:Int -- )" desc "Sorts count elements from start ascending, in place."
prim name "floats_sort" sig "( array:Floats start:Int count:Int -- )" desc "Sorts count elements from start ascending, in place."
prim name "floats_dot" sig "( left:Floats loff:Int right:Floats roff:Int count:Int -- sum:Float )" desc "The dot product of left[loff..loff+count) and right[roff..roff+count), in C (vectorised); four partial sums, so the rounding can differ in the last bits from a loop's, the same on every run."
prim name "floats_axpy" sig "( dst:Floats doff:Int src:Floats soff:Int count:Int scale:Scalar -- )" desc "dst[doff+k] += scale * src[soff+k] for k < count, in C (vectorised)."
prim name "floats_add" sig "( dst:Floats doff:Int src:Floats soff:Int count:Int -- )" desc "dst[doff+k] += src[soff+k] for k < count."
prim name "floats_mul" sig "( dst:Floats doff:Int src:Floats soff:Int count:Int -- )" desc "dst[doff+k] *= src[soff+k] for k < count (element by element)."
prim name "floats_scale" sig "( array:Floats start:Int count:Int scale:Scalar -- )" desc "array[start+k] *= scale for k < count."
prim name "floats_sum" sig "( array:Floats start:Int count:Int -- sum:Float )" desc "The sum of array[start..start+count), in C (four partial sums)."
prim name "floats_max" sig "( array:Floats start:Int count:Int -- largest:Float )" desc "The largest of array[start..start+count); an empty range stops the program."
prim name "floats_argmax" sig "( array:Floats start:Int count:Int -- index:Int )" desc "The index (0..count-1) of the first largest of array[start..start+count); an empty range stops the program."
prim name "floats_from_bytes" sig "( dst:Floats doff:Int src:Bytes soff:Int count:Int scale:Scalar -- )" desc "dst[doff+k] = src[soff+k] * scale for k < count: bytes (pixels) to floats in one pass."
prim name "ints_sum" sig "( array:Ints start:Int count:Int -- sum:Int )" desc "The sum of array[start..start+count)."
prim name "ints_max" sig "( array:Ints start:Int count:Int -- largest:Int )" desc "The largest of array[start..start+count); an empty range stops the program."
prim name "ints_argmax" sig "( array:Ints start:Int count:Int -- index:Int )" desc "The index (0..count-1) of the first largest of array[start..start+count); an empty range stops the program."
prim name "bytes_be32" sig "( array:Bytes index:Int -- value:Int )" desc "The unsigned 32-bit big-endian integer in array[index..index+4), 0 .. 4294967295 (IDX and network headers)."
prim name "bytes_le32" sig "( array:Bytes index:Int -- value:Int )" desc "The unsigned 32-bit little-endian integer in array[index..index+4), 0 .. 4294967295."
prim name "bytes_be16" sig "( array:Bytes index:Int -- value:Int )" desc "The unsigned 16-bit big-endian integer in array[index..index+2)."
prim name "bytes_le16" sig "( array:Bytes index:Int -- value:Int )" desc "The unsigned 16-bit little-endian integer in array[index..index+2)."
prim name "fseek" sig "( fh:File pos:Int -- ok:Int )" desc "Move to an absolute byte offset; ok=0 when the stream cannot seek."
prim name "ftell" sig "( fh:File -- pos:Int )" desc "Current byte offset; -1 when the stream has none (a pipe)."
prim name "argc" sig "( -- count:Int )" desc "Command-line argument count, program name included (spec Sec.13)."
prim name "argv" sig "( index:Int -- arg:Block ok:Int )" desc "Argument index, C indexing (0 is the program); ok=0 when out of range."
prim name "getenv" sig "( name:Block -- value:Block ok:Int )" desc "Environment variable, read-only; ok=0 and an empty Block when unset, ok=1 (value possibly empty) when set."
prim name "sort_cmp" sig "( left:Unknown right:Unknown -- order:Int )" desc "-1, 0 or 1 as hsort orders left and right: numbers by value, Blocks element by element (strings in byte order), numbers before Blocks."
prim name "hmove" sig "( src:Ptr soff:Int dst:Ptr doff:Int count:Int -- )" desc "Copy count heap cells from src to dst; overlapping ranges are safe."
prim name "hfill" sig "( ptr:Ptr start:Int count:Int value:Unknown -- )" desc "Store value in every heap cell of the range."
prim name "hresize" sig "( ptr:Ptr count:Int -- )" desc "Gives the allocation count cells, keeping its slot: every Ptr to it stays valid, also inside a region begun after it was made; new cells hold 0."
prim name "trace" sig "( value:Unknown -- )" desc "Print the value (any type) and the trace's source line to stderr, for debugging."
prim name "exit" sig "( code:Int -- )" desc "End the program with exit status code (0-255), flushing stdout. Never returns."
prim name "to_int" sig "( number:Scalar -- result:Int )" desc "An integer as is; a float truncated toward zero. NaN, infinity and out-of-range floats are fatal."
prim name "float_to_str" sig "( number:Scalar decimals:Int -- str:Block )" desc "The text print_float prints (printf %.*f, 0-17 decimals), as a Block of character codes."
prim name "type_of" sig "( value:Unknown -- kind:Int )" desc "The value's runtime type: 0 integer, 1 float, 2 Block, 3 Ptr (a File handle is an integer)."
prim name "hnull" sig "( -- ptr:Ptr )" desc "A Ptr that refers to nothing; equal only to another hnull; hread/hwrite through it are fatal."
prim name "clock_ns" sig "( -- ns:Int )" desc "Nanoseconds from a monotonic clock; only differences between readings mean anything."
