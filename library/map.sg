{ ---- Encapsulated Key-Value Hash Map Lexicon ---- }
{ ---- ptr is a 2-cell header: [0]=buckets_size, [1]=data_ptr (the actual  ---- }
{ ---- buckets_size*2 bucket storage). map_get/map_set can't recover      ---- }
{ ---- buckets_size via `len` on ptr -- ptr is a Ptr, not a Block, and    ---- }
{ ---- len only operates on Blocks -- so the bucket count is stored      ---- }
{ ---- explicitly here instead, matching list.sg's lst_make header.      ---- }

{ ---- v1.67: a map is an IntMap, its own type: a map passed where a   ---- }
{ ---- list or a plain Ptr is expected (or the reverse) is a TypeError. ---- }
#type IntMap Ptr end

#map_make ( buckets_size:Int -- table:IntMap )
  buckets_size 2 * hnew -> [ data_ptr ]
    2 hnew -> [ hdr ]
      hdr 0 buckets_size hwrite
      hdr 1 data_ptr hwrite
      hdr IntMap_of
end

#map_hash ( key:Int buckets_size:Int -- bucket_idx:Int )
  \ 2 *
end

#map_find ( table:IntMap key:Int -- val:Unknown found:Int )
  table IntMap_raw 1 hread
  key
  key table IntMap_raw 0 hread map_hash
  -> [ data_ptr key bucket_idx ]
    data_ptr bucket_idx hread key =
    cond [
      data_ptr bucket_idx 1 + hread
      1
    ] else [
      0
      0
    ] ?
end

#map_get ( table:IntMap key:Int -- val:Unknown )
  table IntMap_raw 1 hread
  key
  key table IntMap_raw 0 hread map_hash
  -> [ data_ptr key bucket_idx ]
    data_ptr bucket_idx hread key =
    cond [
      data_ptr bucket_idx 1 + hread
    ] else [
      [ 75 101 121 32 110 111 116 32 102 111 117 110 100 ] abort
    ] ?
end

{ map_set returns ok=0 rather than silently overwriting when the bucket }
{ already holds a DIFFERENT key: this map is direct-mapped (buckets_size }
{ fixed slots, no chaining/probing per map_hash), so a write that clobbers }
{ an unrelated existing key is the closest analogue this structure has to }
{ "the table is full" -- the alternative (silently overwriting) would }
{ corrupt the other key's entry with no signal to the caller. }
#map_set ( table:IntMap key:Int val:Unknown -- ok:Int )
  val
  table IntMap_raw 1 hread
  key
  key table IntMap_raw 0 hread map_hash
  -> [ val data_ptr key bucket_idx ]
    val
    data_ptr
    key
    bucket_idx
    data_ptr bucket_idx hread
  -> [ val data_ptr key bucket_idx existing_key ]
    existing_key key = existing_key 0 = or
  cond [
    data_ptr bucket_idx key hwrite
    data_ptr bucket_idx 1 + val hwrite
    1
  ] else [ 0 ] ?
end
