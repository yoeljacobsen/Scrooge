{ ---- Encapsulated Key-Value Hash Map Lexicon ---- }

#map_make ( buckets_size:Scalar -- ptr:Ptr )
  -> [ buckets_size ] [ buckets_size 2 * hnew ]
end

#map_hash ( key:Scalar buckets_size:Scalar -- bucket_idx:Scalar )
  \ 2 *
end

#map_get ( ptr:Ptr key:Scalar -- val:Unknown )
  -> [ ptr key ] [
    ptr
    key
    key ptr len 2 / map_hash
  ]
  -> [ ptr key bucket_idx ] [
    ptr bucket_idx hread key =
    cond [ ptr bucket_idx 1 + hread ] else [ -1 ] ?
  ]
end

#map_set ( val:Unknown ptr:Ptr key:Scalar -- )
  -> [ val ptr key ] [
    val
    ptr
    key
    key ptr len 2 / map_hash
  ]
  -> [ val ptr key bucket_idx ] [
    key ptr bucket_idx hwrite
    val ptr bucket_idx 1 + hwrite
  ]
end
