{ ---- vec: a growable vector of values, and sorting with your own order. ---- }
{ ---- A Vec is its own type (a handle on the heap), so a Vec passed where ---- }
{ ---- a Ptr or a map is expected, or the reverse, is a TypeError. Every  ---- }
{ ---- word takes the Vec first. Indexes are checked: an index outside    ---- }
{ ---- 0 <= i < vec_len stops the program with the word's name.          ---- }
{ ---- Header cells: 0 the length, 1 the capacity, 2 the data Ptr.        ---- }
#type Vec Ptr end

{ a new, empty Vec with room for cap values before it grows }
#vec_new ( cap:Int -- vec:Vec )
  3 hnew -> [ h ]
  h 0 0 hwrite
  h 1 cap 1 max hwrite
  h 2 cap 1 max hnew hwrite
  h Vec_of
end

#vec_len ( vec:Vec -- length:Int ) vec Vec_raw 0 hread end
#vec_cap ( vec:Vec -- capacity:Int ) vec Vec_raw 1 hread end

{ the cells holding the values, at 0 .. vec_len - 1, for the heap words  }
{ (hsort, hmove, the numeric lexicon); the Ptr stays the same when the  }
{ Vec grows (hresize, since v1.95), so a Vec made before a region can    }
{ grow inside it }
#vec_data ( vec:Vec -- ptr:Ptr ) vec Vec_raw 2 hread end

{ room for at least n values }
#vec_reserve ( vec:Vec count:Int -- )
  vec vec_cap count < when [
    vec vec_cap 2 * count max -> [ c ]
    vec vec_data c hresize
    vec Vec_raw 1 c hwrite
  ]
end

#vec_push ( vec:Vec value:Unknown -- )
  vec vec vec_len 1 + vec_reserve
  vec vec_data vec vec_len value hwrite
  vec Vec_raw 0 vec vec_len 1 + hwrite
end

#vec_get ( vec:Vec index:Int -- value:Unknown )
  index 0 < index vec vec_len < not or when [ "vec_get: the index is outside 0 .. vec_len - 1" abort ]
  vec vec_data index hread
end

#vec_set ( vec:Vec index:Int value:Unknown -- )
  index 0 < index vec vec_len < not or when [ "vec_set: the index is outside 0 .. vec_len - 1" abort ]
  vec vec_data index value hwrite
end

#vec_last ( vec:Vec -- value:Unknown )
  vec vec_len 0 = when [ "vec_last: the Vec is empty" abort ]
  vec vec_data vec vec_len 1 - hread
end

#vec_pop ( vec:Vec -- value:Unknown )
  vec vec_len 0 = when [ "vec_pop: the Vec is empty" abort ]
  vec vec_len 1 - -> [ n ]
  vec Vec_raw 0 n hwrite
  vec vec_data n hread
end

{ empties the Vec, keeping its capacity }
#vec_clear ( vec:Vec -- ) vec Vec_raw 0 0 hwrite end

#vec_from_block ( block:Block -- vec:Vec )
  block block_len vec_new -> [ vec ]
  block block_len [times| i | vec block i block_get vec_push ]
  vec
end

#vec_to_block ( vec:Vec -- block:Block )
  nil vec vec_len [times| i | vec vec_data vec vec_len 1 - i - hread cons ]
end

{ sorts the values ascending, as hsort orders them: numbers by value, }
{ strings and rows element by element; stable }
#vec_sort ( vec:Vec -- ) vec vec_data 0 vec vec_len hsort end

{ ---- sort_by: sorts the n cells of p from off, stably, in the order a    ---- }
{ ---- word you pass gives: `less ( a b -- f )` is nonzero when a must come ---- }
{ ---- before b. `p 0 n 'by_age sort_by`, with                             ---- }
{ ---- `#by_age ( a:Ptr b:Ptr -- f:Int ) a Person_age b Person_age < end` ---- }
{ ---- A bottom-up merge sort: n log n calls of less, n cells of scratch.  ---- }

{ whether the next value comes from the left run p[off+i ..): it has one,  }
{ and the right run is used up or its head is not less than the left's, so }
{ equal values keep their order }
#_sort_left ( p:Ptr off:Int mid:Int hi:Int i:Int j:Int less:Word(Unknown,Unknown--Int) -- f:Int )
  i mid < and_then [ j hi < not or_else [ p off j + hread p off i + hread less not ] ]
end

{ merges p[off+lo .. off+mid) and p[off+mid .. off+hi) into t[lo .. hi) }
#_sort_merge ( p:Ptr off:Int t:Ptr lo:Int mid:Int hi:Int less:Word(Unknown,Unknown--Int) -- )
  lo mid hi lo - [times| k |
    -> [ i j ]
    p off mid hi i j 'less _sort_left
    cond [ t lo k + p off i + hread hwrite i 1 + j ]
    else [ t lo k + p off j + hread hwrite i j 1 + ]
  ]
  drop drop
end

{ one pass: merges each pair of runs of length w into t, then copies back }
#_sort_pass ( p:Ptr off:Int n:Int t:Ptr w:Int less:Word(Unknown,Unknown--Int) -- )
  n 2 w * + 1 - 2 w * / [times| r |
    2 w * r * -> [ lo ]
    p off t lo lo w + n min :mid lo 2 w * + n min :hi 'less _sort_merge
  ]
  t :src 0 :soff p :dst off :doff n :count hmove
end

#sort_by ( p:Ptr off:Int n:Int less:Word(Unknown,Unknown--Int) -- )
  hmark -> [ mk ]
  n 1 max hnew -> [ t ]
  1 64 [times| k | -> [ w ] w n < cond [ p off n t w 'less _sort_pass w 2 * ] else [ w ] ]
  drop
  mk hrelease
end

{ sorts a Vec with sort_by's order: `v 'by_age vec_sort_by` }
#vec_sort_by ( v:Vec less:Word(Unknown,Unknown--Int) -- )
  v vec_data 0 v vec_len 'less sort_by
end
