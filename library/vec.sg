{ ---- vec: a growable vector of values, and sorting with your own order. ---- }
{ ---- A Vec is its own type (a handle on the heap), so a Vec passed where ---- }
{ ---- a Ptr or a map is expected, or the reverse, is a TypeError. Every  ---- }
{ ---- word takes the Vec first. Indexes are checked: an index outside    ---- }
{ ---- 0 <= i < vec_len stops the program with the word's name.          ---- }
{ ---- Header cells: 0 the length, 1 the capacity, 2 the data Ptr.        ---- }
#type Vec Ptr end

{ a new, empty Vec with room for cap values before it grows }
#vec_new ( cap:Scalar -- v:Vec )
  3 hnew -> [ h ]
  0 h 0 hwrite
  cap 1 max h 1 hwrite
  cap 1 max hnew h 2 hwrite
  h Vec_of
end

#vec_len ( v:Vec -- n:Scalar ) v Vec_raw 0 hread end
#vec_cap ( v:Vec -- n:Scalar ) v Vec_raw 1 hread end

{ the cells holding the values, at 0 .. vec_len - 1, for the heap words  }
{ (hsort, hmove, the numeric lexicon); a push may move them, so get it   }
{ again after one }
#vec_data ( v:Vec -- p:Ptr ) v Vec_raw 2 hread end

{ room for at least n values }
#vec_reserve ( v:Vec n:Scalar -- )
  v vec_cap n < when [
    v vec_cap 2 * n max -> [ c ]
    c hnew -> [ q ]
    v vec_data :src 0 :soff q :dst 0 :doff v vec_len :count hmove
    q v Vec_raw 2 hwrite
    c v Vec_raw 1 hwrite
  ]
end

#vec_push ( v:Vec x:Unknown -- )
  v v vec_len 1 + vec_reserve
  x v vec_data v vec_len hwrite
  v vec_len 1 + v Vec_raw 0 hwrite
end

#vec_get ( v:Vec i:Scalar -- x:Unknown )
  i 0 < i v vec_len < not or when [ "vec_get: the index is outside 0 .. vec_len - 1" abort ]
  v vec_data i hread
end

#vec_set ( v:Vec i:Scalar x:Unknown -- )
  i 0 < i v vec_len < not or when [ "vec_set: the index is outside 0 .. vec_len - 1" abort ]
  x v vec_data i hwrite
end

#vec_last ( v:Vec -- x:Unknown )
  v vec_len 0 = when [ "vec_last: the Vec is empty" abort ]
  v vec_data v vec_len 1 - hread
end

#vec_pop ( v:Vec -- x:Unknown )
  v vec_len 0 = when [ "vec_pop: the Vec is empty" abort ]
  v vec_len 1 - -> [ n ]
  n v Vec_raw 0 hwrite
  v vec_data n hread
end

{ empties the Vec, keeping its capacity }
#vec_clear ( v:Vec -- ) 0 v Vec_raw 0 hwrite end

#vec_from_block ( b:Block -- v:Vec )
  b len vec_new -> [ v ]
  b len [times| i | v b i block_get vec_push ]
  v
end

#vec_to_block ( v:Vec -- b:Block )
  nil v vec_len [times| i | v vec_data v vec_len 1 - i - hread swap cons ]
end

{ sorts the values ascending, as hsort orders them: numbers by value, }
{ strings and rows element by element; stable }
#vec_sort ( v:Vec -- ) v vec_data 0 v vec_len hsort end

{ ---- sort_by: sorts the n cells of p from off, stably, in the order a    ---- }
{ ---- word you pass gives: `less ( a b -- f )` is nonzero when a must come ---- }
{ ---- before b. `p 0 n 'by_age sort_by`, with                             ---- }
{ ---- `#by_age ( a:Ptr b:Ptr -- f:Scalar ) a Person_age b Person_age < end` ---- }
{ ---- A bottom-up merge sort: n log n calls of less, n cells of scratch.  ---- }

{ whether the next value comes from the left run p[off+i ..): it has one,  }
{ and the right run is used up or its head is not less than the left's, so }
{ equal values keep their order }
#_sort_left ( p:Ptr off:Scalar mid:Scalar hi:Scalar i:Scalar j:Scalar less:Word(Unknown,Unknown--Scalar) -- f:Scalar )
  i mid < and_then [ j hi < not or_else [ p off j + hread p off i + hread less not ] ]
end

{ merges p[off+lo .. off+mid) and p[off+mid .. off+hi) into t[lo .. hi) }
#_sort_merge ( p:Ptr off:Scalar t:Ptr lo:Scalar mid:Scalar hi:Scalar less:Word(Unknown,Unknown--Scalar) -- )
  lo mid hi lo - [times| k |
    -> [ i j ]
    p off mid hi i j 'less _sort_left
    cond [ p off i + hread t lo k + hwrite i 1 + j ]
    else [ p off j + hread t lo k + hwrite i j 1 + ]
  ]
  drop drop
end

{ one pass: merges each pair of runs of length w into t, then copies back }
#_sort_pass ( p:Ptr off:Scalar n:Scalar t:Ptr w:Scalar less:Word(Unknown,Unknown--Scalar) -- )
  n 2 w * + 1 - 2 w * / [times| r |
    2 w * r * -> [ lo ]
    p off t lo lo w + n min :mid lo 2 w * + n min :hi 'less _sort_merge
  ]
  t :src 0 :soff p :dst off :doff n :count hmove
end

#sort_by ( p:Ptr off:Scalar n:Scalar less:Word(Unknown,Unknown--Scalar) -- )
  hmark -> [ mk ]
  n 1 max hnew -> [ t ]
  1 64 [times| k | -> [ w ] w n < cond [ p off n t w 'less _sort_pass w 2 * ] else [ w ] ]
  drop
  mk hrelease
end

{ sorts a Vec with sort_by's order: `v 'by_age vec_sort_by` }
#vec_sort_by ( v:Vec less:Word(Unknown,Unknown--Scalar) -- )
  v vec_data 0 v vec_len 'less sort_by
end
