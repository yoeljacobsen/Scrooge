{ ---- N-Dimensional Heap Array Lexicon ---- }

#arr_size ( shape_block:Block -- total_cells:Int )
  [fold| idx acc val _ | acc val * from 1 ]
end

#arr_make ( shape_block:Block -- ptr:Ptr )
  shape_block
  shape_block arr_size shape_block len + 1 + hnew
  -> [ shape_block base_ptr ]
    base_ptr 0 shape_block len hwrite
    shape_block [fold| idx acc dim _ | base_ptr acc dim hwrite acc 1 + from 1 ] drop
    base_ptr
end

#arr_offset ( ptr:Ptr coords_block:Block -- flat_offset:Int )
  0
  coords_block [fold| idx acc coord _ |
    ptr 1 idx + hread
    acc * coord +
    from 0 ]
  ptr 0 hread + 1 + +
end

#arr_get ( ptr:Ptr coords_block:Block -- val:Unknown )
  ptr ptr coords_block arr_offset hread
end

#arr_set ( ptr:Ptr coords_block:Block val:Unknown -- )
  ptr ptr coords_block arr_offset val hwrite
end

#nth_or_default ( arr:Block idx:Int default:Unknown -- val:Unknown )
  idx 0 < not idx arr len < and
  cond [ arr idx block_get ] else [ default ] ?
end

