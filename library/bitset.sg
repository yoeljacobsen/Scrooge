{ ---- 64-bit Bitset Lexicon, built on the bitand/bitor/bitxor/bitshl/    ---- }
{ ---- bitshr/bitnot primitives. A "set" is a plain Scalar (64-bit int);   ---- }
{ ---- bit i is the (1 << i) place. No allocation, no Ptr -- everything    ---- }
{ ---- here is pure Scalar arithmetic.                                    ---- }

#bs_add ( set:Int index:Int -- set:Int )
  set 1 index bitshl bitor
end

#bs_test ( set:Int index:Int -- present:Int )
  set 1 index bitshl bitand 0 !=
end

#bs_union ( left:Int right:Int -- result:Int )
  left right bitor
end

#bs_inter ( left:Int right:Int -- result:Int )
  left right bitand
end

#bs_minus ( left:Int right:Int -- result:Int )
  left right bitnot bitand
end

{ bs_count and bs_first used to be 64-step loops of word calls; they are now
  the bitcount and bitctz primitives. Results unchanged: bs_first gives
  0 0 for an empty set. }
#bs_count ( set:Int -- count:Int )
  bitcount
end
#bs_first ( set:Int -- index:Int found:Int )
  set 0 = cond [ 0 0 ] else [ set bitctz 1 ]
end
