{ ---- Minimal Strings Lexicon: a string is a Block of ASCII integer codes ---- }
{ ---- Structural ops (reverse, length, concat, char-at, find-char) are already ---- }
{ ---- provided by util.sg since a string IS a Block. This lexicon adds only    ---- }
{ ---- what strings need beyond generic blocks: I/O, char predicates, int<->str. ---- }

{ ---- Print a whole string to stdout ---- }
#sp_step ( idx:Scalar acc:Scalar val:Scalar ctx:Scalar -- acc:Scalar )
  val print_char acc
end
#str_print ( str:Block --  )
  str [fold| idx acc val _ | idx acc val 0 :ctx sp_step from 0 ] drop
end

{ ---- Character predicates (fixed comparisons; return 1/0) ---- }
#is_digit ( ch:Scalar -- flag:Scalar )
  ch 47 > ch 58 < and
end
#is_space ( ch:Scalar -- flag:Scalar )
  ch 32 = ch 9 = or ch 10 = or ch 13 = or
end
#is_upper ( ch:Scalar -- flag:Scalar )
  ch 64 > ch 91 < and
end
#is_lower ( ch:Scalar -- flag:Scalar )
  ch 96 > ch 123 < and
end

{ ---- Integer -> string (supports negative integers) ---- }
#its_loop ( n:Scalar acc:Block -- result:Block )
  n 0 =
  cond [ acc ] else [ n 10 / acc n 10 \ 48 + cons its_loop ] ?
end
#int_to_str ( n:Scalar -- str:Block )
  n 0 =
  cond [ "0" ] else [ n 0 < cond [ 0 n - nil its_loop 45 cons ] else [ n nil its_loop ] ? ] ?
end

{ ---- Print an integer via string conversion, then newline ---- }
{ ---- Fixed-point and padded number output (GAPS_TASK_PLAN.md G3) ---- }
{ int_to_str_pad pads with zeros to a total width, the sign counted in it,
  as printf's %0Nd does: -5 3 int_to_str_pad is "-05". }
#itsp_pad_loop ( s:Block neg:Scalar width:Scalar -- s:Block )
  s len neg + width < cond [ s 48 cons neg width itsp_pad_loop ] else [ s ]
end
#int_to_str_pad ( n:Scalar width:Scalar -- s:Block )
  n abs int_to_str n 0 < width itsp_pad_loop n 0 < cond [ 45 cons ]
end
{ print_fixed prints an integer as a fixed-point number with `decimals`
  digits after the point: 12345 3 print_fixed is 12.345, -5 2 is -0.05,
  7 0 is 7. For times kept in integer nanoseconds, 3 gives microseconds.
  v must be an integer: for a float, use print_float. The remainder is
  taken before anything is printed, so a float stops the program with
  "Modulo requires integers" and the words that called print_fixed,
  instead of printing half a number first. }
#pf_pow10_loop ( d:Scalar acc:Scalar -- p:Scalar )
  d 0 = cond [ acc ] else [ d 1 - acc 10 * pf_pow10_loop ]
end
#print_fixed ( v:Scalar decimals:Scalar --  )
  -> [ v d ]
    v abs -> [ a ] d 1 pf_pow10_loop -> [ sc ] a sc \ -> [ fr ]
          v 0 < cond [ 45 print_char ]
          a sc / print_int
          d 0 > cond [ 46 print_char fr d int_to_str_pad str_print ]
end

#print_line ( n:Scalar --  )
  n int_to_str str_print 10 print_char
end

{ ---- String -> integer (multi-digit, signed, found-flag rather than a  ---- }
{ ---- sentinel). ok=0 for an empty range or any non-digit character in  ---- }
{ ---- [start,end) other than a single optional leading '-'.            ---- }
#s2i_step ( chars:Block idx:Scalar stop:Scalar acc:Scalar ok:Scalar -- chars:Block idx:Scalar stop:Scalar acc:Scalar ok:Scalar )
  chars idx block_get -> [ ch ]
    ch is_digit
    cond [
      chars idx 1 + stop acc 10 * ch 48 - + 1
    ] else [
      chars stop stop acc 0
    ] ?
end
#s2i_loop ( chars:Block idx:Scalar stop:Scalar acc:Scalar ok:Scalar -- acc:Scalar ok:Scalar )
  idx stop <
  cond [ chars idx stop acc ok s2i_step s2i_loop ] else [ acc ok ] ?
end
{ Note: the parameter is documented as `end` in the signature (harmless --
  signature scanning stops at `)`, not the "end" keyword) but bound as
  `stop` in every frame below. `end` is the reserved word that terminates a
  `#word ... end` definition; using it as an actual FRAME variable name
  makes the parser's body-scanner stop at that token, truncating the word
  right there (a raw, unlocatable "unterminated [ block" ParseError, not a
  ReservedWordIdentifierError -- the reserved-word check that would catch
  this runs on parsed nodes, after the body-scanner has already cut the
  word short on the literal token match). Confirmed by bisection: this
  word fails to compile with `end` bound here, and compiles cleanly with
  `stop`. }
#str_to_int ( chars:Block start:Scalar count:Scalar -- n:Scalar ok:Scalar )
  start count + -> [ stop ]
    chars
    start
    stop
    start stop < cond [ chars start block_get 45 = ] else [ 0 ] ?
  -> [ chars start stop neg ]
    neg
    chars
    neg cond [ start 1 + ] else [ start ] ? :idx
    stop
    0 :acc
    0 :ok
    s2i_loop
  -> [ neg acc ok ]
    neg cond [ 0 acc - ] else [ acc ] ?
    ok
end

{ ---- Substring search: hay[i..i+len(needle)) == needle for the first    ---- }
{ ---- i >= from. Compares characters in place (no substring is ever      ---- }
{ ---- materialized); found=0, pos=0 if there is no such i.               ---- }
#fs_cmp_step ( hay:Block needle:Block i:Scalar j:Scalar nlen:Scalar ok:Scalar -- hay:Block needle:Block i:Scalar j:Scalar nlen:Scalar ok:Scalar )
  hay needle i
  hay i j + block_get needle j block_get =
  cond [ j 1 + nlen 1 ] else [ nlen nlen 0 ] ?
end
#fs_cmp_loop ( hay:Block needle:Block i:Scalar j:Scalar nlen:Scalar ok:Scalar -- match:Scalar )
  j nlen < ok and
  cond [ hay needle i j nlen ok fs_cmp_step fs_cmp_loop ] else [ ok ] ?
end
#fs_matches_at ( hay:Block needle:Block i:Scalar nlen:Scalar -- match:Scalar )
  hay needle i 0 :j nlen 1 :ok fs_cmp_loop
end
#fs_scan_step ( hay:Block needle:Block i:Scalar hlen:Scalar nlen:Scalar -- hay:Block needle:Block i:Scalar hlen:Scalar nlen:Scalar )
  hay needle i 1 + hlen nlen
end
#fs_scan_loop ( hay:Block needle:Block i:Scalar hlen:Scalar nlen:Scalar -- pos:Scalar found:Scalar )
  i nlen + hlen > not
  cond [
    hay needle i nlen fs_matches_at
    cond [ i 1 ] else [ hay needle i hlen nlen fs_scan_step fs_scan_loop ] ?
  ] else [ 0 0 ] ?
end
{ Note: the search-start parameter is `start`, not `from`. `from` is the
  reserved word that introduces a fold's initial accumulator, so binding it
  as a frame alias is a ReservedWordIdentifierError -- the same family of
  trap as `end` in str_to_int above. It went unnoticed for as long as it did
  because lexicon source was never run through the checker at all; a gate now
  requires every library/*.sg to pass --check-only standalone. }
#find_sub ( hay:Block needle:Block start:Scalar -- pos:Scalar found:Scalar )
  hay needle start :i hay len :hlen needle len :nlen fs_scan_loop
end
