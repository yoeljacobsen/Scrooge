{ ---- Minimal Strings Lexicon: a string is a Block of ASCII integer codes ---- }
{ ---- Structural ops (reverse, length, concat, char-at, find-char) are already ---- }
{ ---- provided by util.sg since a string IS a Block. This lexicon adds only    ---- }
{ ---- what strings need beyond generic blocks: I/O, char predicates, int<->str. ---- }

{ ---- Print a whole string to stdout ---- }
#sp_step ( idx:Int acc:Int val:Int ctx:Int -- acc:Int )
  val print_char acc
end
#str_print ( str:Block --  )
  str [fold| idx acc val _ | idx acc val 0 :ctx sp_step from 0 ] drop
end

{ ---- Character predicates (fixed comparisons; return 1/0) ---- }
#is_digit ( ch:Int -- flag:Int )
  ch 47 > ch 58 < and
end
#is_space ( ch:Int -- flag:Int )
  ch 32 = ch 9 = or ch 10 = or ch 13 = or
end
#is_upper ( ch:Int -- flag:Int )
  ch 64 > ch 91 < and
end
#is_lower ( ch:Int -- flag:Int )
  ch 96 > ch 123 < and
end

{ ---- Integer -> string (supports negative integers) ---- }
#its_loop ( n:Int acc:Block -- result:Block )
  n 0 =
  cond [ acc ] else [ n 10 / acc n 10 \ 48 + cons its_loop ] ?
end
#int_to_str ( value:Int -- str:Block )
  value 0 =
  cond [ "0" ] else [ value 0 < cond [ 0 value - nil its_loop 45 cons ] else [ value nil its_loop ] ? ] ?
end

{ ---- Print an integer via string conversion, then newline ---- }
{ ---- Fixed-point and padded number output (GAPS_TASK_PLAN.md G3) ---- }
{ int_to_str_pad pads with zeros to a total width, the sign counted in it,
  as printf's %0Nd does: -5 3 int_to_str_pad is "-05". }
#itsp_pad_loop ( str:Block neg:Int width:Int -- str:Block )
  str block_len neg + width < cond [ str 48 cons neg width itsp_pad_loop ] else [ str ]
end
#int_to_str_pad ( value:Int width:Int -- str:Block )
  value abs int_to_str value 0 < width itsp_pad_loop value 0 < cond [ 45 cons ]
end
{ print_fixed prints an integer as a fixed-point number with `decimals`
  digits after the point: 12345 3 print_fixed is 12.345, -5 2 is -0.05,
  7 0 is 7. For times kept in integer nanoseconds, 3 gives microseconds.
  v must be an integer: for a float, use print_float. The remainder is
  taken before anything is printed, so a float stops the program with
  "Modulo requires integers" and the words that called print_fixed,
  instead of printing half a number first. }
#pf_pow10_loop ( d:Int acc:Int -- p:Int )
  d 0 = cond [ acc ] else [ d 1 - acc 10 * pf_pow10_loop ]
end
#print_fixed ( value:Int decimals:Int --  )
  -> [ value d ]
    value abs -> [ a ] d 1 pf_pow10_loop -> [ sc ] a sc \ -> [ fr ]
          value 0 < cond [ 45 print_char ]
          a sc / print_int
          d 0 > cond [ 46 print_char fr d int_to_str_pad str_print ]
end

#print_line ( value:Int --  )
  value int_to_str str_print 10 print_char
end

{ ---- String -> integer (multi-digit, signed, found-flag rather than a  ---- }
{ ---- sentinel). ok=0 for an empty range or any non-digit character in  ---- }
{ ---- [start,end) other than a single optional leading '-'.            ---- }
#s2i_step ( chars:Block idx:Int stop:Int acc:Int ok:Int -- chars:Block idx:Int stop:Int acc:Int ok:Int )
  chars idx block_get -> [ ch ]
    ch is_digit
    cond [
      chars idx 1 + stop acc 10 * ch 48 - + 1
    ] else [
      chars stop stop acc 0
    ] ?
end
#s2i_loop ( chars:Block idx:Int stop:Int acc:Int ok:Int -- acc:Int ok:Int )
  idx stop <
  cond [ chars idx stop acc ok s2i_step s2i_loop ] else [ acc ok ] ?
end
{ Note: the parameter is documented as `end` in the signature (harmless --
  signature scanning stops at `)`, not the "end" keyword) but bound as
  `stop` in every frame below. `end` is the reserved word that terminates a
  `#word ... end` definition; using it as an actual FRAME variable name
  makes the parser's body-scanner stop at that token, truncating the word
  right there (a raw, unlocatable "unterminated [ block" ParseError, not a
  ReservedWordIdentifierError -- the reserved-word check that would catch
  this runs on parsed nodes, after the body-scanner has already cut the
  word short on the literal token match). Confirmed by bisection: this
  word fails to compile with `end` bound here, and compiles cleanly with
  `stop`. }
#str_to_int ( chars:Block start:Int count:Int -- value:Int ok:Int )
  start count + -> [ stop ]
    chars
    start
    stop
    start stop < cond [ chars start block_get 45 = ] else [ 0 ] ?
  -> [ chars start stop neg ]
    neg
    chars
    neg cond [ start 1 + ] else [ start ] ? :idx
    stop
    0 :acc
    0 :ok
    s2i_loop
  -> [ neg acc ok ]
    neg cond [ 0 acc - ] else [ acc ] ?
    ok
end

{ ---- Substring search: hay[i..i+len(needle)) == needle for the first    ---- }
{ ---- i >= from. Compares characters in place (no substring is ever      ---- }
{ ---- materialized); found=0, pos=0 if there is no such i.               ---- }
#fs_cmp_step ( hay:Block needle:Block hpos:Int npos:Int nlen:Int ok:Int -- hay:Block needle:Block hpos:Int npos:Int nlen:Int ok:Int )
  hay needle hpos
  hay hpos npos + block_get needle npos block_get =
  cond [ npos 1 + nlen 1 ] else [ nlen nlen 0 ] ?
end
#fs_cmp_loop ( hay:Block needle:Block hpos:Int npos:Int nlen:Int ok:Int -- match:Int )
  npos nlen < ok and
  cond [ hay needle hpos npos nlen ok fs_cmp_step fs_cmp_loop ] else [ ok ] ?
end
#fs_matches_at ( hay:Block needle:Block index:Int nlen:Int -- match:Int )
  hay needle index :hpos 0 :npos nlen 1 :ok fs_cmp_loop
end
#fs_scan_step ( hay:Block needle:Block pos:Int hlen:Int nlen:Int -- hay:Block needle:Block pos:Int hlen:Int nlen:Int )
  hay needle pos 1 + hlen nlen
end
#fs_scan_loop ( hay:Block needle:Block pos:Int hlen:Int nlen:Int -- pos:Int found:Int )
  pos nlen + hlen > not
  cond [
    hay needle pos :index nlen fs_matches_at
    cond [ pos 1 ] else [ hay needle pos hlen nlen fs_scan_step fs_scan_loop ] ?
  ] else [ 0 0 ] ?
end
{ Note: the search-start parameter is `start`, not `from`. `from` is the
  reserved word that introduces a fold's initial accumulator, so binding it
  as a frame alias is a ReservedWordIdentifierError -- the same family of
  trap as `end` in str_to_int above. It went unnoticed for as long as it did
  because lexicon source was never run through the checker at all; a gate now
  requires every library/*.sg to pass --check-only standalone. }
#find_sub ( hay:Block needle:Block start:Int -- pos:Int found:Int )
  hay needle start :pos hay block_len :hlen needle block_len :nlen fs_scan_loop
end

{ ---- StrBuf (v1.84): text built in place, in one Bytes that grows by  ---- }
{ ---- doubling in place (bytes_resize, since v1.95), instead of a Block ---- }
{ ---- copied by every cons. The record                                  ---- }
{ ---- first, the value last; strbuf_write writes to a file (fh first).  ---- }
#type StrBuf Ptr end
#strbuf_new ( cap:Int -- buf:StrBuf )
  2 hnew -> [ p ] p 0 cap 1 max bytes_new hwrite p 1 0 hwrite p StrBuf_of
end
#_sb_a ( b:StrBuf -- a:Bytes ) b StrBuf_raw 0 hread end
#strbuf_len ( buf:StrBuf -- length:Int ) buf StrBuf_raw 1 hread end
#_sb_room ( b:StrBuf n:Int -- )
  b _sb_a -> [ a ] b strbuf_len n + -> [ need ]
  need a bytes_len > when [ a need a bytes_len 2 * max bytes_resize ]
end
#strbuf_add_char ( buf:StrBuf ch:Int -- )
  buf 1 _sb_room buf strbuf_len -> [ n ] buf _sb_a n ch bytes_set buf StrBuf_raw 1 n 1 + hwrite
end
#strbuf_add ( buf:StrBuf str:Block -- )
  buf str block_len _sb_room buf _sb_a -> [ a ] buf strbuf_len -> [ n ]
  str block_len [times| i | a n i + str i block_get bytes_set ]
  buf StrBuf_raw 1 n str block_len + hwrite
end
#strbuf_add_int ( buf:StrBuf value:Int -- ) buf value int_to_str strbuf_add end
#strbuf_add_float ( buf:StrBuf number:Scalar decimals:Int -- ) buf number decimals float_to_str strbuf_add end
#strbuf_to_str ( buf:StrBuf -- str:Block ) buf _sb_a 0 buf strbuf_len bytes_to_block end
#strbuf_write ( fh:File buf:StrBuf -- written:Int ) fh :fh buf _sb_a :array 0 :start buf strbuf_len :count bytes_write end
#strbuf_clear ( buf:StrBuf -- ) buf StrBuf_raw 1 0 hwrite end

{ ---- Padding to a width with spaces (v1.84); a string at least that    ---- }
{ ---- wide is returned as it is. int_to_str_pad pads a number with 0s.  ---- }
#str_pad_left ( str:Block width:Int -- padded:Block )
  str block_len width < cond [ str 32 cons width str_pad_left ] else [ str ] ?
end
#_pad_spaces ( acc:Block k:Int -- acc:Block )
  k 0 > cond [ acc 32 cons k 1 - _pad_spaces ] else [ acc ] ?
end
#_pad_prepend ( str:Block count:Int acc:Block -- acc:Block )
  count 0 < cond [ acc ] else [ str count 1 - acc str count block_get cons _pad_prepend ] ?
end
#str_pad_right ( str:Block width:Int -- padded:Block )
  str str block_len 1 - nil width str block_len - _pad_spaces _pad_prepend
end

{ ---- An integer in hexadecimal, lowercase; a negative one as its 64-bit ---- }
{ ---- pattern (16 digits): -1 is ffffffffffffffff.                      ---- }
#_hex_digit ( d:Int -- c:Int ) d 10 < cond [ d 48 + ] else [ d 87 + ] ? end
#_hex_loop ( value:Int digits:Int acc:Block -- str:Block )
  value 0 = digits 16 = or cond [ acc ] else [ value 4 bitshr digits 1 + acc value 15 bitand _hex_digit cons _hex_loop ] ?
end
#int_to_hex ( value:Int -- str:Block ) value 0 = cond [ "0" ] else [ value 0 nil _hex_loop ] ? end

{ ---- The pieces of str between the separator ch, in order; n         ---- }
{ ---- separators give n+1 pieces, empty ones included ("a,,b" is a,   ---- }
{ ---- "", b).                                                          ---- }
#_split_loop ( str:Block ch:Int index:Int stop:Int acc:Block -- parts:Block )
  index 0 < cond [ acc str 0 stop block_slice cons ] else [
    str index block_get ch = cond [
      str ch index 1 - :index index :stop acc str index 1 + stop index - 1 - block_slice cons :acc _split_loop
    ] else [ str ch index 1 - :index stop acc _split_loop ] ? ] ?
end
#str_split ( str:Block ch:Int -- parts:Block ) str ch str block_len 1 - :index str block_len :stop nil :acc _split_loop end
