#hclear_step ( p:Ptr idx:Int stop_idx:Int -- p:Ptr idx:Int stop_idx:Int )
  p idx 0 hwrite p idx 1 + stop_idx
end
#hclear_loop ( p:Ptr idx:Int stop_idx:Int --  )
  idx stop_idx <
  cond [ p idx stop_idx hclear_step hclear_loop ] else [ ] ?
end
#hclear ( ptr:Ptr start:Int size:Int --  )
  ptr start start size + hclear_loop
end
#hfill_step ( val:Scalar p:Ptr idx:Int stop_idx:Int -- val:Scalar p:Ptr idx:Int stop_idx:Int )
  p idx val hwrite val p idx 1 + stop_idx
end
#hfill_loop ( val:Scalar p:Ptr idx:Int stop_idx:Int --  )
  idx stop_idx <
  cond [ val p idx stop_idx hfill_step hfill_loop ] else [ ] ?
end
#hloop_fill ( ptr:Ptr start:Int count:Int val:Int --  )
  val ptr start :idx start count + :stop_idx hfill_loop
end
#hadd_step ( val:Scalar p:Ptr idx:Int stop_idx:Int -- val:Scalar p:Ptr idx:Int stop_idx:Int )
  p idx p idx hread val + hwrite val p idx 1 + stop_idx
end
#hadd_loop ( val:Scalar p:Ptr idx:Int stop_idx:Int --  )
  idx stop_idx <
  cond [ val p idx stop_idx hadd_step hadd_loop ] else [ ] ?
end
#hloop_add ( ptr:Ptr start:Int count:Int val:Int --  )
  val ptr start :idx start count + :stop_idx hadd_loop
end
{ ---- One word calling itself, so it runs as a loop. It was two words   ---- }
{ ---- calling each other, which nested a call per cell and stopped at   ---- }
{ ---- 65,536 cells with `Fatal: Max frames exceeded`.                   ---- }
#h_find_val_loop ( ptr:Ptr size:Int val:Scalar current_idx:Int -- index:Int )
  current_idx size =
  cond [ -1 ] else [
    ptr current_idx hread val =
    cond [ current_idx ] else [ ptr size val current_idx 1 + :current_idx h_find_val_loop ]
  ]
end
#h_find_val ( ptr:Ptr size:Int val:Scalar -- index:Int )
  ptr size val 0 :current_idx h_find_val_loop
end
