#hclear_step ( p:Ptr idx:Scalar stop_idx:Scalar -- p2:Ptr idx2:Scalar stop_idx2:Scalar )
  -> [ p idx stop_idx ] [ 0 p idx hwrite p idx 1 + stop_idx ]
end
#hclear_loop ( p:Ptr idx:Scalar stop_idx:Scalar -- )
  -> [ p idx stop_idx ] [ idx stop_idx < ]
  cond [ p idx stop_idx hclear_step hclear_loop ] else [ ] ?
end
#hclear ( p:Ptr start:Scalar size:Scalar -- )
  -> [ p start size ] [ p start start size + hclear_loop ]
end
#hfill_step ( val:Scalar p:Ptr idx:Scalar stop_idx:Scalar -- val2:Scalar p2:Ptr idx2:Scalar stop_idx2:Scalar )
  -> [ val p idx stop_idx ] [ val p idx hwrite val p idx 1 + stop_idx ]
end
#hfill_loop ( val:Scalar p:Ptr idx:Scalar stop_idx:Scalar -- )
  -> [ val p idx stop_idx ] [ idx stop_idx < ]
  cond [ val p idx stop_idx hfill_step hfill_loop ] else [ ] ?
end
#hloop_fill ( p:Ptr start:Scalar stop:Scalar val:Scalar -- )
  -> [ p start stop val ] [ val p start stop hfill_loop ]
end
#hadd_step ( val:Scalar p:Ptr idx:Scalar stop_idx:Scalar -- val2:Scalar p2:Ptr idx2:Scalar stop_idx2:Scalar )
  -> [ val p idx stop_idx ] [ p idx hread val + p idx hwrite val p idx 1 + stop_idx ]
end
#hadd_loop ( val:Scalar p:Ptr idx:Scalar stop_idx:Scalar -- )
  -> [ val p idx stop_idx ] [ idx stop_idx < ]
  cond [ val p idx stop_idx hadd_step hadd_loop ] else [ ] ?
end
#hloop_add ( p:Ptr start:Scalar stop:Scalar val:Scalar -- )
  -> [ p start stop val ] [ val p start stop hadd_loop ]
end
#h_find_val_check ( ptr:Ptr size:Scalar val:Scalar current_idx:Scalar -- index:Scalar )
  -> [ ptr size val current_idx ] [ ptr current_idx hread val = ]
  cond [ current_idx ] else [ ptr size val current_idx 1 + h_find_val_loop ] ?
end
#h_find_val_loop ( ptr:Ptr size:Scalar val:Scalar current_idx:Scalar -- index:Scalar )
  -> [ ptr size val current_idx ] [ current_idx size = ]
  cond [ -1 ] else [ ptr size val current_idx h_find_val_check ] ?
end
#h_find_val ( ptr:Ptr size:Scalar val:Scalar -- index:Scalar )
  -> [ ptr size val ] [ ptr size val 0 h_find_val_loop ]
end
