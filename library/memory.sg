#hclear_step ( p:Ptr idx:Scalar stop_idx:Scalar -- p:Ptr idx:Scalar stop_idx:Scalar )
  0 p idx hwrite p idx 1 + stop_idx
end
#hclear_loop ( p:Ptr idx:Scalar stop_idx:Scalar --  )
  idx stop_idx <
  cond [ p idx stop_idx hclear_step hclear_loop ] else [ ] ?
end
#hclear ( p:Ptr start:Scalar size:Scalar --  )
  p start start size + hclear_loop
end
#hfill_step ( val:Scalar p:Ptr idx:Scalar stop_idx:Scalar -- val:Scalar p:Ptr idx:Scalar stop_idx:Scalar )
  val p idx hwrite val p idx 1 + stop_idx
end
#hfill_loop ( val:Scalar p:Ptr idx:Scalar stop_idx:Scalar --  )
  idx stop_idx <
  cond [ val p idx stop_idx hfill_step hfill_loop ] else [ ] ?
end
#hloop_fill ( p:Ptr start:Scalar stop:Scalar val:Scalar --  )
  val p start :idx stop :stop_idx hfill_loop
end
#hadd_step ( val:Scalar p:Ptr idx:Scalar stop_idx:Scalar -- val:Scalar p:Ptr idx:Scalar stop_idx:Scalar )
  p idx hread val + p idx hwrite val p idx 1 + stop_idx
end
#hadd_loop ( val:Scalar p:Ptr idx:Scalar stop_idx:Scalar --  )
  idx stop_idx <
  cond [ val p idx stop_idx hadd_step hadd_loop ] else [ ] ?
end
#hloop_add ( p:Ptr start:Scalar stop:Scalar val:Scalar --  )
  val p start :idx stop :stop_idx hadd_loop
end
{ ---- One word calling itself, so it runs as a loop. It was two words   ---- }
{ ---- calling each other, which nested a call per cell and stopped at   ---- }
{ ---- 65,536 cells with `Fatal: Max frames exceeded`.                   ---- }
#h_find_val_loop ( ptr:Ptr size:Scalar val:Scalar current_idx:Scalar -- index:Scalar )
  current_idx size =
  cond [ -1 ] else [
    ptr current_idx hread val =
    cond [ current_idx ] else [ ptr size val current_idx 1 + :current_idx h_find_val_loop ]
  ]
end
#h_find_val ( ptr:Ptr size:Scalar val:Scalar -- index:Scalar )
  ptr size val 0 :current_idx h_find_val_loop
end
