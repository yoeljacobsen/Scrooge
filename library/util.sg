#reverse ( block:Block -- reversed:Block )
  [fold| idx acc val _ | val acc cons from nil ]
end
{ `len` is O(1). This word used to count by folding over every element --
  a frame entered and left per element -- and was 94% of the instructions
  of the curated select4 regression. Kept as a word so callers need not change. }
#length ( block:Block -- n:Scalar )
  len
end
#nth ( block:Block idx:Scalar -- val:Unknown )
  at
end
#sum ( block:Block -- total:Scalar )
  [fold| idx acc val _ | acc val + from 0 ]
end
#contains ( block:Block target:Scalar -- flag:Scalar )
  -> [ block target ] [ target block [fold| idx acc val ctx | acc val ctx = or from 0 ] ]
end
#feq_step ( idx:Scalar acc:Block val:Scalar ctx:Scalar -- acc2:Block )
  -> [ idx acc val ctx ] [ val ctx = ]
  cond [ val acc cons ] else [ acc ] ?
end
#filter_eq ( block:Block target:Scalar -- filtered:Block )
  -> [ block target ] [
    target block [fold| idx acc val ctx | idx acc val ctx feq_step from nil ]
  ]
  reverse
end
#idx_step ( idx:Scalar acc:Scalar val:Scalar ctx:Scalar -- acc2:Scalar )
  -> [ idx acc val ctx ] [ acc -1 = val ctx = and ]
  cond [ idx ] else [ acc ] ?
end
#index_of ( block:Block target:Scalar -- idx:Scalar )
  -> [ block target ] [ target block [fold| idx acc val ctx | idx acc val ctx idx_step from -1 ] ]
end
#concat ( b1:Block b2:Block -- joined:Block )
  -> [ b1 b2 ] [ b1 reverse [fold| idx acc val _ | val acc cons from b2 ] ]
end

#>= ( a:Scalar b:Scalar -- bool:Scalar )
  < not
end

#<= ( a:Scalar b:Scalar -- bool:Scalar )
  > not
end

#block_eq_step ( idx:Scalar acc:Scalar val:Unknown ctx:Block -- acc2:Scalar )
  -> [ idx acc val ctx ] acc 0 =
  cond [ 0 ] else [ val ctx idx at = ] ?
end
#block_eq ( b1:Block b2:Block -- equal:Scalar )
  -> [ b1 b2 ] b1 len b2 len =
  cond [ b2 b1 [fold| idx acc val ctx | idx acc val ctx block_eq_step from 1 ] ] else [ 0 ] ?
end

#insert_sort_step ( idx:Scalar acc:Block val:Unknown ctx:Unknown -- acc2:Block )
  -> [ idx acc val ctx ] acc 0 at
  cond [
    val acc 1 at cons acc 0 at swap pair
  ] else [
    ctx val <
    cond [
      val ctx acc 1 at cons cons 1 swap pair
    ] else [
      val acc 1 at cons 0 swap pair
    ] ?
  ] ?
end
#insert_sorted ( val:Unknown blk:Block -- result:Block )
  -> [ val blk ] [
    val blk [fold| idx acc elem x | idx acc elem x insert_sort_step from [ 0 nil ] ]
    -> [ res_pair ] res_pair 0 at 0 =
    cond [ val res_pair 1 at cons ] else [ res_pair 1 at ] ?
    reverse
  ]
end
#block_sort ( blk:Block -- sorted:Block )
  [fold| idx acc val _ | val acc insert_sorted from nil ]
end

