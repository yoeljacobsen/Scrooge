#reverse ( block:Block -- reversed:Block )
  [fold| idx acc val _ | acc val cons from nil ]
end
{ `len` is O(1). This word used to count by folding over every element --
  a frame entered and left per element -- and was 94% of the instructions
  of a large benchmark workload. Kept as a word so callers need not change. }
#sum ( block:Block -- total:Unknown )
  [fold| idx acc val _ | acc val + from 0 ]
end
#contains ( block:Block target:Scalar -- flag:Int )
  target block [fold| idx acc val ctx | acc val ctx = or from 0 ]
end
#feq_step ( idx:Int acc:Block val:Scalar ctx:Scalar -- acc:Block )
  val ctx =
  cond [ acc val cons ] else [ acc ] ?
end
#filter_eq ( block:Block target:Int -- filtered:Block )
  target block [fold| idx acc val ctx | idx acc val ctx feq_step from nil ]
  reverse
end
#idx_step ( idx:Int acc:Int val:Scalar ctx:Scalar -- acc:Int )
  acc -1 = val ctx = and
  cond [ idx ] else [ acc ] ?
end
#index_of ( block:Block target:Scalar -- idx:Int )
  target block [fold| idx acc val ctx | idx acc val ctx idx_step from -1 ]
end
#concat ( b1:Block b2:Block -- joined:Block )
  b1 reverse [fold| idx acc val _ | acc val cons from b2 ]
end



{ `=` already compares Blocks element by element (same lengths, then `=`
  on each element), which is what this word did with a fold and a frame per
  element: 13% of a large benchmark workload. The two `len`s are not
  redundant. The checker lets an Unknown-typed value reach a Block parameter,
  and the old word's `len` stopped a program that passed a non-Block
  ("Fatal: len operand must be a block/list"); `=` alone would compare it
  and carry on. They keep that behaviour, in the same order, for O(1). }
#block_eq ( b1:Block b2:Block -- equal:Int )
  b1 block_len drop b2 block_len drop b1 b2 =
end

#insert_sort_step ( idx:Int acc:Block val:Unknown ctx:Unknown -- acc:Block )
  acc 0 block_get
  cond [
    acc 1 block_get val cons acc 0 block_get swap pair
  ] else [
    ctx val <
    cond [
      acc 1 block_get ctx cons val cons 1 swap pair
    ] else [
      acc 1 block_get val cons 0 swap pair
    ] ?
  ] ?
end
#insert_sorted ( val:Unknown blk:Block -- result:Block )
  val blk [fold| idx acc elem x | idx acc elem :val x :ctx insert_sort_step from [ 0 nil ] ]
  -> [ res_pair ] res_pair 0 block_get 0 =
  cond [ res_pair 1 block_get val cons ] else [ res_pair 1 block_get ] ?
  reverse
end
{ block_sort was an insertion sort that rebuilt its result on every insert:
  O(n^2) comparisons and allocations. It now copies into a marked heap
  region, sorts it with hsort (stable, ordered exactly as `<` orders), and
  copies back: O(n log n). It sorts numbers (as `<` orders them) and Blocks
  (element by element, shorter first on a tie), so a Block of strings sorts
  in byte order and a Block of rows column by column; numbers sort before
  Blocks. A Ptr element is a fatal error. }
#bsort_fill_step ( idx:Int acc:Int val:Unknown p:Ptr -- acc:Int )
  p idx val hwrite acc
end
#bsort_collect_loop ( p:Ptr i:Int acc:Block -- sorted:Block )
  i 0 = cond [ acc ] else [ p i 1 - acc p i 1 - hread cons bsort_collect_loop ]
end
#block_sort ( blk:Block -- sorted:Block )
  hmark -> [ m ]
    blk block_len -> [ n ]
      n hnew -> [ p ]
        p blk [fold| idx acc val p2 | idx acc val p2 :p bsort_fill_step from 0 ] drop
        p 0 n hsort
        p n nil bsort_collect_loop
        m hrelease
end


{ ---- assert: stop with a message when an invariant fails. `abort` ---- }
{ ---- prints msg to stderr and exits nonzero; a true flag costs one ---- }
{ ---- test. For looking at a value while debugging, see `trace`.   ---- }
#assert ( ok:Int msg:Block --  )
  ok cond [ ] else [ msg abort ]
end
{ ---- Test helpers, for #test_ words run by `scroogec_fast --test`: each     ---- }
{ ---- returns its flag, so several combine with `and`, and prints the      ---- }
{ ---- message (and the values) when it fails.                              ---- }
#ex_say_step ( s:Block --  ) s [fold| i acc c _ | c print_char acc from 0 ] drop end
#ex_num_step ( x:Unknown --  )
  x type_of 0 = cond [ x print_int ] else [
    x type_of 1 = cond [ x 6 print_float ] else [ "(not a number)" ex_say_step ] ?
  ] ?
end
#expect ( ok:Int msg:Block -- ok:Int )
  ok cond [ ] else [ "  expected: " ex_say_step msg ex_say_step 10 print_char ] ? ok
end
{ ---- expect_stop: the first thing in a #test_ word whose code must stop ---- }
{ ---- the program; --test runs it alone and passes it when the program   ---- }
{ ---- stops with msg in its error output (v1.88).                        ---- }
#ex_err_step (  -- fh:File )
  2
end
#expect_stop ( msg:Block --  )
  ex_err_step "expect_stop: " fwrite drop ex_err_step msg fwrite drop ex_err_step 10 fputc drop
end
#expect_eq ( got:Unknown want:Unknown msg:Block -- ok:Int )
  got want = -> [ ok ]
    ok cond [ ] else [
      "  " ex_say_step msg ex_say_step ": got " ex_say_step got ex_num_step
      ", want " ex_say_step want ex_num_step 10 print_char
    ] ? ok
end
#expect_near ( got:Scalar want:Scalar tol:Scalar msg:Block -- ok:Int )
  got want - abs tol > not -> [ ok ]
    ok cond [ ] else [
      "  " ex_say_step msg ex_say_step ": got " ex_say_step got ex_num_step
      ", want " ex_say_step want ex_num_step " within " ex_say_step tol ex_num_step 10 print_char
    ] ? ok
end
