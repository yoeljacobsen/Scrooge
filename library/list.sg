{ ---- Growable Mutable List Lexicon ---- }

{ ---- Accepted, bounded leak: lst_grow orphans one heap slot per growth. ---- }
{ ---- `heap[]` has no per-cell free -- hmark/hrelease is a bulk LIFO         ---- }
{ ---- rewind that cannot reclaim one arbitrary earlier slot without         ---- }
{ ---- invalidating everything after it -- so the buffer lst_grow replaces   ---- }
{ ---- stays allocated for the life of the process.                          ---- }
{ ----                                                                       ---- }
{ ---- Measured, not estimated: orphans per list = ceil(log2(n/initial_cap)), ---- }
{ ---- exactly. Pushing n elements into a capacity-16 list leaves            ---- }
{ ---- 2 + ceil(log2(n/16)) live slots (2 being the header and the current   ---- }
{ ---- buffer):                                                              ---- }
{ ----     n =     16   17   33  100  1000  10000  100000                    ---- }
{ ----   live =      2    3    4    5     8     12      15                   ---- }
{ ---- So it is LOGARITHMIC in list length, not linear. Against the          ---- }
{ ---- 1,000,000-slot budget, exhausting it through lst_grow alone would      ---- }
{ ---- take roughly 77,000 separate long-lived lists each grown to 100,000    ---- }
{ ---- elements. For reference, a real workload that builds 9 tables of     ---- }
{ ---- a few hundred rows each and runs 10 queries over them finishes       ---- }
{ ---- with 63 live slots out of 1,000,000, of which roughly 36 are these     ---- }
{ ---- orphans.                                                              ---- }
{ ----                                                                       ---- }
{ ---- Recorded as accepted rather than fixed: a real per-cell free (hfree,   ---- }
{ ---- or a free-list inside op_hnew) would add a use-after-free shape the    ---- }
{ ---- checker cannot see -- the Bug 12/13 class -- to reclaim 13 slots per   ---- }
{ ---- 100,000-element list. If a caller's lists really are short-lived,      ---- }
{ ---- bracket their construction with hmark/hrelease instead. See Task 6 in  ---- }
{ ---- BUGFIX_TASK_PLAN.md and PHASE2_HANDOFF.md task #21.                    ---- }

#lst_make ( initial_capacity:Scalar -- ptr:Ptr )
  initial_capacity
  3 hnew
  -> [ initial_capacity head_ptr ] [
    initial_capacity head_ptr 0 hwrite
    0 head_ptr 1 hwrite
    initial_capacity hnew head_ptr 2 hwrite
    head_ptr
  ]
end

#lst_get ( ptr:Ptr idx:Scalar -- val:Unknown )
  ptr 2 hread idx hread
end

#lst_set ( val:Unknown ptr:Ptr idx:Scalar --  )
  val ptr 2 hread idx hwrite
end

#lst_new_cap ( old_cap:Scalar -- new_cap:Scalar )
  old_cap 0 =
  cond [ 1 ] else [ old_cap 2 * ] ?
end

#lst_copy_step ( src:Ptr dst:Ptr idx:Scalar stop:Scalar -- src:Ptr dst:Ptr idx:Scalar stop:Scalar )
  src idx hread dst idx hwrite
  src dst idx 1 + stop
end
#lst_copy_loop ( src:Ptr dst:Ptr idx:Scalar stop:Scalar --  )
  idx stop <
  cond [ src dst idx stop lst_copy_step lst_copy_loop ] else [ ] ?
end

#lst_grow ( ptr:Ptr --  )
  ptr
  ptr 0 hread
  -> [ ptr old_cap ] [
    ptr
    old_cap
    old_cap lst_new_cap
  ]
  -> [ ptr old_cap new_cap ] [
    ptr
    old_cap
    new_cap
    new_cap hnew
  ]
  -> [ ptr old_cap new_cap new_data ] [
    ptr 2 hread :src new_data :dst 0 :idx old_cap :stop lst_copy_loop
    new_cap ptr 0 hwrite
    new_data ptr 2 hwrite
  ]
end

#lst_push ( val:Unknown ptr:Ptr --  )
  ptr 1 hread ptr 0 hread <
  cond [
    val ptr ptr 1 hread lst_set
    ptr 1 hread 1 + ptr 1 hwrite
  ] else [
    ptr lst_grow
    val ptr ptr 1 hread lst_set
    ptr 1 hread 1 + ptr 1 hwrite
  ] ?
end

#lst_try_push ( val:Unknown ptr:Ptr -- ok:Scalar )
  ptr 1 hread ptr 0 hread <
  cond [
    val ptr ptr 1 hread lst_set
    ptr 1 hread 1 + ptr 1 hwrite
    1
  ] else [ 0 ] ?
end
