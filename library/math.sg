{ ---- math: sine, cosine, tangent and arctangent, written in Scrooge.      ---- }
{ ---- The method is fdlibm's (Sun's freely distributable libm): reduce x  ---- }
{ ---- to |r| <= pi/4 and a quadrant, then a polynomial in r. Checked      ---- }
{ ---- against C's libm: sin and cos within 1 unit in the last place, tan  ---- }
{ ---- within 2, atan and atan2 within 3. sin, cos and tan stop the        ---- }
{ ---- program for |x| over 1647099 (2^20 pi/2), where the reduction would ---- }
{ ---- lose precision: reduce such an angle first.                         ---- }
{ ---- A library lexicon rather than primitives, so the names are free in  ---- }
{ ---- every program that does not `use "math"`.                          ---- }

{ ---- pi, to the precision of a Float ---- }
#pi ( -- value:Float ) 3.141592653589793 end

{ ---- x as r + quad pi/2, |r| <= pi/4, quad in 0..3; pi/2 is split in three ---- }
{ ---- parts so that n pi/2 is subtracted almost exactly (fdlibm's medium case) ---- }
#_trig_reduce ( x:Float -- r:Float quad:Int )
  x abs 1647099.0 > cond [ "sin/cos/tan: |x| is over 1647099 (2^20 pi/2), where the result would lose precision; reduce the angle first" abort ] else [ ]
  x 0.6366197723675814 * 0.5 + floor -> [ n ]
  n to_float -> [ fn ]
  x fn 1.57079632673412561417 * - -> [ r0 ]
  fn 6.07710050630396597660e-11 * -> [ w0 ]
  r0 w0 - -> [ r1 ]
  fn 2.02226624879595063154e-21 * r0 r1 - w0 - - -> [ w1 ]
  r1 w1 - n 4 \
end

{ ---- sin r for |r| <= pi/4 ---- }
#_ksin ( r:Float -- s:Float )
  r r * -> [ z ]
  z 1.58969099521155010221e-10 * -2.50507602534068634195e-08 + z * 2.75573137070700676789e-06 +
  z * -1.98412698298579493134e-04 + z * 8.33333333332248946124e-03 + -> [ p ]
  r r z * -1.66666666666666324348e-01 z p * + * +
end

{ ---- cos r for |r| <= pi/4 ---- }
#_kcos ( r:Float -- c:Float )
  r r * -> [ z ]
  z -1.13596475577881948265e-11 * 2.08757232129817482790e-09 + z * -2.75573143513906633035e-07 +
  z * 2.48015872894767294178e-05 + z * -1.38888888888741095749e-03 + z * 4.16666666666666019037e-02 + z * -> [ q ]
  z 0.5 * -> [ hz ]
  1.0 hz - -> [ w ]
  w 1.0 w - hz - z q * + +
end

{ ---- sin of r + quad pi/2 (cos is the next quadrant's sin) ---- }
#_sin_quad ( r:Float quad:Int -- s:Float )
  quad 1 bitand 0 = cond [ r _ksin ] else [ r _kcos ] -> [ v ]
  quad 2 bitand 0 = cond [ v ] else [ 0.0 v - ]
end

{ ---- the sine of an angle in radians ---- }
#sin ( angle:Scalar -- sine:Float ) angle to_float _trig_reduce _sin_quad end

{ ---- the cosine of an angle in radians ---- }
#cos ( angle:Scalar -- cosine:Float ) angle to_float _trig_reduce 1 + _sin_quad end

{ ---- the tangent of an angle in radians ---- }
#tan ( angle:Scalar -- tangent:Float )
  angle to_float _trig_reduce -> [ r quad ]
  r quad _sin_quad r quad 1 + _sin_quad /
end

{ ---- the even-indexed terms of atan's series, in w = x^4, times z = x^2 ---- }
#_atan_even ( z:Float w:Float -- s1:Float )
  w 1.62858201153657823623e-02 * 4.97687799461593236017e-02 + w * 6.66107313738753120669e-02 +
  w * 9.09088713343650656196e-02 + w * 1.42857142725034663711e-01 + w * 3.33333333333329318027e-01 + z *
end

{ ---- the odd-indexed terms of atan's series, times w = x^4 ---- }
#_atan_odd ( w:Float -- s2:Float )
  w -3.65315727442169155270e-02 * -5.83357013379057348645e-02 + w * -7.69187620504482999495e-02 +
  w * -1.11111104054623557880e-01 + w * -1.99999999998764832476e-01 + w *
end

{ ---- x (s1 + s2), what atan x differs from x by, for |x| <= 7/16 ---- }
#_atan_series ( x:Float -- p:Float )
  x x * -> [ z ]
  z z * -> [ w ]
  x z w _atan_even w _atan_odd + *
end

{ ---- a >= 0 moved near 0, with which of atan 0.5, 1, 1.5, inf it is taken ---- }
{ ---- from (-1: none) ---- }
#_atan_reduce ( a:Float -- t:Float id:Int )
  a 0.4375 < cond [ a -1 ] else [
    a 1.1875 < cond [
      a 0.6875 < cond [ 2.0 a * 1.0 - 2.0 a + / 0 ] else [ a 1.0 - a 1.0 + / 1 ]
    ] else [
      a 2.4375 < cond [ a 1.5 - 1.0 1.5 a * + / 2 ] else [ -1.0 a / 3 ]
    ]
  ]
end

{ ---- atan a for a >= 0; each base angle is a high and a low part ---- }
#_atan_pos ( a:Float -- t:Float )
  a _atan_reduce -> [ t id ]
  id 0 < cond [ t t _atan_series - ] else [
    [ 4.63647609000806093515e-01 7.85398163397448278999e-01 9.82793723247329054082e-01 1.57079632679489655800e+00 ] id block_get
    t _atan_series
    [ 2.26987774529616870924e-17 3.06161699786838301793e-17 1.39033110312309984516e-17 6.12323399573676603587e-17 ] id block_get
    - t - -
  ]
end

{ ---- the arctangent of value, in radians, in -pi/2 .. pi/2 ---- }
#atan ( value:Scalar -- angle:Float )
  value to_float -> [ f ]
  f 0.0 < cond [ 0.0 0.0 f - _atan_pos - ] else [ f _atan_pos ]
end

{ ---- the angle of (0, y): pi/2 above, -pi/2 below, 0 at the origin ---- }
#_atan2_axis ( fy:Float -- angle:Float )
  fy 0.0 > cond [ pi 0.5 * ] else [ fy 0.0 < cond [ pi -0.5 * ] else [ 0.0 ] ]
end

{ ---- the angle of the point (dx, dy) from the x axis, in -pi .. pi (dy first, as C's atan2 y x) ---- }
#atan2 ( dy:Scalar dx:Scalar -- angle:Float )
  dy to_float -> [ fy ]
  dx to_float -> [ fx ]
  fx 0.0 > cond [ fy fx / atan ] else [
    fx 0.0 < cond [
      fy fx / atan fy 0.0 < cond [ pi - ] else [ pi + ]
    ] else [ fy _atan2_axis ]
  ]
end
