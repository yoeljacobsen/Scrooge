{ ---- dict: a hash map to any values, from integer, string or other   ---- }
{ ---- Block keys (a #struct value is one). A Dict is its own type (a    ---- }
{ ---- handle on the heap); every word takes the Dict                     ---- }
{ ---- first. Keys compare as `=` does, so the string "ab" and the Block  ---- }
{ ---- [ 97 98 ] are the same key. Open addressing with linear probing;   ---- }
{ ---- the table doubles before it is three quarters full.               ---- }
{ ---- Header cells: 0 live keys, 1 used slots (live and deleted),        ---- }
{ ---- 2 capacity (a power of 2), 3 keys, 4 values, 5 slot states         ---- }
{ ---- (0 empty, 1 live, 2 deleted).                                      ---- }
#type Dict Ptr end

#_dict_pow2 ( p:Int n:Int -- q:Int ) p n < cond [ p 2 * n _dict_pow2 ] else [ p ] end

#_dict_alloc ( c:Int -- d:Dict )
  6 hnew -> [ h ]
  h 0 0 hwrite
  h 1 0 hwrite
  h 2 c hwrite
  h 3 c hnew hwrite
  h 4 c hnew hwrite
  c hnew -> [ st ] st :ptr 0 :start c :count 0 :value hfill h 5 st hwrite
  h Dict_of
end

{ a new, empty Dict with room for about n keys before it grows }
#dict_new ( count:Int -- dict:Dict ) 8 count 2 * _dict_pow2 _dict_alloc end

#dict_len ( dict:Dict -- length:Int ) dict Dict_raw 0 hread end
#dict_cap ( dict:Dict -- capacity:Int ) dict Dict_raw 2 hread end
#_dict_used ( d:Dict -- n:Int ) d Dict_raw 1 hread end
#_dict_keys ( d:Dict -- p:Ptr ) d Dict_raw 3 hread end
#_dict_vals ( d:Dict -- p:Ptr ) d Dict_raw 4 hread end
#_dict_states ( d:Dict -- p:Ptr ) d Dict_raw 5 hread end

{ an element of a Block key: an integer as itself, a nested Block (a }
{ string or row field of a #struct) by its own hash, a float by its text }
#_dict_hash_elem ( c:Unknown -- x:Int )
  c type_of -> [ t ]
  t 0 = cond [ c ] else [ t 2 = cond [ c _dict_hash_str ] else [ c to_str _dict_hash_str ] ]
end

{ FNV-1a over a Block's elements: a string's characters, or a struct's fields }
#_dict_hash_str ( k:Block -- h:Int )
  k [fold| i h c _ | h c _dict_hash_elem bitxor 16777619 * 0xffffffff bitand from 2166136261 ]
end

{ an integer mixed so that near keys spread over the table }
#_dict_hash_int ( k:Int -- h:Int )
  k 0x7fffffff bitand k 31 bitshr 0x7fffffff bitand bitxor 2654435761 * 0x7fffffffffff bitand
end

#dict_hash ( key:Unknown -- hash:Int )
  key type_of -> [ t ]
  t 2 = cond [ key _dict_hash_str ]
  else [ t 0 = cond [ key _dict_hash_int ] else [ "dict: a key must be an integer, a string or another Block (a #struct)" abort ] ]
end

{ along the probe path from slot i: the slot holding k (found 1), or else }
{ the first deleted slot passed (free, -1 if none) or the empty one that  }
{ ends the path (found 0) }
#_dict_probe ( d:Dict k:Unknown i:Int free:Int -- s:Int found:Int )
  d _dict_states i hread -> [ st ]
  st 0 = cond [ free 0 < cond [ i ] else [ free ] 0 ]
  else [
    st 1 = and_then [ d _dict_keys i hread k = ]
    cond [ i 1 ]
    else [ d k i 1 + d dict_cap 1 - bitand :i st 2 = free 0 < and cond [ i ] else [ free ] :free _dict_probe ]
  ]
end

#_dict_slot ( d:Dict k:Unknown -- s:Int found:Int )
  d k k dict_hash d dict_cap 1 - bitand :i -1 :free _dict_probe
end

{ stores without growing }
#_dict_put ( d:Dict k:Unknown v:Unknown -- )
  d k _dict_slot -> [ s found ]
  d _dict_vals s v hwrite
  found unless [
    d _dict_keys s k hwrite
    d _dict_states s hread 0 = when [ d Dict_raw 1 d _dict_used 1 + hwrite ]
    d _dict_states s 1 hwrite
    d Dict_raw 0 d dict_len 1 + hwrite
  ]
end

{ before a store: rebuild into a table twice as big (or as big, when }
{ deleted slots fill it) once used slots would pass three quarters. The }
{ three arrays keep their slots (hresize, since v1.95), so a Dict made  }
{ before a region can grow inside it; the copy of the old entries is    }
{ released at the end }
#_dict_make_room ( d:Dict -- )
  d _dict_used 1 + 4 * d dict_cap 3 * > when [
    d dict_len 1 + 4 * d dict_cap 2 * > cond [ d dict_cap 2 * ] else [ d dict_cap ] -> [ c ]
    region [ d c _dict_rehash ]
  ]
end

#_dict_rehash ( d:Dict c:Int -- )
  d dict_cap -> [ n ]
  d _dict_keys n _dict_copy -> [ ks ]
  d _dict_vals n _dict_copy -> [ vs ]
  d _dict_states n _dict_copy -> [ st ]
  d c _dict_empty
  n [times| i | st i hread 1 = when [ d ks i hread vs i hread _dict_put ] ]
end

{ d with c slots, all empty }
#_dict_empty ( d:Dict c:Int -- )
  d _dict_keys c _dict_clear
  d _dict_vals c _dict_clear
  d _dict_states c _dict_clear
  d Dict_raw 0 0 hwrite
  d Dict_raw 1 0 hwrite
  d Dict_raw 2 c hwrite
end

{ a new array holding the first n cells of p }
#_dict_copy ( p:Ptr n:Int -- q:Ptr )
  n hnew -> [ q ]
  p :src 0 :soff q :dst 0 :doff n :count hmove
  q
end

{ p resized to c cells, every one 0 }
#_dict_clear ( p:Ptr c:Int -- )
  p c hresize
  p :ptr 0 :start c :count 0 :value hfill
end

#dict_set ( dict:Dict key:Unknown value:Unknown -- ) dict _dict_make_room dict key value _dict_put end

{ the value of k and 1, or 0 0 when k is absent }
#dict_find ( dict:Dict key:Unknown -- value:Unknown found:Int )
  dict key _dict_slot -> [ s found ]
  found cond [ dict _dict_vals s hread 1 ] else [ 0 0 ]
end

{ stops the program when k is absent; dict_find or dict_get_or when it may be }
#dict_get ( dict:Dict key:Unknown -- value:Unknown )
  dict key dict_find unless [ "dict_get: the key is not in the Dict" abort ]
end

#dict_get_or ( dict:Dict key:Unknown default:Unknown -- value:Unknown )
  dict key dict_find cond [ ] else [ drop default ]
end

#dict_has ( dict:Dict key:Unknown -- flag:Int ) dict key _dict_slot swap drop end

{ adds n to the number stored at k (0 when absent): counting }
#dict_add ( dict:Dict key:Unknown amount:Int -- ) dict key dict key 0 dict_get_or amount + dict_set end

{ removes k; 1 if it was there }
#dict_del ( dict:Dict key:Unknown -- found:Int )
  dict key _dict_slot -> [ s found ]
  found when [
    dict _dict_states s 2 hwrite
    dict _dict_keys s 0 hwrite
    dict _dict_vals s 0 hwrite
    dict Dict_raw 0 dict dict_len 1 - hwrite
  ]
  found
end

{ slot i, 0 <= i < dict_cap: its key and value and 1 when it holds one, }
{ else 0 0 0. To visit every entry: }
{ `d dict_cap [times| i | d i dict_slot -> [ k v live ] live when [ ... ] ]` }
#dict_slot ( dict:Dict index:Int -- key:Unknown value:Unknown live:Int )
  dict _dict_states index hread 1 = cond [ dict _dict_keys index hread dict _dict_vals index hread 1 ] else [ 0 0 0 ]
end

{ every key, in slot order (no particular order) }
#dict_keys ( dict:Dict -- keys:Block )
  nil dict dict_cap [times| i | dict i dict_slot -> [ k v live ] live cond [ k cons ] else [ ] ]
end
