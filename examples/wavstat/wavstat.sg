{ ---- wavstat: the format, length, peak and RMS level of each channel  ---- }
{ ---- of a 16-bit PCM WAV file, read as a stream. Bad input stops with  ---- }
{ ---- `wavstat: PATH: reason` and status 1. Built as DESIGN.md says:    ---- }
{ ---- one module per layer, each tested on its own.                     ---- }
{ ----                                                                   ---- }
{ ---- Build: compiler/scroogec_fast -L library -o wavstat examples/wavstat/wavstat.sg }
{ ---- Test:  compiler/scroogec_fast -L library --test --deep examples/wavstat/wavstat.sg }
{ ---- Run:   ./wavstat examples/wavstat/tone.wav                        ---- }
use "args"
use "strings"
use "err"
use "wav"
use "stats"

{ the samples now in the buffer (n bytes) into the accumulators }
#_add_buffer ( w:Wav a:Acc n:Int -- )
  w Wav_chans -> [ ch ]
  n 2 / [times| k | a :a k ch \ :c w k wav_sample :s acc_add ]
end

{ every sample of the file, a buffer at a time }
#_add_all ( w:Wav a:Acc -- )
  w wav_read -> [ n ]
  n 0 > when [ w a n _add_buffer w a _add_all ]
end

#_show_channel ( a:Acc c:Int -- )
  "channel " str_print c print_int
  ": peak " str_print a c acc_peak print_int
  ", rms " str_print a c acc_rms 4 print_float 10 print_char
end

#_show_format ( w:Wav frames:Int -- )
  w Wav_chans print_int " channels, " str_print w Wav_rate print_int " Hz, " str_print
  frames print_int " frames\n" str_print
end

#report ( w:Wav a:Acc frames:Int -- )
  w frames _show_format
  w Wav_chans [times| c | a c _show_channel ]
end

#_path ( -- path:Block )
  1 "" arg_or -> [ path ]
  path block_len 0 = when [ "usage" "wavstat FILE.wav" die ]
  path
end

#_open ( path:Block -- w:Wav )
  path wav_open -> [ w ]
  w Wav_chans ACC_MAX > when [ path "more than 8 channels" die ]
  w
end

#_frames ( w:Wav -- n:Int ) w Wav_left w Wav_chans 2 * / end

#main ( -- )
  _path _open -> [ w ]
  w _frames -> [ frames ]
  Acc_new -> [ a ]
  w a _add_all w wav_close
  w a frames report
end

main
