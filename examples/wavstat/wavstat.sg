{ ---- wavstat: the format, length, peak and RMS level of each channel  ---- }
{ ---- of a 16-bit PCM WAV file, read as a stream. Bad input stops with  ---- }
{ ---- `wavstat: PATH: reason` and status 1. Built as DESIGN.md says:    ---- }
{ ---- one module per layer, each tested on its own.                     ---- }
{ ----                                                                   ---- }
{ ---- Build: compiler/scroogec_fast -L library -o wavstat examples/wavstat/wavstat.sg }
{ ---- Test:  compiler/scroogec_fast -L library --test --deep examples/wavstat/wavstat.sg }
{ ---- Run:   ./wavstat examples/wavstat/tone.wav                        ---- }
use "args"
use "strings"
use "err"
use "wav"
use "stats"

{ the samples now in the buffer (nbytes bytes) into the accumulators }
#_add_buffer ( wav:Wav acc:Acc nbytes:Int -- )
  wav Wav_chans -> [ ch ]
  nbytes 2 / [times| k | acc k ch \ :channel wav k wav_sample :sample acc_add ]
end

{ every sample of the file, a buffer at a time }
#_add_all ( wav:Wav acc:Acc -- )
  wav wav_read -> [ n ]
  n 0 > when [ wav acc n _add_buffer wav acc _add_all ]
end

#_show_channel ( acc:Acc channel:Int -- )
  "channel " str_print channel print_int
  ": peak " str_print acc channel acc_peak print_int
  ", rms " str_print acc channel acc_rms 4 print_float 10 print_char
end

#_show_format ( wav:Wav frames:Int -- )
  wav Wav_chans print_int " channels, " str_print wav Wav_rate print_int " Hz, " str_print
  frames print_int " frames\n" str_print
end

#report ( wav:Wav acc:Acc frames:Int -- )
  wav frames _show_format
  wav Wav_chans [times| c | acc c _show_channel ]
end

#_path ( -- path:Block )
  1 "" arg_or -> [ path ]
  path block_len 0 = when [ "usage" "wavstat FILE.wav" die ]
  path
end

#_open ( path:Block -- wav:Wav )
  path wav_open -> [ w ]
  w Wav_chans ACC_MAX > when [ path "more than 8 channels" die ]
  w
end

#_frames ( wav:Wav -- frames:Int ) wav Wav_left wav Wav_chans 2 * / end

#main ( -- )
  _path _open -> [ w ]
  w _frames -> [ frames ]
  Acc_new -> [ a ]
  w a _add_all w wav_close
  w a frames report
end

main
