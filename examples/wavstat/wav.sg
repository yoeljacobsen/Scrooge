{ ---- wav: a PCM WAV file read as a stream. wav_open checks the RIFF   ---- }
{ ---- header, reads the `fmt ` chunk and stops at the start of the      ---- }
{ ---- `data` chunk, skipping any other chunk; wav_read then gives the   ---- }
{ ---- samples a buffer at a time. One record holds the state, and its   ---- }
{ ---- buffer is made once, so memory does not grow with the file.       ---- }
use "file"
use "util"
use "err"

{ the four-byte chunk ids, as bytes_le32 reads them }
#ID_RIFF ( -- id:Int ) 0x46464952 end
#ID_WAVE ( -- id:Int ) 0x45564157 end
#ID_FMT ( -- id:Int ) 0x20746D66 end
#ID_DATA ( -- id:Int ) 0x61746164 end

#wav_buf ( -- buf:Bytes ) 4096 bytes_new end

#record Wav
  path Block 1 nil
  fh File 1 f_stdin
  buf Bytes 1 wav_buf
  chans Int 1 0
  rate Int 1 0
  bits Int 1 0
  left Int 1 0
end

#_fail ( wav:Wav reason:Block -- ) wav Wav_path reason die end

{ count bytes (at most the buffer) into the buffer, or stop: the file is cut short }
#_read ( wav:Wav count:Int -- )
  wav Wav_fh :fh wav Wav_buf :array 0 :start count :count bytes_read -> [ got ]
  got count < when [ wav "the file ends too early" _fail ]
end

{ the Int at offset off of the buffer }
#_u32 ( wav:Wav off:Int -- value:Int ) wav Wav_buf off bytes_le32 end
#_u16 ( wav:Wav off:Int -- value:Int ) wav Wav_buf off bytes_le16 end

{ skip count bytes, a buffer at a time }
#_skip ( wav:Wav count:Int -- )
  count 0 > when [ count 4096 min -> [ k ] wav k _read wav count k - _skip ]
end

#_check_riff ( wav:Wav -- )
  wav 12 _read
  wav 0 _u32 ID_RIFF = wav 8 _u32 ID_WAVE = and not when [ wav "not a RIFF WAVE file" _fail ]
end

{ a chunk's body: size bytes and a pad byte when size is odd }
#_skip_body ( wav:Wav size:Int -- ) wav size size 1 bitand + _skip end

{ skip chunks up to the one with this id; its size }
#_find ( wav:Wav id:Int -- size:Int )
  wav 8 _read
  wav 4 _u32 -> [ size ]
  wav 0 _u32 id = cond [ size ] else [ wav size _skip_body wav id _find ] ?
end

#_check_pcm ( wav:Wav -- ) wav 0 _u16 1 = not when [ wav "not PCM (format tag is not 1)" _fail ] end
#_check_bits ( wav:Wav -- ) wav Wav_bits 16 = not when [ wav "only 16-bit samples are read" _fail ] end
#_check_chans ( wav:Wav -- ) wav Wav_chans 0 = when [ wav "no channels" _fail ] end

{ the fields of the 16 bytes of a `fmt ` chunk in the buffer }
#_fmt_fields ( wav:Wav -- )
  wav _check_pcm
  wav wav 2 _u16 Wav_chans_set
  wav wav 4 _u32 Wav_rate_set
  wav wav 14 _u16 Wav_bits_set
  wav _check_bits wav _check_chans
end

#_read_fmt ( wav:Wav -- )
  wav ID_FMT _find -> [ size ]
  size 16 < when [ wav "the fmt chunk is too short" _fail ]
  wav 16 _read wav _fmt_fields
  wav size 16 - _skip_body
end

#_open ( path:Block -- fh:File )
  path f_open_read -> [ fh ok ]
  ok not when [ path "cannot open the file" die ]
  fh
end

{ the open file, at the first sample }
#wav_open ( path:Block -- wav:Wav )
  Wav_new -> [ w ]
  w path Wav_path_set
  w path _open Wav_fh_set
  w _check_riff w _read_fmt
  w w ID_DATA _find Wav_left_set
  w
end

{ the bytes of the next samples, into the buffer: how many (0 at the end); }
{ always whole frames }
#wav_read ( wav:Wav -- count:Int )
  wav Wav_chans 2 * -> [ frame ]
  wav Wav_left 4096 frame / frame * min -> [ n ]
  wav n _read
  wav wav Wav_left n - Wav_left_set
  n
end

{ sample index (0-based) of the buffer, a signed 16-bit value }
#wav_sample ( wav:Wav index:Int -- sample:Int )
  wav index 2 * _u16 -> [ u ]
  u 32768 < cond [ u ] else [ u 65536 - ] ?
end

#wav_close ( wav:Wav -- ) wav Wav_fh fclose drop end

{ ---- test files: each test writes the WAV file it reads, so the tests ---- }
{ ---- run from any directory and say what is in the file.              ---- }
#TEST_WAV ( -- path:Block ) "/tmp/wavstat_test.wav" end

#_put16 ( array:Bytes index:Int value:Int -- ) array index value 255 bitand bytes_set array index 1 + value 8 bitshr bytes_set end
#_put32 ( array:Bytes index:Int value:Int -- ) array index value 65535 bitand _put16 array index 2 + value 16 bitshr _put16 end

{ the RIFF header (its first id given, to make a file that is not a WAV) }
#_riff ( array:Bytes id:Int size:Int -- ) array 0 id _put32 array 4 size 36 + _put32 array 8 ID_WAVE _put32 end

{ PCM, 2 channels, 8000 Hz, 16 bits }
#_fmt ( array:Bytes -- ) array 12 ID_FMT _put32 array 16 16 _put32 array 20 1 _put16 array 22 2 _put16 array _rate end
#_rate ( array:Bytes -- ) array 24 8000 _put32 array 28 32000 _put32 array 32 4 _put16 array 34 16 _put16 end

{ size data bytes: every frame is left 16384, right 8192 }
#_data ( array:Bytes size:Int -- )
  array 36 ID_DATA _put32 array 40 size _put32
  size 4 / [times| k | array 44 k 4 * + _frame ]
end
#_frame ( array:Bytes off:Int -- ) array off 16384 _put16 array off 2 + 8192 _put16 end

{ a file of size data bytes, of which only the first keep bytes are written }
#_test_file ( id:Int size:Int keep:Int -- )
  size 44 + bytes_new -> [ a ]
  a id size _riff a _fmt a size _data
  a keep _save
end
#_save ( array:Bytes keep:Int -- )
  TEST_WAV f_open_write -> [ fh ok ]
  fh array 0 :start keep :count bytes_write drop
  fh fclose drop
end

#test_open ( -- ok:Int )
  ID_RIFF 3200 3244 _test_file
  TEST_WAV wav_open -> [ w ]
  w Wav_chans 2 "channels" expect_eq
  w Wav_rate 8000 "rate" expect_eq and
  w Wav_left 3200 "data bytes" expect_eq and
  w wav_close
end

#test_read ( -- ok:Int )
  ID_RIFF 3200 3244 _test_file
  TEST_WAV wav_open -> [ w ]
  w wav_read 3200 "one buffer holds it all" expect_eq
  w 1 wav_sample 8192 "first right sample" expect_eq and
  w wav_read 0 "then the end" expect_eq and
  w wav_close
end

#test_not_wav ( -- ok:Int )
  "not a RIFF WAVE file" expect_stop
  ID_DATA 3200 3244 _test_file
  TEST_WAV wav_open drop 1
end

#test_cut ( -- ok:Int )
  "the file ends too early" expect_stop
  ID_RIFF 3200 1000 _test_file
  TEST_WAV wav_open wav_read drop 1
end

#test_missing ( -- ok:Int ) "cannot open the file" expect_stop "/nonexistent/none.wav" wav_open drop 1 end
