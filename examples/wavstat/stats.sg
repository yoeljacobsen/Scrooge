{ ---- stats: the peak and the RMS level of each channel, accumulated   ---- }
{ ---- one sample at a time. Up to ACC_MAX channels.                     ---- }
use "util"

#ACC_MAX ( -- limit:Int ) 8 end

#record Acc
  peak Int 8 0
  sq Float 8 0.0
  count Int 8 0
end

#_abs ( sample:Int -- magnitude:Int ) sample 0 < cond [ 0 sample - ] else [ sample ] ? end

#_add_peak ( acc:Acc channel:Int magnitude:Int -- ) magnitude acc channel Acc_peak > when [ acc channel magnitude Acc_peak_set ] end

#_add_square ( acc:Acc channel:Int value:Float -- ) acc channel acc channel Acc_sq value value * + Acc_sq_set end

{ one sample of a channel }
#acc_add ( acc:Acc channel:Int sample:Int -- )
  acc channel sample _abs _add_peak
  acc channel sample to_float _add_square
  acc channel acc channel Acc_count 1 + Acc_count_set
end

#acc_peak ( acc:Acc channel:Int -- peak:Int ) acc channel Acc_peak end

{ the RMS of a channel as a fraction of full scale (32768), 0.0 for no samples }
#acc_rms ( acc:Acc channel:Int -- rms:Float )
  acc channel Acc_count -> [ n ]
  n 0 = cond [ 0.0 ] else [ acc channel Acc_sq n to_float / sqrt 32768.0 / ] ?
end

#test_peak ( -- ok:Int )
  Acc_new -> [ a ]
  a 0 5 acc_add a 0 -9 acc_add a 1 3 acc_add
  a 0 acc_peak 9 "peak of a negative sample" expect_eq
  a 1 acc_peak 3 "the other channel" expect_eq and
end

#test_rms ( -- ok:Int )
  Acc_new -> [ a ]
  a 0 16384 acc_add a 0 -16384 acc_add
  a 0 acc_rms :got 0.5 :want 1e-12 :tol "half scale" :msg expect_near
  a 1 acc_rms :got 0.0 :want 0.0 :tol "no samples" :msg expect_near and
end
