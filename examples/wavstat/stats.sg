{ ---- stats: the peak and the RMS level of each channel, accumulated   ---- }
{ ---- one sample at a time. Up to ACC_MAX channels.                     ---- }
use "util"

#ACC_MAX ( -- n:Int ) 8 end

#record Acc
  peak Int 8 0
  sq Float 8 0.0
  count Int 8 0
end

#_abs ( s:Int -- a:Int ) s 0 < cond [ 0 s - ] else [ s ] ? end

#_add_peak ( a:Acc c:Int m:Int -- ) m a c Acc_peak > when [ a c m Acc_peak_set ] end

#_add_square ( a:Acc c:Int x:Float -- ) a c a c Acc_sq x x * + Acc_sq_set end

{ one sample s of channel c }
#acc_add ( a:Acc c:Int s:Int -- )
  a c s _abs _add_peak
  a c s to_float _add_square
  a c a c Acc_count 1 + Acc_count_set
end

#acc_peak ( a:Acc c:Int -- p:Int ) a c Acc_peak end

{ the RMS of channel c as a fraction of full scale (32768), 0.0 for no samples }
#acc_rms ( a:Acc c:Int -- r:Float )
  a c Acc_count -> [ n ]
  n 0 = cond [ 0.0 ] else [ a c Acc_sq n to_float / sqrt 32768.0 / ] ?
end

#test_peak ( -- ok:Int )
  Acc_new -> [ a ]
  a 0 5 acc_add a 0 -9 acc_add a 1 3 acc_add
  a 0 acc_peak 9 "peak of a negative sample" expect_eq
  a 1 acc_peak 3 "the other channel" expect_eq and
end

#test_rms ( -- ok:Int )
  Acc_new -> [ a ]
  a 0 16384 acc_add a 0 -16384 acc_add
  a 0 acc_rms :got 0.5 :want 1e-12 :tol "half scale" :msg expect_near
  a 1 acc_rms :got 0.0 :want 0.0 :tol "no samples" :msg expect_near and
end
