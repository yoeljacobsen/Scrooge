{ ---- matvec: y = W x for a matrix W of rows x cols floats, stored row  ---- }
{ ---- after row in one Floats array. Two kernels: a counted loop over    ---- }
{ ---- floats_get, and floats_dot, which does one row in C. They give    ---- }
{ ---- the same y; the program times both, passing the kernel as a word. ---- }
{ ---- Allocation happens once, outside the loops.                       ---- }
{ ----                                                                   ---- }
{ ---- Build: compiler/scroogec_fast -L library -o matvec examples/matvec/matvec.sg }
{ ---- Test:  compiler/scroogec_fast -L library --test examples/matvec/matvec.sg }
{ ---- Run:   ./matvec [-n 512]                                          ---- }
use "args"
use "strings"
use "util"

#mk_floats ( -- empty:Floats ) 0 floats_new end

#record Mat
  rows Int 1 0
  cols Int 1 0
  w Floats 1 mk_floats
end

#mat_new ( rows:Int cols:Int -- mat:Mat )
  Mat_new -> [ m ]
  m rows Mat_rows_set m cols Mat_cols_set
  m rows cols * floats_new Mat_w_set m
end

{ ---- the two kernels ---- }

{ row index of W times input, one element at a time }
#_row_loop ( mat:Mat input:Floats index:Int -- dot:Float )
  mat Mat_w -> [ w ] index mat Mat_cols * -> [ base ]
  0.0 mat Mat_cols [times| j | w base j + floats_get input j floats_get * + ]
end

{ row index of W times input, with the library's dot product }
#_row_dot ( mat:Mat input:Floats index:Int -- dot:Float )
  mat Mat_w :left index mat Mat_cols * :loff input :right 0 :roff mat Mat_cols :count floats_dot
end

{ y = W x with either kernel: the row word is passed                 }
{ (`mat input output '_row_dot matvec`), and each word passed compiles }
{ its own copy, so passing costs nothing                               }
#matvec ( mat:Mat input:Floats output:Floats row:Word(Mat,Floats,Int--Float) -- )
  mat Mat_rows [times| r | output r mat input r row floats_set ]
end

{ ---- data and checks ---- }

{ a fixed pattern, so every run is the same: (i mod 7 - 3) / 4 }
#fill ( values:Floats -- )
  values floats_len [times| i | values i i 7 \ 3 - to_float 4.0 / floats_set ]
end

#_close ( y1:Floats y2:Floats index:Int -- agree:Int ) y1 index floats_get y2 index floats_get - abs 0.000001 < end

#same ( y1:Floats y2:Floats -- agree:Int ) 1 y1 floats_len [times| i | y1 y2 i _close and ] end

{ W = [ 1 0 2 ; 0 3 0 ] }
#_small ( -- mat:Mat )
  2 3 mat_new -> [ m ] m Mat_w -> [ w ]
  w 0 1.0 floats_set w 2 2.0 floats_set w 4 3.0 floats_set m
end

#_ones ( count:Int -- ones:Floats ) count floats_new -> [ v ] v 0 :start count :count 1.0 :value floats_fill v end

#_near ( got:Float want:Float msg:Block -- ok:Int ) got want 0.000001 :tol msg expect_near end

#test_small ( -- ok:Int )
  2 floats_new -> [ y ] _small 3 _ones y '_row_dot matvec
  y 0 floats_get 3.0 "row 0: 1 + 2" _near
  y 1 floats_get 3.0 "row 1: 3" _near and
end

{ a filled size x size matrix and vector, and room for the output }
#_case ( size:Int -- mat:Mat input:Floats output:Floats )
  size size mat_new -> [ m ] m Mat_w fill
  size floats_new -> [ x ] x fill
  m x size floats_new
end

#test_same ( -- ok:Int )
  5 _case -> [ mat input y1 ] 5 floats_new -> [ y2 ]
  mat input y1 '_row_loop matvec mat input y2 '_row_dot matvec
  y1 y2 same 1 "both kernels agree" expect_eq
end

{ ---- timing ---- }

#_ms ( t0:Int -- ms:Float ) clock_ns t0 - to_float 1000000.0 / end

{ 20 products with one kernel, and the time they took }
#_time ( mat:Mat input:Floats output:Floats row:Word(Mat,Floats,Int--Float) -- ms:Float )
  clock_ns -> [ t0 ]
  20 [times| k | mat input output 'row matvec ]
  t0 _ms
end

#_show ( name:Block ms:Float -- ) name str_print ms 1 print_float " ms for 20 products" str_print 10 print_char end

#_value ( name:Block value:Float -- ) name str_print value 4 print_float 10 print_char end

#main ( -- )
  "-n" 512 arg_int_or _case -> [ mat input output ]
  "loop " mat input output '_row_loop _time _show
  "dot  " mat input output '_row_dot _time _show
  "y[1] = " output 1 floats_get _value
end
main
