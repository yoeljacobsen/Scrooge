{ ---- colstats: count, mean, standard deviation, min, max and median of ---- }
{ ---- a file of integers, one per line. A program built from small words ---- }
{ ---- in two modules, each word tested on its own (stats.sg).            ---- }
{ ----                                                                    ---- }
{ ---- Build: compiler/scroogec_fast -L library -o colstats examples/colstats/colstats.sg }
{ ---- Test:  compiler/scroogec_fast -L library --test examples/colstats/stats.sg        }
{ ---- Run:   ./colstats numbers.txt                                      ---- }
use "args"
use "strings"
use "readnums"
use "stats"

#show ( label:Block value:Scalar -- ) label str_print value 3 print_float 10 print_char end
#show_int ( label:Block value:Int -- ) label str_print value print_int 10 print_char end

#report ( cells:Ptr count:Int -- )
  "count   " count show_int
  "mean    " cells count st_mean show
  "sd      " cells count st_sd show
  "min     " cells count st_min show
  "max     " cells count st_max show
  "median  " cells count st_median show
end

#main ( -- )
  1 "" arg_or rn_read -> [ p n ok ]
  ok not cond [ "colstats: cannot read the file" abort ] ?
  n 0 = cond [ "colstats: the file has no integers" abort ] ?
  p n report
end
main
