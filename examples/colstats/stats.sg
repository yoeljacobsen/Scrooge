{ ---- stats: summary statistics of the count numbers in heap cells     ---- }
{ ---- cells[0..count), count >= 1. One job per word; the #test_ words  ---- }
{ ---- below check each one on an input worked out by hand. Run them with ---- }
{ ----   compiler/scroogec_fast -L library --test examples/colstats/stats.sg ---- }
use "numeric"
use "util"

#st_mean ( cells:Ptr count:Int -- mean:Float ) cells 0 count vec_sum to_float count to_float / end

{ the squared deviation of value from mean }
#_sq_dev ( value:Float mean:Float -- square:Float ) value mean - -> [ d ] d d * end

{ population variance: the mean squared deviation from the mean }
#st_var ( cells:Ptr count:Int -- variance:Float )
  cells count st_mean -> [ m ]
  0.0 count [times| i | cells i hread m _sq_dev + ] count to_float /
end

#st_sd ( cells:Ptr count:Int -- sd:Float ) st_var sqrt end
{ one loop, two uses: `pick` is a word parameter, so st_min and st_max }
{ share the loop instead of copying it (each compiles to its own word) }
#_reduce ( cells:Ptr count:Int pick:Word(Scalar,Scalar--Scalar) -- result:Scalar )
  cells 0 hread count [times| i | cells i hread pick ]
end
#st_min ( cells:Ptr count:Int -- least:Scalar ) 'min _reduce end
#st_max ( cells:Ptr count:Int -- greatest:Scalar ) 'max _reduce end

{ a sorted copy, so the median leaves the caller's cells as they were }
#_sorted_copy ( cells:Ptr count:Int -- copy:Ptr ) count hnew -> [ q ] cells :src 0 :soff q :dst 0 :doff count :count hmove q 0 count hsort q end

{ the middle of count sorted values: the middle one, or the mean of the two middle ones }
#_middle ( sorted:Ptr count:Int -- median:Scalar )
  count 2 / -> [ h ]
  count 2 \ 1 = cond [ sorted h hread ] else [ sorted h 1 - hread sorted h hread + 2.0 / ] ?
end

#st_median ( cells:Ptr count:Int -- median:Scalar ) cells count _sorted_copy count _middle end

{ ---- tests ---- }
{ 2 4 4 4 5 5 7 9: mean 5, variance 4, sd 2, median 4.5, min 2, max 9 }
#_sample ( -- cells:Ptr count:Int )
  [ 2 4 4 4 5 5 7 9 ] 8 hnew -> [ vals p ]
  vals [fold| i acc v _ | p i v hwrite acc from 0 ] drop p 8
end
#test_sq_dev ( -- ok:Int ) 7.0 5.0 _sq_dev 4.0 "7 5 _sq_dev" expect_eq end
#test_mean ( -- ok:Int ) _sample st_mean :got 5.0 :want 0.000001 :tol "mean" :msg expect_near end
#test_var ( -- ok:Int ) _sample st_var :got 4.0 :want 0.000001 :tol "variance" :msg expect_near end
#test_sd ( -- ok:Int ) _sample st_sd :got 2.0 :want 0.000001 :tol "sd" :msg expect_near end
#test_min_max ( -- ok:Int ) _sample st_min 2 "min" expect_eq _sample st_max 9 "max" expect_eq and end
#test_median_even ( -- ok:Int ) _sample st_median :got 4.5 :want 0.000001 :tol "median of 8 values" :msg expect_near end
#test_median_odd ( -- ok:Int )
  3 hnew -> [ p ] p 0 9 hwrite p 1 1 hwrite p 2 5 hwrite
  p 3 st_median 5 "median of 9 1 5" expect_eq p 0 hread 9 "the input is left unsorted" expect_eq and
end
