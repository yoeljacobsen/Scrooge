{ ---- readnums: the integers in a text file, one per line, into heap     ---- }
{ ---- cells. Lines that are not an integer (blank, a header) are skipped. ---- }
use "file"
use "strings"

#_parse ( line:Block -- value:Int ok:Int ) line 0 line block_len str_to_int end

{ the number of lines left in fh }
#_count_loop ( fh:File seen:Int -- total:Int )
  fh freadline -> [ line got ]
  got cond [ fh seen 1 + _count_loop ] else [ seen ] ?
end

{ parse the lines left in fh into cells[index..]; the number of cells filled }
#_fill_loop ( fh:File cells:Ptr index:Int -- filled:Int )
  fh freadline -> [ line got ]
  got not cond [ index ] else [
    line _parse -> [ v ok ]
    ok cond [ cells index v hwrite fh cells index 1 + _fill_loop ] else [ fh cells index _fill_loop ] ?
  ] ?
end

#_line_count ( path:Block -- lines:Int ) f_open_read -> [ fh ok ] fh 0 _count_loop fh fclose drop end

#_fill ( path:Block count:Int -- cells:Ptr filled:Int )
  count hnew -> [ p ] path f_open_read -> [ fh ok ] fh p 0 _fill_loop fh fclose drop -> [ k ] p k
end

{ the numbers in the file at path: cells, how many, and whether the file could be read }
#rn_read ( path:Block -- cells:Ptr count:Int ok:Int )
  path f_open_read -> [ fh ok ] fh fclose drop
  ok cond [ path path _line_count _fill 1 ] else [ hnull 0 0 ] ?
end
