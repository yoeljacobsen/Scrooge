{ ---- tokens: split a line of arithmetic into numbers, names and        ---- }
{ ---- operators. A token is a kind, a start and a length in the text;   ---- }
{ ---- the tokens are kept in three Ints arrays of one record, so the    ---- }
{ ---- text is never copied. Each word reads one kind of token.          ---- }
{ ----                                                                   ---- }
{ ---- Build: compiler/scroogec_fast -L library -o tokens examples/tokens/tokens.sg }
{ ---- Test:  compiler/scroogec_fast -L library --test examples/tokens/tokens.sg }
{ ---- Run:   ./tokens "rate = 42 * (x1 - 7)"                            ---- }
use "args"
use "strings"
use "util"

#enum Kind number word op end

#TOK_MAX ( -- limit:Int ) 256 end
#mk_ints ( -- slots:Ints ) TOK_MAX ints_new end

#record Toks
  text Block 1 nil
  kind Ints 1 mk_ints
  start Ints 1 mk_ints
  len Ints 1 mk_ints
  n Int 1 0
end

{ the character at pos, or 0 past the end }
#_ch ( toks:Toks pos:Int -- char:Int )
  toks Toks_text -> [ s ]
  pos s block_len < cond [ s pos block_get ] else [ 0 ] ?
end

#_is_name ( char:Int -- flag:Int ) char is_lower char is_upper or char '_' = or end

{ how many characters from pos belong to a token of this kind }
#_run ( toks:Toks pos:Int kind:Kind -- length:Int )
  toks Toks_text block_len pos - -> [ left ]
  left [find| j | toks pos j + kind _ends ] left _or_all
end

{ whether the character at pos ends a token of this kind }
#_ends ( toks:Toks pos:Int kind:Kind -- flag:Int ) toks pos _ch kind _stops end

{ the place found, or all of them when none was (-1) }
#_or_all ( found:Int all:Int -- length:Int ) found 0 < cond [ all ] else [ found ] ? end

#_stops ( char:Int kind:Kind -- flag:Int )
  kind Kind_number = cond [ char is_digit not ] else [ char _is_name char is_digit or not ] ?
end

{ record one token }
#_add ( toks:Toks kind:Kind pos:Int length:Int -- )
  toks Toks_n -> [ slot ]
  slot TOK_MAX >= when [ "too many tokens" abort ]
  toks slot kind pos length _put
  toks slot 1 + Toks_n_set
end

#_put ( toks:Toks slot:Int kind:Kind pos:Int length:Int -- )
  toks Toks_kind slot kind Kind_raw ints_set toks Toks_start slot pos ints_set toks Toks_len slot length ints_set
end

{ the kind of token that starts with char }
#_kind ( char:Int -- kind:Kind ) char is_digit cond [ Kind_number ] else [ char _is_name cond [ Kind_word ] else [ Kind_op ] ? ] ? end

{ the token at pos (not a space): its length }
#_one ( toks:Toks pos:Int -- length:Int )
  toks pos _ch _kind -> [ kind ]
  kind Kind_op = cond [ 1 ] else [ toks pos kind _run ] ?
  -> [ length ] toks kind pos length _add length
end

{ every token of the text, from pos }
#_scan ( toks:Toks pos:Int -- )
  pos toks Toks_text block_len < when [
    toks pos _ch is_space cond [ 1 ] else [ toks pos _one ] ?
    -> [ m ] toks pos m + _scan
  ]
end

#tokenize ( text:Block -- toks:Toks ) Toks_new -> [ t ] t text Toks_text_set t 0 _scan t end

{ the kind of token index, and its text }
#tok_kind ( toks:Toks index:Int -- kind:Kind ) toks Toks_kind index ints_get Kind_of end
#tok_text ( toks:Toks index:Int -- text:Block )
  toks Toks_text toks Toks_start index ints_get toks Toks_len index ints_get block_slice
end

#show ( toks:Toks -- )
  toks Toks_n [times| k |
    toks k tok_kind Kind_name str_print 32 print_char
    toks k tok_text str_print 10 print_char
  ]
end

#test_kinds ( -- ok:Int )
  "ab1 = 42*(x - 7)" tokenize -> [ t ]
  t Toks_n 9 "nine tokens" expect_eq
  t 0 tok_kind Kind_raw Kind_word Kind_raw "a word" expect_eq and
  t 2 tok_kind Kind_raw Kind_number Kind_raw "then a number" expect_eq and
end

#test_text ( -- ok:Int )
  "ab1 = 42*(x - 7)" tokenize -> [ t ]
  t 0 tok_text "ab1" "a word with a digit" expect_eq
  t 2 tok_text "42" "a number" expect_eq and
  t 8 tok_text ")" "the last token" expect_eq and
end

#test_empty ( -- ok:Int ) "   " tokenize Toks_n 0 "only spaces: no token" expect_eq end

#main ( -- ) 1 "a + 1" arg_or tokenize show end
main
