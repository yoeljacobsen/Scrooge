#is_ws ( scalar -- scalar )
  -> [ ch ]
  ch 32 = ch 10 = or ch 13 = or ch 9 = or
end

#skip_ws ( block scalar -- scalar )
  -> [ s i ]
  i s len < [ s i skip_ws_inside ] else [ i ] ?
end

#skip_ws_inside ( block scalar -- scalar )
  -> [ s i ]
  s i : is_ws [ s i 1 + skip_ws ] else [ i ] ?
end

#skip_hspaces ( block scalar -- scalar )
  -> [ s i ]
  i s len < [ s i skip_hspaces_check ] else [ i ] ?
end

#skip_hspaces_check ( block scalar -- scalar )
  -> [ s i ]
  s i : -> [ ch ]
  ch 32 = ch 9 = or [ s i 1 + skip_hspaces ] else [ i ] ?
end

#is_def ( block scalar -- scalar )
  -> [ s i ]
  i 3 + s len <= [ s i is_def_chars ] else [ 0 ] ?
end

#is_def_chars ( block scalar -- scalar )
  -> [ s i ]
  s i : 100 = s i 1 + : 101 = and s i 2 + : 102 = and
end

#find_next_line ( block scalar -- scalar )
  -> [ s i ]
  i s len < [ s i find_next_line_step ] else [ i ] ?
end

#find_next_line_step ( block scalar -- scalar )
  -> [ s i ]
  s i : 10 = [ i 1 + ] else [ s i 1 + find_next_line ] ?
end

#parse_term ( scalar ptr scalar -- )
  -> [ i p last_f ]
  last_f 0 >= [ i p last_f set_f_end ] else [ ] ?
end

#set_f_end ( scalar ptr scalar -- )
  -> [ i p last_f ]
  i p last_f 97 - 90 + hwrite
end

#parse_loop ( block scalar ptr scalar -- scalar )
  -> [ s i p last_f ]
  i s len >= [ i p last_f parse_term i ] [ s i p last_f parse_step ] ?
end

#parse_step ( block scalar ptr scalar -- scalar )
  -> [ s i p last_f ]
  s i : 10 = s i : 13 = or [ s i 1 + p last_f parse_loop ] else [ s i p last_f parse_content ] ?
end

#parse_content ( block scalar ptr scalar -- scalar )
  -> [ s i p last_f ]
  s i skip_hspaces -> [ i2 ]
  i i2 = [ s i2 p last_f parse_zero_indent ] else [ s i2 p last_f parse_indented ] ?
end

#parse_zero_indent ( block scalar ptr scalar -- scalar )
  -> [ s i p last_f ]
  s i is_def [ s i p last_f parse_def_line ] else [ i p last_f parse_main_line ] ?
end

#parse_main_line ( scalar ptr scalar -- scalar )
  -> [ i p last_f ]
  i p last_f parse_term
  i
end

#parse_def_line ( block scalar ptr scalar -- scalar )
  -> [ s i p last_f ]
  i p last_f parse_term
  s i 3 + skip_hspaces -> [ i2 ]
  s i2 : -> [ f_char ]
  1 p f_char 97 - 30 + hwrite
  s i2 1 + skip_hspaces -> [ i3 ]
  s i3 1 + skip_hspaces -> [ i4 ]
  s i4 : -> [ arg_char ]
  arg_char p f_char 97 - 120 + hwrite
  s i4 1 + skip_hspaces -> [ i5 ]
  s i5 1 + skip_hspaces -> [ i6 ]
  i6 1 + -> [ body_start ]
  body_start p f_char 97 - 60 + hwrite
  s body_start p f_char parse_loop
end

#parse_indented ( block scalar ptr scalar -- scalar )
  -> [ s i p last_f ]
  s i find_next_line -> [ i2 ]
  s i2 p last_f parse_loop
end

#fetch_num ( block scalar -- scalar scalar )
  0 $ parse_num_loop
end

#parse_num_loop ( block scalar scalar -- scalar scalar )
  -> [ s acc i ]
  i s len < [ s acc i parse_num_check ] else [ acc i ] ?
end

#parse_num_check ( block scalar scalar -- scalar scalar )
  -> [ s acc i ]
  s i : -> [ ch ]
  ch 48 >= ch 57 <= and [ s acc i do_parse_digit ] else [ acc i ] ?
end

#do_parse_digit ( block scalar scalar -- scalar scalar )
  -> [ s acc i ]
  s i : 48 - -> [ digit ]
  s acc 10 * digit + i 1 + parse_num_loop
end

#fetch_var ( block scalar ptr -- scalar scalar )
  -> [ s i p ]
  s i : 97 - -> [ var_idx ]
  p 400 hread 1 + var_idx + -> [ addr ]
  p addr hread -> [ val ]
  val i 1 +
end

#fetch_value ( block scalar ptr -- scalar scalar )
  -> [ s i p ]
  s i skip_ws -> [ i2 ]
  s i2 : -> [ ch ]
  ch 97 >= ch 122 <= and [ s i2 p fetch_var ] else [ s i2 fetch_num ] ?
end

#append_char ( scalar ptr -- )
  -> [ ch p ]
  p 150 hread -> [ len ]
  ch p 151 len + hwrite
  len 1 + p 150 hwrite
end

#append_int_rec ( scalar ptr -- )
  -> [ v p ]
  v 0 > [ v p do_append_int_step ] else [ ] ?
end

#do_append_int_step ( scalar ptr -- )
  -> [ v p ]
  v 10 \ -> [ digit ]
  v 10 / p append_int_rec
  digit 48 + p append_char
end

#append_stdout ( scalar ptr -- )
  -> [ val p ]
  val 0 < [ 45 p append_char 0 val - ] else [ val ] ? -> [ v2 ]
  v2 0 = [ 48 p append_char ] else [ v2 p append_int_rec ] ?
  10 p append_char
end

#hwrite_var ( scalar scalar ptr -- )
  -> [ val var_idx p ]
  p 400 hread 1 + var_idx + -> [ addr ]
  val p addr hwrite
end

#do_binop ( block scalar scalar scalar scalar ptr -- )
  -> [ s i end_i val1 var_idx p ]
  s i : -> [ op ]
  s i 1 + skip_hspaces -> [ i2 ]
  s i2 p fetch_value -> [ val2 i3 ]
  op 43 = [ val1 val2 + ] else [ val1 val2 - ] ? -> [ res ]
  res var_idx p hwrite_var
  s i3 end_i p interpret_step
end

#do_assign_ops ( block scalar scalar scalar scalar ptr -- )
  -> [ s i end_i val1 var_idx p ]
  s i : -> [ op ]
  op 43 = op 45 = or [ s i end_i val1 var_idx p do_binop ] else [ val1 var_idx p hwrite_var s i end_i p interpret_step ] ?
end

#do_assign ( block scalar scalar ptr -- )
  -> [ s i end_i p ]
  s i : 97 - -> [ var_idx ]
  s i 1 + skip_hspaces -> [ i2 ]
  s i2 1 + skip_hspaces -> [ i3 ]
  s i3 p fetch_value -> [ val1 i4 ]
  s i4 skip_hspaces -> [ i5 ]
  i5 end_i < [ s i5 end_i val1 var_idx p do_assign_ops ] else [ val1 var_idx p hwrite_var s i5 end_i p interpret_step ] ?
end

#do_print ( block scalar scalar ptr -- )
  -> [ s i end_i p ]
  s i 5 + skip_hspaces -> [ i2 ]
  s i2 : 40 = [ i2 1 + ] else [ i2 ] ? -> [ i3 ]
  s i3 skip_hspaces -> [ i4 ]
  s i4 p fetch_value -> [ val next_i ]
  val p append_stdout
  s next_i skip_hspaces -> [ i5 ]
  s i5 : 41 = [ i5 1 + ] else [ i5 ] ? -> [ i6 ]
  s i6 end_i p interpret_step
end

#do_call_stmt ( block scalar scalar ptr -- )
  -> [ s i end_i p ]
  s i : -> [ f_char ]
  s i 1 + skip_hspaces -> [ i2 ]
  s i2 1 + skip_hspaces -> [ i3 ]
  s i3 p fetch_value -> [ arg_val i4 ]
  s i4 skip_hspaces -> [ i5 ]
  i5 1 + -> [ next_i ]
  p 400 hread -> [ old_csp ]
  old_csp 30 + -> [ new_csp ]
  new_csp p 400 hwrite
  p f_char 97 - 120 + hread -> [ arg_char ]
  arg_val new_csp 1 + arg_char 97 - + p $ hwrite
  p f_char 97 - 60 + hread -> [ b_start ]
  p f_char 97 - 90 + hread -> [ b_end ]
  s b_start b_end p interpret_step
  old_csp p 400 hwrite
  s next_i end_i p interpret_step
end

#do_assign_or_call ( block scalar scalar ptr -- )
  -> [ s i end_i p ]
  s i 1 + skip_hspaces -> [ i2 ]
  s i2 : 61 = [ s i end_i p do_assign ] else [ s i end_i p do_call_stmt ] ?
end

#interpret_stmt ( block scalar scalar ptr -- )
  -> [ s i end_i p ]
  s i : 112 = [ s i end_i p do_print ] else [ s i end_i p do_assign_or_call ] ?
end

#interpret_step ( block scalar scalar ptr -- )
  -> [ s i end_i p ]
  s i skip_ws -> [ i2 ]
  i2 end_i < [ s i2 end_i p interpret_stmt ] else [ ] ?
end

#do_build_stdout_step ( ptr scalar scalar -- block )
  -> [ p idx end_idx ]
  p 151 idx + hread -> [ ch ]
  p idx 1 + end_idx build_stdout_rec -> [ rest ]
  ch rest cons
end

#build_stdout_rec ( ptr scalar scalar -- block )
  -> [ p idx end_idx ]
  idx end_idx <= [ p idx end_idx do_build_stdout_step ] else [ nil ] ?
end

#build_stdout_block ( ptr -- block )
  -> [ p ]
  p 150 hread -> [ len ]
  p 0 len 1 - build_stdout_rec
end

#do_init_cell ( ptr scalar scalar -- )
  -> [ p idx end_idx ]
  0 p idx hwrite
  p idx 1 + end_idx init_heap_cells
end

#init_heap_cells ( ptr scalar scalar -- )
  -> [ p idx end_idx ]
  idx end_idx < [ p idx end_idx do_init_cell ] else [ ] ?
end

#run_python ( block -- block )
  -> [ s ]
  1000 hnew -> [ p ]
  p 0 1000 init_heap_cells
  0 p 150 hwrite
  500 p 400 hwrite
  s 0 p -1 parse_loop -> [ main_start ]
  s main_start s len p interpret_step
  p build_stdout_block
end
