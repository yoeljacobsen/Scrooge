#row ( i -- r ) 9 / end
#col ( i -- c ) 9 \ end
#box ( i -- b ) . 9 / 3 / 3 * $ 9 \ 3 / + end

#is_valid ( board idx val -- bool )
nil cons cons $ [fold| i a v c | 0 a v c 1 : = i c 0 : != and i row c 0 : row = i col c 0 : col = or i box c 0 : box = or and select from 1 ] end

#find_empty ( board -- idx )
  [fold| i a v _ | i 81 v 0 = select a a 81 = select from 81 ] end

#set_cell ( board idx val -- new_board )
nil cons cons $ [map| i v c | c 1 : v i c 0 : = select ] end

#solve ( board steps -- board' steps' success )
; find_empty solve_check end

#solve_check ( board steps idx -- board' steps' success )
  -> [ b s i ] [ i 81 = cond [ b s 1 ] else [ b s i 1 try_digits ] ? ] end

#try_digits ( board steps idx digit -- board' steps' success )
  -> [ b s i d ] [ d 9 > cond [ b s 0 ] else [ b s 1 + i d b i d is_valid try_digit_branch ] ? ] end

#try_digit_branch ( b s i d v -- board' steps' success )
cond [ try_valid ] else [ try_invalid ] ? end

#try_invalid ( b s i d -- board' steps' success )
1 + try_digits end

#try_valid ( b s i d -- board' steps' success )
-> [ b s i d ] [ b i d set_cell s b s i d solve_helper ] end

#solve_helper ( b_new s b_orig s_orig i d -- board' steps' success )
-> [ b_n s b_o s_o i d ] [ b_n s solve b_o s_o i d handle_res ] end

#handle_res ( b_n s_n succ b_o s_o i d -- board'' steps'' success' )
-> [ b_n s_n succ b_o s_o i d ] [ succ cond [ b_n s_n 1 ] else [ b_o s_n i d 1 + try_digits ] ? ] end
