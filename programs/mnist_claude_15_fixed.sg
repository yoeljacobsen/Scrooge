; ===== Scrooge v1.5 :: MNIST softmax-regression 784->10, SGD =====
| D W0 b0 : |                                     ; entry gate

[ -> [w x] [ w [| i v | v x i : * *]              ; dot : w x -> sum(w.x)
             [| a v | a v + \ 0.0] ] ] -> [dot] [

[ -> [W b x]                                      ; fwd : W b x -> z[10]
  [ W [| i r | r x dot b i : + *] ] ] -> [fwd] [

[ -> [z]                                          ; smax : z -> p[10]
  [ z [| i v | v exp *] .
      [| a v | a v + \ 0.0]
    -> [e s] [ e [| i v | v s / *] ] ] ] -> [smax] [

[ -> [p y]                                        ; grad : p y -> p - onehot(y)
  [ p [| i v | v y i : - *] ] ] -> [grad] [

[ -> [W b x g r]                                  ; step : -> [W' b']
  [ W [| i q | q [| j w | w r g i : * x j : * - *] *]
    b [| i v | v r g i : * - *]
    [] cons cons ] ] -> [step] [

; ---- train: 3 epochs of SGD, lr 0.01, acc pair M = [W b] ----
[0 0 0] [| M e |
    D [| A s |
        A 0 : A 1 : s 0 : s 1 :
        -> [W b x y] [
          | : W b x y |                           ; loop-body gate
          W b x fwd smax y grad
          -> [g] [ W b x g 0.01 step ] ]
      \ M ]
  \ W0 b0 [] cons cons ]

-> [M] [ M 0 : M 1 : ]                            ; -> W* b*
| W* b* : |                                       ; exit gate

] ] ] ] ]
