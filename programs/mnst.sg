#v1.4_mnist_nn [
  # Lexical binding of inputs: X (784), W (10x784), B (10), labels (10), lr (learning rate)
  -> [ X W B labels lr ] [
    | : X W B labels lr |

    # 1. FORWARD PASS
    # Map over the weight rows to calculate logits for each of the 10 classes
    W [
      | class_idx row |
      | : X row class_idx B |
      
      # Compute dot product of row and X using Vector Fold (\\)
      # Accumulator starts at 0.0
      row 0.0 [
        -> [ acc c_idx w_val ] [
          # Retrieve corresponding input pixel from X using index
          X c_idx :
          w_val *
          acc +
        ]
      ] \\
      
      # Add class bias
      B class_idx : +
    ] *
    
    # At this point, the stack contains the 10-element Logits array
    -> [ logits ] [
      | : logits labels lr X W B |
      
      # 2. SOFTMAX & LOSS COMPONENT
      # Compute exponentials of logits
      logits [ | idx val | val exp ] * -> [ exps ] [
        # Sum of exponentials using Vector Fold
        exps 0.0 [ -> [ acc i v ] [ v acc + ] ] \\ -> [ sum_exps ] [
          # Compute probabilities
          exps [ | idx val | val sum_exps / ] * -> [ probs ] [
            
            # 3. BACKWARD PASS (GRADIENT DESCENT & UPDATE)
            # Compute cross-entropy error gradients (probs - labels)
            probs [
              | idx p_val |
              p_val labels idx : - # dL/dlogits
            ] * -> [ d_logits ] [
              
              # Update Biases: B = B - lr * d_logits
              B [
                | idx b_val |
                b_val lr d_logits idx : * -
              ] *
              
              # Update Weights: W_ij = W_ij - lr * d_logits_i * X_j
              W [
                | i row |
                row [
                  | j w_val |
                  w_val lr d_logits i : * X j : * -
                ] *
              ] *
              
              # Return the updated W and B to the stack
              $
            ]
          ]
        ]
      ]
    ]
  ]
]