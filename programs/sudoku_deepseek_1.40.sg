    cond [ 10 print_char ] else [ 32 print_char ] ?
    ptr idx 1 + print_row_loop
  ]
end

#print_board ( ptr -- )
  -> [ ptr ] [ ptr 0 print_row_loop ]
end

#solve_puzzle ( puzzle -- )
  -> [ puzzle ] [
    puzzle init_board
    -> [ ptr ] [
      ptr solve
      cond [ ptr print_board ]
      else [ 45 print_char ] ?
    ]
  ]
end
