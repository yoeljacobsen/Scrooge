#row_check_cell ( ptr start count num -- flag )
  -> [ ptr start count num ] [
    ptr start hread num =
    cond [ 1 ] else [ ptr start 1 + count 1 - num row_check_loop ] ?
  ]
end

#row_check ( ptr idx num -- flag )
  -> [ ptr idx num ] [ ptr idx 9 / 9 * 9 num row_check_loop ]
end

#col_check_loop ( ptr pos step count num -- flag )
  -> [ ptr pos step count num ] [
    count 0 =
    cond [ 0 ] else [ ptr pos step count num col_check_cell ] ?
  ]
end

#col_check_cell ( ptr pos step count num -- flag )
  -> [ ptr pos step count num ] [
