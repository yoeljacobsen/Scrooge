#try_valid_num ( ptr idx num -- flag )
  -> [ ptr idx num ] [
    num ptr idx hwrite
    ptr solve
    cond [ 1 ]
    else [ 0 ptr idx hwrite ptr idx num 1 + try_numbers ] ?
