end

#find_mrv ( ptr -- best_idx )
  -> [ ptr ] [ ptr 0 -1 10 find_mrv_loop ]
end

#try_one_num ( ptr idx num -- flag )
  -> [ ptr idx num ] [
    ptr idx num valid_candidate
    cond [ ptr idx num try_valid_num ]
    else [ ptr idx num 1 + try_numbers ] ?
