#col_check ( ptr idx num -- flag )
  -> [ ptr idx num ] [ ptr idx 9 \ 9 9 num col_check_loop ]
end

#box_cell_check ( ptr start row_len col_len num -- flag )
  -> [ ptr start row_len col_len num ] [
