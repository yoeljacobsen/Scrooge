end

#solve ( ptr -- flag )
  -> [ ptr ] [
    ptr find_mrv
    -> [ mrv ] [
      mrv -1 =
      cond [ 1 ]
      else [ ptr mrv 1 try_numbers ] ?
    ]
  ]
end

#copy_loop ( ptr blk idx -- ptr )
  -> [ ptr blk idx ] [
    idx 81 =
    cond [ ptr ]
    else [ blk idx : ptr idx hwrite ptr blk idx 1 + copy_loop ] ?
  ]
end

#init_board ( puzzle -- ptr )
  -> [ puzzle ] [
    81 hnew
    -> [ ptr ] [
      ptr puzzle 0 copy_loop
    ]
  ]
end

#print_row_loop ( ptr idx -- )
  -> [ ptr idx ] [
    idx 81 =
    cond [ ]
    else [ ptr idx print_row_cell ] ?
