    cond [ 0 ] else [ ptr start row_len col_len num box_check_row ] ?
  ]
end

#box_check_row ( ptr start row_len col_len num -- flag )
  -> [ ptr start row_len col_len num ] [
    col_len 0 =
    cond [ ptr start 6 + row_len 1 - 3 num box_check_loop ]
    else [ ptr start row_len col_len num box_cell_check ] ?
  ]
 end

#box_check ( ptr idx num -- flag )
  -> [ ptr idx num ] [
    ptr
    idx 9 / 3 / 27 * idx 9 \ 3 / 3 * +
    3 3 num box_check_loop
  ]
end

#valid_candidate ( ptr idx num -- flag )
  -> [ ptr idx num ] [
    ptr idx num row_check
    ptr idx num col_check or
    ptr idx num box_check or
    not
  ]
end

#count_step ( count ptr idx num -- count_out ptr idx num_next )
  -> [ count ptr idx num ] [
    ptr idx num valid_candidate
    cond [ count 1 + ptr idx num 1 + ]
    else [ count ptr idx num 1 + ] ?
  ]
end

#count_candidates_loop ( count ptr idx num -- count )
  -> [ count ptr idx num ] [
    num 9 >
    cond [ count ]
    else [ count ptr idx num count_step count_candidates_loop ] ?
  ]
end

#count_candidates ( ptr idx -- count )
  -> [ ptr idx ] [ 0 ptr idx 1 count_candidates_loop ]
end

#process_empty ( ptr idx best_idx best_count -- best_idx )
  -> [ ptr idx best_idx best_count ] [
    ptr idx count_candidates
    -> [ c ] [
      c best_count <
      cond [ ptr idx 1 + idx c find_mrv_loop ]
      else [ ptr idx 1 + best_idx best_count find_mrv_loop ] ?
    ]
  ]
end

#find_mrv_loop ( ptr idx best_idx best_count -- best_idx )
  -> [ ptr idx best_idx best_count ] [
