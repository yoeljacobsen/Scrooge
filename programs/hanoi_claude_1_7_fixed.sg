| N:Int src:Int dst:Int aux:Int : |

-> [ N src dst aux ] [

  [ -> [ n s d a c m ] [
      n
      [
        ^n 1 - ^s ^a ^d ^c ^m ^hanoi
        -> [ c1 m1 ] [
          ^n 1 - ^a ^d ^s
          c1 1 +
          ^s ^d [ ] cons cons m1 cons
          ^hanoi
        ]
      ]
      else
      [ ^c ^m ]
      ?
  ] ]

  -> [ hanoi ] [
    N src dst aux 0 [ ] hanoi
    -> [ count moves ] [
      count
      moves [| acc val | val acc cons \ [ ] ]
    ]
  ]
]

| W_count:Int W_moves:Block[N_moves] : |
